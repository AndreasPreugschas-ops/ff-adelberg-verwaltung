<Project>
  <!-- Die echte Versionsnummer kommt vom GitHub-Release und wird von der CI gesetzt (README, „Versionen und Releases“).
       Lokale Builds heißen 0.0.0-dev. -->
  <PropertyGroup>
    <VersionPrefix>0.0.0</VersionPrefix>
    <VersionSuffix>dev</VersionSuffix>
    <Product>FEVAD</Product>
    <Company>Freiwillige Feuerwehr Adelberg</Company>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!-- Vollständige XML-Kommentare sind Pflicht (Andi, 25.10.2026): fehlende melden CS1591 und brechen wegen
       TreatWarningsAsErrors den Build. Gilt für den Programmcode, nicht für die Testprojekte. -->
  <PropertyGroup Condition="!$(MSBuildProjectName.EndsWith('.Tests'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
