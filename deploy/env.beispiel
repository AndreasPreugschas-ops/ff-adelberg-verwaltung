# Vorlage für /opt/fevad/.env. einrichten.sh kopiert sie und füllt die Geheimnisse mit Zufallswerten.
# Die Datei .env enthält Passwörter: nur root darf sie lesen (chmod 600), nie ins Repository.
# Ein Ausdruck oder Passwortsafe-Eintrag von RESTIC_PASSWORD gehört außerhalb des Servers verwahrt,
# sonst ist die Sicherung nach einem Totalausfall wertlos.

# --- Anwendung ---------------------------------------------------------------
# Adresse ohne https://, z. B. fevad.ff-adelberg.de. Der DNS-Eintrag (A/AAAA) muss auf den Server zeigen.
FEVAD_DOMAIN=
# Für Let's Encrypt (Ablaufwarnungen), z. B. die Adresse des Administrators.
ACME_EMAIL=
# Image-Version aus GHCR: ein Release wie 0.1.0 (empfohlen) oder stable. Setzt aktualisieren.sh.
FEVAD_VERSION=0.1.0
# Internes Docker-Netz zwischen Caddy, Anwendung und Datenbank. Nur ändern, wenn es mit etwas kollidiert.
FEVAD_NETZ=172.31.250.0/24

POSTGRES_PASSWORD=
FE2_WEBHOOK_TOKEN=

# --- Mailversand (SMTP mit STARTTLS) ----------------------------------------
# Leer = keine E-Mails; Einrichtungslinks gibt der Administrator dann von Hand weiter.
MAIL_SMTP_SERVER=
MAIL_PORT=587
MAIL_STARTTLS=true
MAIL_BENUTZERNAME=
MAIL_PASSWORT=
MAIL_ABSENDER=

# --- Erster Administrator ----------------------------------------------------
# Nur für den ersten Start ausfüllen, nach der ersten Anmeldung wieder leeren und
# "docker compose up -d" ausführen. Das Passwort muss mindestens 10 Zeichen haben.
ERSTER_ADMIN_EMAIL=
ERSTER_ADMIN_PASSWORT=

# --- Sicherung (restic) -----------------------------------------------------
# Ziel, z. B. Hetzner Storage Box per SFTP: sftp://u123456@u123456.your-storagebox.de:23/fevad
# Der SSH-Schlüssel dazu liegt in /opt/fevad/ssh/ (siehe docs/Betrieb.md).
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Aufbewahrung: tägliche, wöchentliche und monatliche Stände.
SICHERUNG_TAEGLICH=14
SICHERUNG_WOECHENTLICH=8
SICHERUNG_MONATLICH=12

# --- Überwachung (z. B. healthchecks.io, je Prüfung eine URL) ----------------
# Leer = nur Eintrag im Systemprotokoll (journalctl -u fevad-*).
PING_SICHERUNG=
PING_SICHERUNGSTEST=
PING_WAECHTER=
# Ab wie viel Prozent belegtem Plattenplatz der Wächter Alarm schlägt.
WAECHTER_PLATTE_MAX_PROZENT=85
# Wie viele Tage vor Ablauf des Zertifikats der Wächter Alarm schlägt (Caddy erneuert nach 60 von 90 Tagen).
WAECHTER_ZERTIFIKAT_MIN_TAGE=14
