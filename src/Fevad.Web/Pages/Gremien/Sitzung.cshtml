@page "{id:guid?}"
@using Fevad.Domain.Gremien
@model Fevad.Web.Pages.Gremien.SitzungModel
@{
    var s = Model.Sitzung;
    ViewData["Title"] = s?.Titel ?? "Neue Sitzung";
    var nurLesen = !Model.DarfBearbeiten;
    var personen = Fevad.Web.Pages.Gremien.Auswahl.Liste(Model.Mitglieder);
    const string ZeitHinweis = "TT.MM.JJJJ HH:MM";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Alle Sitzungen</a>
<div class="mt-2 mb-4 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">@(s?.Titel ?? "Neue Sitzung")</h1>
    @if (s is not null)
    {
        <span class="text-sm text-gray-600">@Anzeige.Text(s.Art) · @Anzeige.DatumZeit(s.Beginn) Uhr</span>
    }
</div>

@if (Model.EinladungsfristEingehalten == false)
{
    <div class="mb-4 rounded-md border border-red-200 bg-red-50 p-3 text-sm text-red-800" role="alert">
        Die Einladungsfrist von @Model.EinladungsfristTage Tagen ist nicht eingehalten (eingeladen am @Anzeige.Datum(s!.EingeladenAm)).
    </div>
}
else if (Model.EinladungsfristEingehalten is null && s is { Art: SitzungArt.Hauptversammlung or SitzungArt.Ausschuss, Status: SitzungStatus.Geplant })
{
    <div class="mb-4 rounded-md border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-900" role="status">
        Einladung spätestens @Model.EinladungsfristTage Tage vorher verschicken, bei der Hauptversammlung auch an den Bürgermeister.
    </div>
}

<form method="post" asp-route-id="@s?.Id" class="karte grid gap-4">
    <fieldset disabled="@nurLesen" class="grid gap-4">
        <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
        <input type="hidden" asp-for="Formular.Version" />
        <div class="grid gap-4 sm:grid-cols-3">
            <div>
                <label asp-for="Formular.Art" class="etikett"></label>
                <select asp-for="Formular.Art" asp-items="Html.GetEnumSelectList<SitzungArt>()" class="eingabe"></select>
            </div>
            <div class="sm:col-span-2">
                <label asp-for="Formular.Titel" class="etikett"></label>
                <input asp-for="Formular.Titel" class="eingabe" />
                <span asp-validation-for="Formular.Titel" class="feldfehler"></span>
            </div>
            <div>
                <label asp-for="Formular.Beginn" class="etikett"></label>
                <input asp-for="Formular.Beginn" class="eingabe" placeholder="@ZeitHinweis" autocomplete="off" />
                <span asp-validation-for="Formular.Beginn" class="feldfehler"></span>
            </div>
            <div>
                <label asp-for="Formular.Ende" class="etikett"></label>
                <input asp-for="Formular.Ende" class="eingabe" fevad-uhrzeit />
                <span asp-validation-for="Formular.Ende" class="feldfehler"></span>
            </div>
            <div>
                <label asp-for="Formular.Ort" class="etikett"></label>
                <input asp-for="Formular.Ort" class="eingabe" placeholder="Gerätehaus" />
            </div>
            <div>
                <label asp-for="Formular.EingeladenAm" class="etikett"></label>
                <input asp-for="Formular.EingeladenAm" type="date" class="eingabe" />
            </div>
            <div>
                <label asp-for="Formular.Status" class="etikett"></label>
                <select asp-for="Formular.Status" asp-items="Html.GetEnumSelectList<SitzungStatus>()" class="eingabe"></select>
            </div>
            <div>
                <label asp-for="Formular.ProtokollfuehrerId" class="etikett"></label>
                <select asp-for="Formular.ProtokollfuehrerId" asp-items="personen" class="eingabe"><option value="">–</option></select>
            </div>
        </div>
        <div x-data="{ top(text) { const f = this.$refs.tagesordnung; const n = (f.value.match(/^TOP \d+/gm) || []).length + 1; f.value = (f.value.trim() ? f.value.trimEnd() + '\n' : '') + 'TOP ' + n + ' ' + text; } }">
            <label asp-for="Formular.Tagesordnung" class="etikett"></label>
            <textarea asp-for="Formular.Tagesordnung" rows="5" class="eingabe" placeholder="TOP 1 Begrüßung&#10;TOP 2 ..." x-ref="tagesordnung"></textarea>
            @if (Model.Bausteine.Count > 0 && !nurLesen)
            {
                <details class="mt-1 text-sm">
                    <summary class="cursor-pointer text-feuer-700">Bausteine und fällige Vorgänge übernehmen</summary>
                    <div class="mt-2 flex flex-wrap gap-2">
                        @foreach (var b in Model.Bausteine)
                        {
                            <button type="button" class="knopf-zweit py-1 text-xs" x-on:click="top(@System.Text.Json.JsonSerializer.Serialize(b))">@b</button>
                        }
                    </div>
                </details>
            }
        </div>
        @if (s is not null)
        {
            <div>
                <label asp-for="Formular.Protokoll" class="etikett"></label>
                <textarea asp-for="Formular.Protokoll" rows="10" class="eingabe"></textarea>
            </div>
            <div class="grid gap-4 sm:grid-cols-3">
                <div>
                    <label asp-for="Formular.ProtokollGenehmigtAm" class="etikett"></label>
                    <input asp-for="Formular.ProtokollGenehmigtAm" type="date" class="eingabe" />
                </div>
                <div>
                    <label asp-for="Formular.DemBuergermeisterVorgelegtAm" class="etikett"></label>
                    <input asp-for="Formular.DemBuergermeisterVorgelegtAm" type="date" class="eingabe" />
                </div>
                <div>
                    <label asp-for="Formular.ProtokollDokumentId" class="etikett"></label>
                    <select asp-for="Formular.ProtokollDokumentId" asp-items="Model.Protokolldokumente" class="eingabe"><option value="">–</option></select>
                    @if (s.ProtokollDokument is { } dok)
                    {
                        <a asp-page="/Dokumente/Detail" asp-route-id="@dok.Id" class="text-xs text-feuer-700 hover:underline">@dok.Titel öffnen</a>
                    }
                </div>
            </div>
        }
    </fieldset>
    @if (Model.DarfBearbeiten)
    {
        <div class="flex gap-2"><button type="submit" class="knopf">Speichern</button></div>
    }
</form>

@if (s is not null)
{
    <section class="karte mt-6">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-semibold">Einladung und Unterlagen</h2>
            <div class="flex flex-wrap gap-2 text-sm">
                <a asp-page-handler="Niederschrift" asp-route-id="@s.Id" class="knopf-zweit">Niederschrift (PDF)</a>
                @if (Model.DarfBearbeiten)
                {
                    <a asp-page-handler="Anwesenheitsliste" asp-route-id="@s.Id" class="knopf-zweit">Anwesenheitsliste (PDF)</a>
                }
            </div>
        </div>
        @if (s.EinladungVersandtAm is { } versandt)
        {
            <p class="text-sm">Einladung per E-Mail verschickt am @Anzeige.DatumZeit(versandt) Uhr an @s.EinladungEmpfaenger Empfänger@(s.EinladungOhneMail > 0 ? $", {s.EinladungOhneMail} ohne E-Mail-Adresse (Papier)" : "").</p>
        }
        @if (s.BuergermeisterEingeladenAm is { } bm)
        {
            <p class="text-sm">Bürgermeister benachrichtigt am @Anzeige.DatumZeit(bm) Uhr.</p>
        }
        @if (Model.DarfBearbeiten)
        {
            var ohneMail = Model.Verteiler.Where(v => string.IsNullOrWhiteSpace(v.Email)).Select(v => v.Name).ToList();
            <p class="mt-2 text-sm text-gray-600">Verteiler: @Model.Verteiler.Count Eingeladene@(s.Art == SitzungArt.Ausschuss ? " (Ausschussmitglieder nach Satzung § 13)" : s.Art == SitzungArt.Hauptversammlung ? " (alle Angehörigen ohne Jugend- und Kinderfeuerwehr)" : " (erfasste Teilnehmer)").</p>
            @if (ohneMail.Count > 0)
            {
                <p class="text-sm text-amber-700">Ohne E-Mail-Adresse, bitte auf Papier einladen: @string.Join("; ", ohneMail)</p>
            }
            <div class="mt-3 flex flex-wrap gap-2">
                <form method="post" asp-page-handler="Einladen" asp-route-id="@s.Id">
                    <button type="submit" class="knopf" disabled="@(!Model.MailAktiv || Model.Verteiler.Count == 0)">Einladung per E-Mail verschicken</button>
                </form>
                @if (s.DienstId is null && s.Status == SitzungStatus.Geplant)
                {
                    <form method="post" asp-page-handler="Dienst" asp-route-id="@s.Id">
                        <button type="submit" class="knopf-zweit">Als Termin mit Zu- und Absage in den Dienstplan</button>
                    </form>
                }
                else if (s.DienstId is { } dienstId)
                {
                    <a asp-page="/Termine/Termin" asp-route-id="@dienstId" class="knopf-zweit">Termin im Dienstplan</a>
                }
            </div>
            @if (!Model.MailAktiv)
            {
                <p class="mt-1 text-xs text-gray-500">Der Mailversand ist nicht eingerichtet; die Einladung bitte selbst verschicken und „Eingeladen am“ eintragen.</p>
            }

            @if (Model.Buergermeister is { } bmEntwurf)
            {
                <details class="mt-4 border-t border-gray-100 pt-3" open="@(s.BuergermeisterEingeladenAm is null)">
                    <summary class="cursor-pointer font-semibold">Einladung an den Bürgermeister (Satzung @(s.Art == SitzungArt.Hauptversammlung ? "§ 14 Abs. 3" : "§ 13 Abs. 5"))</summary>
                    <form method="post" asp-page-handler="Buergermeister" asp-route-id="@s.Id" class="mt-3 grid gap-3">
                        <div><label class="etikett" for="bm-an">An</label><input id="bm-an" name="an" type="email" value="@bmEntwurf.An" class="eingabe" placeholder="in den Stammdaten hinterlegen" required /></div>
                        <div><label class="etikett" for="bm-betreff">Betreff</label><input id="bm-betreff" name="betreff" value="@bmEntwurf.Betreff" class="eingabe" maxlength="200" required /></div>
                        <div><label class="etikett" for="bm-text">Text</label><textarea id="bm-text" name="text" rows="10" class="eingabe" required>@bmEntwurf.Text</textarea></div>
                        <div class="flex flex-wrap gap-2">
                            <button type="submit" class="knopf" disabled="@(!Model.MailAktiv)">An den Bürgermeister senden</button>
                            <a href="mailto:@(bmEntwurf.An)?subject=@Uri.EscapeDataString(bmEntwurf.Betreff)&amp;body=@Uri.EscapeDataString(bmEntwurf.Text)" class="knopf-zweit">Im eigenen Mailprogramm öffnen</a>
                        </div>
                    </form>
                </details>
            }
        }
    </section>

    var teilnahmen = s.Teilnahmen.ToDictionary(t => t.MitgliedId);
    <details class="karte mt-6" open="@(s.Teilnahmen.Count == 0 && s.Status != SitzungStatus.Geplant)">
        <summary class="cursor-pointer font-semibold">
            Teilnehmer (@s.Teilnahmen.Count(t => t.Status == TeilnahmeStatus.Anwesend) anwesend)
            @if (Model.Beschlussfaehigkeit.Stimmberechtigt > 0)
            {
                var (anwesend, berechtigt) = Model.Beschlussfaehigkeit;
                <span class="@(Sitzung.Beschlussfaehig(anwesend, berechtigt) ? "ampel-gruen" : "ampel-rot") ml-2">
                    @anwesend von @berechtigt Stimmberechtigten: @(Sitzung.Beschlussfaehig(anwesend, berechtigt) ? "beschlussfähig" : "nicht beschlussfähig")
                </span>
            }
        </summary>
        <form method="post" asp-page-handler="Teilnahme" asp-route-id="@s.Id" class="mt-3">
            <fieldset disabled="@nurLesen">
                <table class="tabelle">
                    <thead><tr><th>Mitglied</th><th>Teilnahme</th><th>stimmberechtigt</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < Model.Mitglieder.Count; i++)
                        {
                            var m = Model.Mitglieder[i];
                            teilnahmen.TryGetValue(m.Id, out var t);
                            var stimmberechtigt = t?.Stimmberechtigt ?? (s.Art != SitzungArt.Hauptversammlung || m.Einsatzabteilung);
                            <tr>
                                <td>@m.Name<input type="hidden" name="Teilnahmen[@i].MitgliedId" value="@m.Id" /></td>
                                <td>
                                    <select name="Teilnahmen[@i].Status" class="eingabe py-1">
                                        <option value="">–</option>
                                        @foreach (var st in Enum.GetValues<TeilnahmeStatus>())
                                        {
                                            <option value="@st" selected="@(t?.Status == st)">@Anzeige.Text(st)</option>
                                        }
                                    </select>
                                </td>
                                <td><input type="checkbox" name="Teilnahmen[@i].Stimmberechtigt" value="true" checked="@stimmberechtigt" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.DarfBearbeiten)
                {
                    <button type="submit" class="knopf mt-3">Teilnehmer speichern</button>
                }
            </fieldset>
        </form>
    </details>

    <div id="beschluesse" class="karte mt-6">
        <h2 class="mb-2 font-semibold">Beschlüsse</h2>
        @if (s.Beschluesse.Count == 0)
        {
            <p class="text-sm text-gray-500">Keine Beschlüsse.</p>
        }
        else
        {
            <table class="tabelle">
                <thead><tr><th>Nr.</th><th>TOP</th><th>Beschluss</th><th>Ergebnis</th><th>Stimmen</th><th>Umsetzung</th><th></th></tr></thead>
                <tbody>
                    @foreach (var b in s.Beschluesse.OrderBy(b => b.Nummer))
                    {
                        <tr>
                            <td>@b.Kennung</td>
                            <td>@(b.Tagesordnungspunkt ?? "–")</td>
                            <td class="whitespace-pre-line">@b.Gegenstand</td>
                            <td><span class="@(b.Ergebnis == BeschlussErgebnis.Angenommen ? "ampel-gruen" : b.Ergebnis == BeschlussErgebnis.Abgelehnt ? "ampel-rot" : "ampel-gelb")">@Anzeige.Text(b.Ergebnis)</span></td>
                            <td>@(b.JaStimmen is null ? "–" : $"{b.JaStimmen} / {b.NeinStimmen ?? 0} / {b.Enthaltungen ?? 0}")</td>
                            <td>
                                @if (b.AufgehobenAm is not null)
                                {
                                    <span class="text-xs text-gray-600">aufgehoben @Anzeige.Datum(b.AufgehobenAm)@(b.AufgehobenDurch is null ? "" : $" durch {b.AufgehobenDurch}")</span>
                                }
                                else if (b.ErledigtAm is not null)
                                {
                                    <span class="text-xs text-green-800">erledigt @Anzeige.Datum(b.ErledigtAm)</span>
                                }
                                else if (b.UmsetzenBis is not null)
                                {
                                    <span class="text-xs">bis @Anzeige.Datum(b.UmsetzenBis)</span>
                                    @if (Model.DarfBearbeiten)
                                    {
                                        <form method="post" asp-page-handler="Erledigt" asp-route-id="@s.Id" class="inline">
                                            <input type="hidden" name="beschlussId" value="@b.Id" />
                                            <button type="submit" class="text-xs text-feuer-700 hover:underline">erledigt</button>
                                        </form>
                                    }
                                }
                            </td>
                            <td>
                                @if (Model.DarfBearbeiten)
                                {
                                    @if (b.Stand is BeschlussStand.Gefasst or BeschlussStand.Umgesetzt)
                                    {
                                        <form method="post" asp-page-handler="Aufheben" asp-route-id="@s.Id" class="mb-1 flex items-center gap-1">
                                            <input type="hidden" name="beschlussId" value="@b.Id" />
                                            <input name="durch" class="eingabe w-24 py-0.5 text-xs" placeholder="durch Nr." maxlength="200" />
                                            <button type="submit" class="text-xs text-feuer-700 hover:underline">aufheben</button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="BeschlussLoeschen" asp-route-id="@s.Id">
                                        <input type="hidden" name="beschlussId" value="@b.Id" />
                                        <button type="submit" class="text-xs text-gray-500 hover:underline">löschen</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="mt-1 text-xs text-gray-500">Stimmen: Ja / Nein / Enthaltungen. Bei Stimmengleichheit gilt ein Antrag als abgelehnt.</p>
        }

        @if (Model.DarfBearbeiten)
        {
            <form method="post" asp-page-handler="Beschluss" asp-route-id="@s.Id" class="mt-4 grid gap-3 border-t border-gray-100 pt-4 sm:grid-cols-6">
                <div><label asp-for="NeuerBeschluss.Tagesordnungspunkt" class="etikett"></label><input asp-for="NeuerBeschluss.Tagesordnungspunkt" class="eingabe" /></div>
                <div class="sm:col-span-5"><label asp-for="NeuerBeschluss.Gegenstand" class="etikett"></label><input asp-for="NeuerBeschluss.Gegenstand" class="eingabe" placeholder="Der Ausschuss beschließt ..." /></div>
                <div><label asp-for="NeuerBeschluss.JaStimmen" class="etikett"></label><input asp-for="NeuerBeschluss.JaStimmen" type="number" min="0" class="eingabe" /></div>
                <div><label asp-for="NeuerBeschluss.NeinStimmen" class="etikett"></label><input asp-for="NeuerBeschluss.NeinStimmen" type="number" min="0" class="eingabe" /></div>
                <div><label asp-for="NeuerBeschluss.Enthaltungen" class="etikett"></label><input asp-for="NeuerBeschluss.Enthaltungen" type="number" min="0" class="eingabe" /></div>
                <div>
                    <label asp-for="NeuerBeschluss.Ergebnis" class="etikett"></label>
                    <select asp-for="NeuerBeschluss.Ergebnis" asp-items="Html.GetEnumSelectList<BeschlussErgebnis>()" class="eingabe"><option value="">aus Stimmen</option></select>
                </div>
                <div><label asp-for="NeuerBeschluss.UmsetzenBis" class="etikett"></label><input asp-for="NeuerBeschluss.UmsetzenBis" type="date" class="eingabe" /></div>
                <div class="flex items-end"><button type="submit" class="knopf">Beschluss hinzufügen</button></div>
            </form>
        }
    </div>

    <div class="karte mt-6">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h2 class="font-semibold">Wahlen</h2>
            @if (Model.DarfBearbeiten)
            {
                <a asp-page="Wahl" asp-route-sitzungId="@s.Id" class="knopf-zweit">Wahl erfassen</a>
            }
        </div>
        @if (s.Wahlen.Count == 0)
        {
            <p class="text-sm text-gray-500">Keine Wahlen in dieser Sitzung.</p>
        }
        else
        {
            <ul class="space-y-1 text-sm">
                @foreach (var w in s.Wahlen.OrderBy(w => w.ErstelltAm))
                {
                    <li>
                        <a asp-page="Wahl" asp-route-id="@w.Id" class="font-medium text-feuer-700 hover:underline">@w.Funktion?.Bezeichnung@(w.Wahlgang > 1 ? $" ({w.Wahlgang}. Wahlgang)" : "")</a>
                        <span class="text-gray-600">· @Anzeige.Text(w.Status)</span>
                        @if (w.Bewerber.Any(b => b.Gewaehlt))
                        {
                            <span>· gewählt: @string.Join(", ", w.Bewerber.Where(b => b.Gewaehlt).Select(b => b.Mitglied?.Anzeigename))</span>
                        }
                    </li>
                }
            </ul>
        }
    </div>
}
