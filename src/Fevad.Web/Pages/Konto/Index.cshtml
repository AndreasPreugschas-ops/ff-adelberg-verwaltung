@page
@model Fevad.Web.Pages.Konto.IndexModel
@{
    ViewData["Title"] = "Mein Konto";
}
<h1 class="mb-4 text-2xl font-bold">Mein Konto</h1>

<div class="grid max-w-3xl gap-6">
    <section class="karte">
        <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[12rem_1fr]">
            <dt class="font-medium text-gray-600">E-Mail-Adresse</dt><dd>@Model.Konto.Email</dd>
            <dt class="font-medium text-gray-600">Mitglied</dt><dd>@(Model.Mitglied ?? "–")</dd>
            <dt class="font-medium text-gray-600">Rollen</dt><dd>@(Model.Rollen.Count == 0 ? "–" : string.Join(", ", Model.Rollen.Select(Rollen.Bezeichnung)))</dd>
            <dt class="font-medium text-gray-600">Letzte Anmeldung</dt><dd>@Anzeige.DatumZeit(Model.Konto.LetzteAnmeldungAm)</dd>
        </dl>
        <div class="mt-4 flex flex-wrap gap-2">
            <a asp-page="Passwort" class="knopf-zweit">Passwort ändern</a>
            <a asp-page="MeineDaten" class="knopf-zweit">Meine gespeicherten Daten</a>
            <a asp-page="Einwilligungen" class="knopf-zweit">Einwilligungen</a>
            <a asp-page="Datenschutz" class="knopf-zweit">Datenschutz und Löschung</a>
            @if (Model.HatKinder)
            {
                <a asp-page="Notfallangaben" class="knopf-zweit">Heimweg und Notfallangaben meiner Kinder</a>
            }
            @if (Model.Mitglied is not null)
            {
                <a asp-page="Akte" class="knopf-zweit">Meine Akte</a>
                <a asp-page="Aenderung" class="knopf-zweit">Meine Daten ändern lassen</a>
                <a asp-page="Unfall" class="knopf-zweit">Unfall oder Verletzung melden</a>
                <a asp-page="Sachschaden" class="knopf-zweit">Sachschaden melden</a>
                <a asp-page="Auslagen" class="knopf-zweit">Auslagen erstatten lassen</a>
                <a asp-page="Entschaedigung" class="knopf-zweit">Meine Entschädigung, Lehrgang beantragen</a>
                <a asp-page="Arbeitgeber" class="knopf-zweit">Bescheinigung für den Arbeitgeber</a>
                <a asp-page="Aufgaben" class="knopf-zweit">Meine Aufgaben</a>
                <a asp-page="Pflichten" class="knopf-zweit">Meine Pflichten im Jahreskreis</a>
                <a asp-page="Lehrgaenge" class="knopf-zweit">Lehrgang wünschen</a>
                <a asp-page="Einsatzleitungen" class="knopf-zweit">Meine Einsatzleitungen</a>
            }
            @if (Model.Atemschutztraeger)
            {
                <a asp-page="Atemschutz" class="knopf-zweit">Atemschutz: nicht einsetzbar melden</a>
            }
            <form method="post" asp-page-handler="UeberallAbmelden">
                <button type="submit" class="knopf-zweit">Auf allen Geräten abmelden</button>
            </form>
        </div>
    </section>

    @if (Model.Kinder.Count > 0)
    {
        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Meine Kinder</h2>
            <p class="mb-3 text-sm text-gray-700">Was die Feuerwehr über euer Kind gespeichert hat. Stimmt etwas nicht, meldet die Änderung; der Jugendwart übernimmt sie.</p>
            @foreach (var k in Model.Kinder)
            {
                <div class="mb-2 flex flex-wrap items-center gap-2">
                    <span class="w-32 font-semibold">@k.Vorname</span>
                    <a asp-page="Akte" asp-route-kind="@k.MitgliedId" class="knopf-zweit">Akte</a>
                    <a asp-page="Aenderung" asp-route-kind="@k.MitgliedId" class="knopf-zweit">Änderung melden</a>
                </div>
            }
        </section>
    }

    @if (Model.Mitglied is not null)
    {
        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Erinnerungen per Mail</h2>
            <p class="mb-3 text-sm text-gray-700">
                FEVAD erinnert dich etwa einmal pro Woche an das, was bei dir ansteht. Während einer gemeldeten Abwesenheit kommt keine Mail.
            </p>
            <form method="post" asp-page-handler="Erinnerungen" class="grid gap-2 text-sm">
                <label class="flex items-center gap-2"><input type="checkbox" name="fristen" value="true" checked="@(!Model.Konto.OhneErinnerungFristen)" /><input type="hidden" name="fristen" value="false" /> eigene Fristen (Lehrgänge, Nachweise, Atemschutz)</label>
                <label class="flex items-center gap-2"><input type="checkbox" name="ausstattung" value="true" checked="@(!Model.Konto.OhneErinnerungAusstattung)" /><input type="hidden" name="ausstattung" value="false" /> Prüfung meiner Schutzausrüstung</label>
                <label class="flex items-center gap-2"><input type="checkbox" name="rueckmeldungen" value="true" checked="@(!Model.Konto.OhneErinnerungRueckmeldungen)" /><input type="hidden" name="rueckmeldungen" value="false" /> offene Zu- und Absagen zu Terminen</label>
                <div><button type="submit" class="knopf-zweit">Speichern</button></div>
            </form>
        </section>
    }

    <section class="karte">
        <h2 class="mb-2 text-lg font-semibold">Benachrichtigungen</h2>
        <p class="mb-3 text-sm text-gray-700">
            Mitteilungen, Rundfragen, Aufgaben und Hinweise siehst du immer unter der Glocke oben. Zusätzlich kommt höchstens einmal am Tag eine
            Sammelmail mit der Zahl der neuen Benachrichtigungen, ohne Inhalte. Hier legst du fest, welche Arten darin zählen.
        </p>
        <form method="post" asp-page-handler="Sammelmail" class="grid gap-2 text-sm">
            @foreach (var art in Fevad.Domain.Gemeinsam.Benachrichtigung.Arten)
            {
                <label class="flex items-center gap-2"><input type="checkbox" name="arten" value="@art" checked="@((Model.Konto.SammelmailOhne & art) == 0)" /> @Fevad.Infrastructure.Benachrichtigungen.Sammelmail.Bezeichnung(art)</label>
            }
            <div class="flex flex-wrap gap-2"><button type="submit" class="knopf-zweit">Speichern</button> <a href="/Benachrichtigungen" class="knopf-zweit">Alle Benachrichtigungen</a></div>
        </form>
    </section>

    <section class="karte">
        <h2 class="mb-2 text-lg font-semibold">Zwei-Faktor-Anmeldung</h2>
        @if (Model.Konto.TwoFactorEnabled)
        {
            <p class="text-sm text-gray-700">
                <span class="ampel-gruen">eingeschaltet</span>
                Bei der Anmeldung wird zusätzlich ein Code aus deiner Authenticator-App abgefragt.
                Noch @Model.RestlicheCodes Wiederherstellungscodes übrig.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
                <form method="post" asp-page-handler="NeueCodes">
                    <button type="submit" class="knopf-zweit">Neue Wiederherstellungscodes</button>
                </form>
                <a asp-page="Authenticator" class="knopf-zweit">Neues Handy einrichten</a>
                @if (!Model.Pflicht)
                {
                    <form method="post" asp-page-handler="Ausschalten">
                        <button type="submit" class="knopf-zweit">Ausschalten</button>
                    </form>
                }
            </div>
        }
        else
        {
            <p class="text-sm text-gray-700">
                <span class="@(Model.Pflicht ? "ampel-rot" : "ampel-gelb")">ausgeschaltet</span>
                @(Model.Pflicht
                    ? "Für deine Rolle ist die Zwei-Faktor-Anmeldung Pflicht."
                    : "Empfohlen: Mit einer Authenticator-App ist dein Konto auch bei einem erratenen Passwort geschützt.")
            </p>
            <a asp-page="Authenticator" class="knopf mt-4">Authenticator-App einrichten</a>
        }
    </section>
</div>
