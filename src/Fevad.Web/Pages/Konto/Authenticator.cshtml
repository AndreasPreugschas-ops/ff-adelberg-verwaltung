@page
@model Fevad.Web.Pages.Konto.AuthenticatorModel
@{
    ViewData["Title"] = "Authenticator-App einrichten";
}
<h1 class="mb-4 text-2xl font-bold">Authenticator-App einrichten</h1>

@if (Model.Pflicht)
{
    <div class="mb-4 max-w-3xl rounded-md border border-yellow-200 bg-yellow-50 p-3 text-sm text-yellow-800">
        Für deine Rolle ist die Zwei-Faktor-Anmeldung Pflicht. Bitte richte sie jetzt ein, danach geht es normal weiter.
    </div>
}

@if (Model.Aktiv)
{
    <div class="karte grid max-w-3xl gap-3 text-sm text-gray-700">
        <p>Die Authenticator-App ist eingerichtet. Für ein neues Handy oder wenn das alte verloren ist, ersetzt du hier den Schlüssel. Der alte Schlüssel ist danach sofort ungültig.</p>
        <form method="post" asp-page-handler="Ersetzen" class="flex gap-2">
            <button type="submit" class="knopf">Schlüssel ersetzen und neu einrichten</button>
            <a asp-page="Index" class="knopf-zweit">Abbrechen</a>
        </form>
    </div>
}
else
{
    <div class="karte grid max-w-3xl gap-6 sm:grid-cols-[auto_1fr]">
        <div class="mx-auto w-48 [&>svg]:h-auto [&>svg]:w-full">@Html.Raw(Model.QrCodeSvg)</div>
        <div class="grid content-start gap-3 text-sm text-gray-700">
            <p><strong>1.</strong> Installiere eine Authenticator-App auf deinem Handy, z. B. Microsoft Authenticator, Google Authenticator oder FreeOTP.</p>
            <p><strong>2.</strong> Scanne den QR-Code. Geht das nicht, gib diesen Schlüssel von Hand ein:<br /><code class="mt-1 inline-block rounded bg-gray-100 px-2 py-1 font-mono text-base">@Model.Schluessel</code></p>
            <p><strong>3.</strong> Gib den sechsstelligen Code ein, den die App jetzt anzeigt.</p>
            <form method="post" class="grid max-w-xs gap-3">
                <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
                <div><label asp-for="Code" class="etikett"></label><input asp-for="Code" class="eingabe" autocomplete="one-time-code" inputmode="numeric" autofocus /><span asp-validation-for="Code" class="feldfehler"></span></div>
                <button type="submit" class="knopf justify-center">Bestätigen</button>
            </form>
        </div>
    </div>
}
