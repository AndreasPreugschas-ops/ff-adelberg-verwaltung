@page
@model Fevad.Web.Pages.Konto.MeineDatenModel
@{
    ViewData["Title"] = "Meine Daten";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Mein Konto</a>
<div class="mt-2 mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Meine Daten</h1>
    <a asp-page-handler="Export" class="knopf">Als Datei herunterladen (JSON)</a>
</div>

<p class="mb-4 max-w-3xl text-sm text-gray-700">
    Hier steht alles, was FEVAD zu deinem Konto und zu dir als Mitglied speichert (Auskunft nach Art. 15 DSGVO).
    Wenn etwas nicht stimmt, wende dich an den Kommandanten. Fragen zum Datenschutz beantwortet der
    Datenschutzbeauftragte der Gemeinde.
</p>

@if (Model.Abschnitte.Count > 1)
{
    <nav class="karte mb-6 text-sm" aria-label="Inhalt">
        <div class="mb-1 font-semibold">Inhalt</div>
        <ul class="flex flex-wrap gap-x-4 gap-y-1">
            @for (var i = 0; i < Model.Abschnitte.Count; i++)
            {
                <li><a href="#abschnitt-@i" class="text-feuer-700 hover:underline">@Model.Abschnitte[i].Titel</a> <span class="text-gray-500">(@Model.Abschnitte[i].Zeilen.Count)</span></li>
            }
        </ul>
    </nav>
}

@for (var i = 0; i < Model.Abschnitte.Count; i++)
{
    var a = Model.Abschnitte[i];
    @* Lange Abschnitte (etwa zehn Jahre Anwesenheiten) bleiben zugeklappt, damit die Seite übersichtlich bleibt. *@
    <details id="abschnitt-@i" class="mb-6" open="@(a.Zeilen.Count <= MeineDatenModel.OffenBis)">
        <summary class="mb-2 cursor-pointer text-lg font-semibold">@a.Titel <span class="text-sm font-normal text-gray-500">@(a.Zeilen.Count == 1 ? "1 Eintrag" : $"{a.Zeilen.Count} Einträge")</span></summary>
        <div class="karte overflow-x-auto p-0">
            <table class="tabelle">
                <thead><tr>@foreach (var s in a.Spalten) { <th>@s</th> }</tr></thead>
                <tbody>
                    @foreach (var z in a.Zeilen)
                    {
                        <tr>@foreach (var w in z) { <td>@MeineDatenModel.Text(w)</td> }</tr>
                    }
                </tbody>
            </table>
        </div>
    </details>
}
