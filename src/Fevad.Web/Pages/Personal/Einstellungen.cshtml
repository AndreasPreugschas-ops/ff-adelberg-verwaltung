@page
@model Fevad.Web.Pages.Personal.EinstellungenModel
@{
    ViewData["Title"] = "Einstellungen Personal";
}
<h1 class="mb-2 text-2xl font-bold">Personal</h1>
<partial name="_Navigation" model="@("Einstellungen")" />

<form method="post" class="grid max-w-3xl gap-6">
    <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
    <p class="text-sm text-gray-600">
        Intervalle für Atemschutz und Vorsorge, Warnfristen und die Erinnerungsmail. Intervalle für Führerscheinkontrolle,
        Unterweisungen und weitere Nachweise oder Untersuchungen stehen je Eintrag unter
        <a asp-page="Kataloge" class="text-feuer-700 hover:underline">Kataloge</a>.
        Eine Änderung gilt ab heute; bereits eingetragene Nachweise behalten ihr Datum.
    </p>
    <partial name="_Einstellungen" model='(EinstellungenModel.Alle, (IReadOnlyDictionary<string, int>)Model.Werte)' />
    <p class="text-xs text-gray-500">Vorbelegung: FwDV 7 (Übungen jährlich), DGUV G 26.3 (Vorsorge alle 36 Monate, ab 50 Jahren alle 12 Monate). Die Vorsorgeintervalle bitte mit dem Betriebsarzt und der aktuellen AMR 14.2 abgleichen.</p>
    <div><button type="submit" class="knopf">Speichern</button></div>
</form>
