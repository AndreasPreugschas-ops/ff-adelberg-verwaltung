@page "{id:guid}"
@model Fevad.Web.Pages.Personal.AkteModel
@inject IAuthorizationService Autorisierung
@{
    var m = Model.Mitglied!;
    ViewData["Title"] = $"Personalakte {m.Anzeigename}";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Fristenübersicht</a>
<div class="mb-4 mt-2 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">@m.Anzeigename <span class="text-base font-normal text-gray-500">Nr. @m.Personalnummer</span></h1>
</div>
<partial name="_Mitgliedreiter" model='(m.Id, "Ausbildung und Fristen")' />

@if (Model.Spangenhinweis is { } spange)
{
    <div class="mb-6 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900">
        <p class="font-semibold">Leistungsspange DJF fehlt</p>
        <p class="mt-1">Ohne Leistungsspange zählt die Zeit in der Jugendfeuerwehr nicht für das Feuerwehr-Ehrenzeichen. Bitte bis zum Übertritt am @Anzeige.Datum(spange.FaelligAm) ablegen.</p>
    </div>
}

<section class="karte mb-6">
    <h2 class="mb-2 text-lg font-semibold">Fristen</h2>
    @if (Model.Fristen.Count == 0)
    {
        <p class="text-sm text-gray-500">Keine laufenden Fristen.</p>
    }
    else
    {
        <div class="overflow-x-auto">
        <table class="tabelle">
            <thead><tr><th>Bereich</th><th>Frist</th><th>Fällig am</th><th>Status</th><th></th></tr></thead>
            <tbody>
                @foreach (var f in Model.Fristen.OrderByDescending(f => f.Ampel).ThenBy(f => f.FaelligAm))
                {
                    <tr><td>@Anzeige.Text(f.Bereich)</td><td>@f.Bezeichnung</td><td>@(f.FaelligAm is null ? "kein Nachweis" : Anzeige.Datum(f.FaelligAm))</td><td><partial name="_FristStatus" model="f" /></td>
                        <td><partial name="_Verlaengern" model="(f, Model.Rechte)" /></td></tr>
                }
            </tbody>
        </table>
        </div>
    }
</section>

@{
    var monate = System.Text.Json.JsonSerializer.Serialize(Model.Monate);

    async Task Tabelle(IReadOnlyList<Fevad.Domain.Ausbildung.QualifikationNachweis> liste, string leer)
    {
        if (liste.Count == 0)
        {
            <p class="text-sm text-gray-500">@leer</p>
            return;
        }

        <div class="overflow-x-auto">
            <table class="tabelle">
                <thead><tr><th>Bezeichnung</th><th>Ebene</th><th>Erworben</th><th>Gültig bis</th><th>Ort</th><th>Std.</th><th></th></tr></thead>
                <tbody>
                    @foreach (var q in liste)
                    {
                        var abgeloest = Model.Abgeloest.Contains(q.Id);
                        <tr class="@(abgeloest ? "text-gray-400" : "")">
                            <td>
                                @q.Qualifikation?.Bezeichnung
                                @if (abgeloest) { <span class="text-xs">(höhere Stufe vorhanden)</span> }
                                @if (q.Urkunde is not null) { <div class="text-xs text-gray-500">Urkunde: @q.Urkunde</div> }
                                @if (q.Bemerkung is not null) { <div class="text-xs text-gray-500">@q.Bemerkung</div> }
                            </td>
                            <td>@Anzeige.Text(q.Qualifikation?.Ebene)</td>
                            <td>@Anzeige.Datum(q.ErworbenAm)</td>
                            <td>@(q.GueltigBis is null ? "unbefristet" : Anzeige.Datum(q.GueltigBis))</td>
                            <td>@(q.Lehrgangsort ?? "–")</td>
                            <td>@(q.Stunden?.ToString("0.#") ?? "–")</td>
                            <td><partial name="_Loeschen" model="@(("qualifikation", q.Id, Model.DarfBearbeiten))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    async Task Eintragen(string schluessel, string titel, IReadOnlyList<SelectListItem> auswahl, string datum, string ort)
    {
        var gewaehlt = auswahl.FirstOrDefault(i => i.Selected)?.Value ?? "";
        <details class="mt-3" id="erfassen-@schluessel" open="@(Model.Offen == schluessel ? "open" : null)">
            <summary class="cursor-pointer text-sm font-semibold text-feuer-700">@titel</summary>
            <form method="post" asp-page-handler="Qualifikation" asp-route-id="@Model.Mitglied!.Id" class="mt-3 grid gap-3 sm:grid-cols-3"
                  x-data="{ monate: @monate, art: '@gewaehlt', datum: '@DatumEingabe.Text(Model.Heute)', bis: '' }"
                  x-effect="bis = plusMonate(datum, monate[art])">
                <div class="sm:col-span-3"><label class="etikett" for="@schluessel-id">Bezeichnung</label><select id="@schluessel-id" name="QualifikationId" asp-items="auswahl" class="eingabe" required x-model="art"><option value="">bitte wählen</option></select></div>
                <div><label class="etikett" for="@schluessel-erworben">@datum</label><input id="@schluessel-erworben" name="ErworbenAm" type="date" class="eingabe" required x-model="datum" /></div>
                <div><label class="etikett" for="@schluessel-bis">Gültig bis</label><input id="@schluessel-bis" name="GueltigBis" type="date" class="eingabe" x-model="bis" /><p class="mt-1 text-xs text-gray-500">Vorschlag aus den Stammdaten; leer heißt unbefristet.</p></div>
                <div><label class="etikett" for="@schluessel-stunden">Stunden</label><input id="@schluessel-stunden" name="Stunden" type="number" step="0.5" min="0" class="eingabe" /></div>
                <div class="sm:col-span-2"><label class="etikett" for="@schluessel-ort">@ort</label><input id="@schluessel-ort" name="Lehrgangsort" class="eingabe" placeholder="z. B. LFS Bruchsal, FTZ Göppingen" /></div>
                <div><label class="etikett" for="@schluessel-urkunde">Urkunde / Besitzzeugnis</label><input id="@schluessel-urkunde" name="Urkunde" class="eingabe" maxlength="100" placeholder="Nummer oder Ablageort" /></div>
                <div class="sm:col-span-3"><label class="etikett" for="@schluessel-bem">Bemerkung</label><input id="@schluessel-bem" name="Bemerkung" class="eingabe" /></div>
                <div class="sm:col-span-3"><button type="submit" class="knopf">Eintragen</button></div>
            </form>
        </details>
    }
}

<section class="karte mb-6" id="lehrgaenge">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">Lehrgangsteilnahmen</h2>
        @if (Model.DarfBearbeiten)
        {
            <a asp-page="Lehrgang" asp-route-mitgliedId="@m.Id" class="knopf-zweit">Lehrgang anmelden</a>
        }
    </div>
    @if (Model.Teilnahmen.Count == 0)
    {
        <p class="text-sm text-gray-500">Keine Anmeldung. Bestandene Lehrgänge stehen unten unter Lehrgänge und Qualifikationen.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tabelle">
                <thead><tr><th>Lehrgang</th><th>Angemeldet</th><th>Zugewiesen</th><th>Zeitraum</th><th>Stand</th><th></th></tr></thead>
                <tbody>
                    @foreach (var t in Model.Teilnahmen)
                    {
                        var stand = t.Stand(Model.Heute);
                        <tr>
                            <td>@t.Qualifikation?.Bezeichnung @if (t.Lehrgangsort is not null) { <div class="text-xs text-gray-500">@t.Lehrgangsort</div> }</td>
                            <td>@Anzeige.Datum(t.AngemeldetAm)</td>
                            <td>@Anzeige.Datum(t.ZugewiesenAm)</td>
                            <td>@Anzeige.Zeitraum(t.Von, t.Bis)</td>
                            <td><span class="@(stand switch { Fevad.Domain.Ausbildung.LehrgangStand.Bestanden => "ampel-gruen", Fevad.Domain.Ausbildung.LehrgangStand.NichtBestanden or Fevad.Domain.Ausbildung.LehrgangStand.ErgebnisFehlt => "ampel-rot", _ => "ampel-gelb" })">@Anzeige.Text(stand)</span></td>
                            <td>@if (Model.DarfBearbeiten) { <a asp-page="Lehrgang" asp-route-mitgliedId="@m.Id" asp-route-id="@t.Id" class="text-sm text-feuer-700 hover:underline">bearbeiten</a> }</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="karte mb-6">
    <h2 class="mb-2 text-lg font-semibold">Lehrgänge und Qualifikationen</h2>
    @{ await Tabelle(Model.Qualifikationen.Where(q => q.Qualifikation?.Art != Fevad.Domain.Ausbildung.QualifikationArt.Abzeichen).ToList(), "Noch nichts eingetragen."); }
    @if (Model.DarfBearbeiten)
    {
        await Eintragen("qualifikation", "Lehrgang, Fahrerlaubnis oder Qualifikation direkt eintragen", Model.Qualifikationsauswahl, "Erworben am", "Lehrgangsort");
    }
</section>

<section class="karte mb-6">
    <h2 class="mb-2 text-lg font-semibold">Abzeichen</h2>
    @{ await Tabelle(Model.Qualifikationen.Where(q => q.Qualifikation?.Art == Fevad.Domain.Ausbildung.QualifikationArt.Abzeichen).ToList(), "Keine Abzeichen."); }
    @if (Model.DarfBearbeiten)
    {
        await Eintragen("abzeichen", "Abzeichen eintragen", Model.Abzeichenauswahl, "Abgelegt am", "Abnahmeort");
    }
</section>

<section class="karte mb-6">
    <h2 class="mb-2 text-lg font-semibold">Wiederkehrende Nachweise</h2>
    @if (Model.Nachweise.Count == 0)
    {
        <p class="text-sm text-gray-500">Noch nichts eingetragen.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tabelle">
                <thead><tr><th>Nachweis</th><th>Datum</th><th>Gültig bis</th><th>Durch</th><th>Bemerkung</th><th></th></tr></thead>
                <tbody>
                    @foreach (var n in Model.Nachweise)
                    {
                        <tr>
                            <td>@n.Nachweisart?.Bezeichnung</td>
                            <td>@Anzeige.Datum(n.Datum)</td>
                            <td>@Anzeige.Datum(n.GueltigBis)</td>
                            <td>@(n.DurchgefuehrtVon ?? "–")</td>
                            <td>@(n.Bemerkung ?? "–")</td>
                            <td><partial name="_Loeschen" model="@(("nachweis", n.Id, n.Nachweisart!.Gesundheitsbezogen ? Model.DarfAtemschutzBearbeiten : Model.DarfNachweise))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.Nachweisauswahl.Count > 0)
    {
        <details class="mt-3" id="erfassen-nachweis" open="@(Model.Offen == "nachweis" ? "open" : null)">
            <summary class="cursor-pointer text-sm font-semibold text-feuer-700">Nachweis oder Untersuchung eintragen (z. B. Führerscheinkontrolle)</summary>
            <form method="post" asp-page-handler="Nachweis" asp-route-id="@m.Id" class="mt-3 grid gap-3 sm:grid-cols-3"
                  x-data="{ monate: @monate, art: '@(Model.Nachweisauswahl.FirstOrDefault(i => i.Selected)?.Value)', datum: '@DatumEingabe.Text(Model.Heute)', bis: '' }"
                  x-effect="bis = plusMonate(datum, monate[art])">
                <div class="sm:col-span-3"><label class="etikett" for="n-art">Nachweis</label><select id="n-art" name="NachweisartId" asp-items="Model.Nachweisauswahl" class="eingabe" required x-model="art"><option value="">bitte wählen</option></select></div>
                <div><label class="etikett" for="n-datum">Datum</label><input id="n-datum" name="Datum" type="date" class="eingabe" required x-model="datum" /></div>
                <div><label class="etikett" for="n-bis">Gültig bis</label><input id="n-bis" name="GueltigBis" type="date" class="eingabe" x-model="bis" /><p class="mt-1 text-xs text-gray-500">Vorschlag aus den Stammdaten; bei einmaligen Nachweisen leer.</p></div>
                <div><label class="etikett" for="n-durch">Durchgeführt von</label><input id="n-durch" name="DurchgefuehrtVon" class="eingabe" /></div>
                <div class="sm:col-span-3"><label class="etikett" for="n-bem">Bemerkung</label><input id="n-bem" name="Bemerkung" class="eingabe" placeholder="z. B. Klassen B, C1, C; Führerschein gültig bis …" /></div>
                <div class="sm:col-span-3"><button type="submit" class="knopf">Eintragen</button></div>
            </form>
        </details>
    }
</section>

<section class="karte mb-6">
    <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
        <h2 class="text-lg font-semibold">Atemschutz</h2>
        @if (Model.Atemschutz is { } status)
        {
            <span class="text-sm">Einsatzstatus:
                @switch (status.Ampel)
                {
                    case Fevad.Domain.Gemeinsam.Fristampel.Rot: <span class="ampel-rot">nicht einsatzbereit</span> break;
                    case Fevad.Domain.Gemeinsam.Fristampel.Gelb: <span class="ampel-gelb">einsatzbereit, Frist läuft ab</span> break;
                    default: <span class="ampel-gruen">einsatzbereit</span> break;
                }
            </span>
        }
    </div>

    @if (Model.DarfAtemschutzLesen)
    {
        <h3 class="mb-1 mt-2 font-semibold">Arbeitsmedizinische Vorsorge (G 26.3)</h3>
        <p class="mb-2 text-xs text-gray-500">Gesundheitsdatum: nur Datum, Ergebnis und nächste Frist. Befunde gehören nicht hierher.</p>
        @if (Model.Vorsorgen.Count == 0)
        {
            <p class="text-sm text-gray-500">Keine Vorsorge eingetragen.</p>
        }
        else
        {
            <div class="overflow-x-auto">
            <table class="tabelle">
                <thead><tr><th>Datum</th><th>Ergebnis</th><th>Nächste fällig</th><th>Bemerkung</th><th></th></tr></thead>
                <tbody>
                    @foreach (var v in Model.Vorsorgen)
                    {
                        <tr>
                            <td>@Anzeige.Datum(v.UntersuchtAm)</td>
                            <td>@Anzeige.Text(v.Ergebnis)</td>
                            <td>@Anzeige.Datum(v.NaechsteFaellig)</td>
                            <td>@(v.Bemerkung ?? "–")</td>
                            <td><partial name="_Loeschen" model="@(("vorsorge", v.Id, Model.DarfAtemschutzBearbeiten))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        }
        @if (Model.DarfAtemschutzBearbeiten)
        {
            <details class="mt-3" id="erfassen-vorsorge" open="@(Model.Offen == "vorsorge" ? "open" : null)">
                <summary class="cursor-pointer text-sm font-semibold text-feuer-700">Vorsorge eintragen</summary>
                <form method="post" asp-page-handler="Vorsorge" asp-route-id="@m.Id" class="mt-3 grid gap-3 sm:grid-cols-3">
                    <div><label class="etikett" for="v-datum">Untersucht am</label><input id="v-datum" name="UntersuchtAm" type="date" class="eingabe" required /></div>
                    <div><label class="etikett" for="v-erg">Ergebnis</label><select id="v-erg" name="Ergebnis" asp-items="AkteModel.Vorsorgeergebnisse" class="eingabe" required></select></div>
                    <div><label class="etikett" for="v-naechste">Nächste fällig</label><input id="v-naechste" name="NaechsteFaellig" type="date" class="eingabe" /><p class="mt-1 text-xs text-gray-500">Leer: nach Intervall aus den Einstellungen (Alter am Untersuchungstag). Datum der Bescheinigung geht vor.</p></div>
                    <div class="sm:col-span-3"><label class="etikett" for="v-bem">Bemerkung (organisatorisch, kein Befund)</label><input id="v-bem" name="Bemerkung" maxlength="200" class="eingabe" /></div>
                    <div class="sm:col-span-3"><button type="submit" class="knopf">Eintragen</button></div>
                </form>
            </details>
        }
    }

    <div class="mb-1 mt-4 flex flex-wrap items-center justify-between gap-2">
        <h3 class="font-semibold">Übungen, Unterweisungen und Einsätze</h3>
        @if (Model.DarfAtemschutzLesen)
        {
            <span class="text-sm">Expositionsnachweis:
                <a asp-page-handler="Exposition" asp-route-id="@m.Id" class="text-feuer-700 hover:underline">PDF</a> ·
                <a asp-page-handler="Exposition" asp-route-id="@m.Id" asp-route-format="csv" class="text-feuer-700 hover:underline">CSV</a>
            </span>
        }
    </div>
    @if (Model.AtemschutzNachweise.Count == 0)
    {
        <p class="text-sm text-gray-500">Keine Einträge.</p>
    }
    else
    {
        <div class="overflow-x-auto">
            <table class="tabelle">
                <thead><tr><th>Datum</th><th>Art</th><th>Minuten</th><th>Gerät</th><th>Gefahrstoffe</th><th>Ort</th><th>Tätigkeit</th><th></th></tr></thead>
                <tbody>
                    @foreach (var n in Model.AtemschutzNachweise)
                    {
                        <tr>
                            <td>@Anzeige.Datum(n.Datum)</td>
                            <td>@Anzeige.Text(n.Art)</td>
                            <td>@(n.Minuten?.ToString() ?? "–")</td>
                            <td>@(string.Join(" · ", new[] { n.Geraetetyp, n.PaGeraet is null ? null : "PA " + n.PaGeraet, n.Maske is null ? null : "Maske " + n.Maske }.Where(x => x is not null)) is { Length: > 0 } geraet ? geraet : "–")</td>
                            <td>@(n.Exposition ?? "–")</td>
                            <td>@(n.Ort ?? "–")</td>
                            <td>@(n.Taetigkeit ?? "–")</td>
                            <td><partial name="_Loeschen" model="@(("atemschutz", n.Id, Model.DarfAtemschutzBearbeiten))" /></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    @if (Model.DarfAtemschutzBearbeiten)
    {
        <details class="mt-3" id="erfassen-atemschutz" open="@(Model.Offen == "atemschutz" ? "open" : null)">
            <summary class="cursor-pointer text-sm font-semibold text-feuer-700">Atemschutz-Nachweis eintragen</summary>
            <form method="post" asp-page-handler="Atemschutz" asp-route-id="@m.Id" class="mt-3 grid gap-3 sm:grid-cols-3">
                <div><label class="etikett" for="a-art">Art</label><select id="a-art" name="Art" asp-items="Model.AtemschutzAuswahl" class="eingabe" required></select></div>
                <div><label class="etikett" for="a-datum">Datum</label><input id="a-datum" name="Datum" type="date" class="eingabe" required value="@Model.Heute.ToString("yyyy-MM-dd")" /></div>
                <div><label class="etikett" for="a-min">Minuten unter Atemschutz</label><input id="a-min" name="Minuten" type="number" min="0" class="eingabe" /></div>
                <div><label class="etikett" for="a-geraet">Gerätetyp</label><input id="a-geraet" name="Geraetetyp" class="eingabe" placeholder="z. B. PA 300 bar" /></div>
                <div><label class="etikett" for="a-ort">Ort</label><input id="a-ort" name="Ort" class="eingabe" placeholder="z. B. Übungsanlage Göppingen" /></div>
                <div><label class="etikett" for="a-taet">Tätigkeit</label><input id="a-taet" name="Taetigkeit" class="eingabe" /></div>
                <div><label class="etikett" for="a-pa">Pressluftatmer (Nummer)</label><input id="a-pa" name="PaGeraet" maxlength="50" class="eingabe" /></div>
                <div><label class="etikett" for="a-maske">Maske (Nummer)</label><input id="a-maske" name="Maske" maxlength="50" class="eingabe" /></div>
                <div><label class="etikett" for="a-expo">Gefahrstoffe (Exposition)</label><input id="a-expo" name="Exposition" maxlength="200" class="eingabe" placeholder="z. B. Brandrauch" /></div>
                <div class="sm:col-span-3"><button type="submit" class="knopf">Eintragen</button></div>
            </form>
        </details>
    }
</section>

