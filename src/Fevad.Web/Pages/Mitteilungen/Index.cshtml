@page
@model Fevad.Web.Pages.Mitteilungen.IndexModel
@using Fevad.Domain.Kommunikation
@{
    ViewData["Title"] = "Mitteilungen";
    var aktuell = Model.Eingang.Where(e => e.Aktuell).ToList();
    var aelter = Model.Eingang.Where(e => !e.Aktuell).ToList();
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">@ViewData["Title"]</h1>
    @if (Model.Schreiben)
    {
        <a asp-page="Bearbeiten" class="knopf">Neue Mitteilung</a>
    }
</div>
<p class="mb-4 max-w-3xl text-sm text-gray-600">Dienstliche Mitteilungen des Kommandos und der Jugendleitung. Keine Alarmierung.</p>

<section class="mb-6">
    <h2 class="mb-2 text-lg font-semibold">An mich</h2>
    @if (Model.Eingang.Count == 0)
    {
        <p class="karte text-sm text-gray-500">Keine Mitteilungen.</p>
    }
    else
    {
        <ul class="grid gap-2">
            @foreach (var e in aktuell)
            {
                <partial name="_Eintrag" model="e" />
            }
        </ul>
        @if (aelter.Count > 0)
        {
            <details class="mt-3">
                <summary class="cursor-pointer text-sm font-semibold text-feuer-700">Ältere Mitteilungen (@aelter.Count)</summary>
                <ul class="mt-2 grid gap-2">
                    @foreach (var e in aelter)
                    {
                        <partial name="_Eintrag" model="e" />
                    }
                </ul>
            </details>
        }
    }
</section>

@if (Model.Schreiben)
{
    <section>
        <h2 class="mb-2 text-lg font-semibold">Verfasst und verwaltet</h2>
        @if (Model.Verfasst.Count == 0)
        {
            <p class="karte text-sm text-gray-500">Noch keine Mitteilungen.</p>
        }
        else
        {
            <div class="karte overflow-x-auto p-0">
                <table class="tabelle">
                    <thead><tr><th scope="col">Titel</th><th scope="col">Stand</th><th scope="col">Datum</th><th scope="col">Lesestand</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.Verfasst)
                        {
                            <tr>
                                <td><a asp-page="Details" asp-route-id="@v.Id" class="text-feuer-700 hover:underline">@v.Titel</a></td>
                                <td>@Anzeige.Text(v.Status)</td>
                                <td>@Anzeige.DatumZeit(v.Am)</td>
                                <td>
                                    @if (v.Status != MitteilungStatus.Entwurf)
                                    {
                                        <span>@v.Gelesen von @v.Empfaenger gelesen@(v.Bestaetigt is { } b ? $", {b} bestätigt" : "")</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
}
