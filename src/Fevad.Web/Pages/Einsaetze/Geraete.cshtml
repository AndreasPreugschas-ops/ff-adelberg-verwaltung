@page "{id:guid}"
@using Fevad.Domain.Einsaetze
@model Fevad.Web.Pages.Einsaetze.GeraeteModel
@{
    var e = Model.Einsatz;
    ViewData["Title"] = $"Geräte nach Einsatz {e.Einsatznummer}";
    var belastungen = Enum.GetValues<Belastung>();
}
<a asp-page="Bericht" asp-route-id="@e.Id" class="text-sm text-feuer-700 hover:underline">← Einsatzbericht @e.Einsatznummer</a>
<h1 class="mt-2 mb-1 text-2xl font-bold">Geräte und Wäsche nach dem Einsatz</h1>
<p class="mb-4 text-sm text-gray-600">Einsatz @e.Einsatznummer · @e.Stichwort · @Anzeige.DatumZeit(e.Alarmiert) Uhr</p>

<p class="mb-4 max-w-3xl text-sm text-gray-700">
    Benutzte Einzelgeräte sind sofort bis zur nächsten bestandenen Prüfung gesperrt (DGUV Grundsatz 305-002; nach dynamischer Belastung sofort prüfen).
    Mengenartikel wie Schläuche werden nicht gesperrt, sie kommen nur auf die Werkstattliste. Atemschutzgeräte landen auf der Liste der Atemschutzwerkstatt.
</p>

<section class="karte mb-6 overflow-x-auto p-0">
    <table class="tabelle">
        <thead><tr><th>Gegenstand</th><th>Fahrzeug</th><th>Belastung</th><th>Stand</th><th>Bemerkung</th><th></th></tr></thead>
        <tbody>
            @foreach (var z in Model.Zeilen)
            {
                <tr>
                    <td class="font-medium">@z.Gegenstand</td>
                    <td>@(z.Fahrzeug ?? "–")</td>
                    <td>@Anzeige.Text(z.Belastung)</td>
                    <td>
                        @if (z.Erledigt)
                        {
                            <span class="ampel-gruen">@(z.Mengenartikel ? "zurück" : "geprüft")</span>
                        }
                        else
                        {
                            <span class="@(z.Mengenartikel ? "ampel-gelb" : "ampel-rot")">@(z.Mengenartikel ? "auf Werkstattliste" : "gesperrt bis Prüfung")</span>
                        }
                    </td>
                    <td>@(z.Bemerkung ?? "")</td>
                    <td>
                        @if (Model.DarfAendern && !z.Erledigt)
                        {
                            <form method="post" asp-page-handler="Entfernen" asp-route-id="@e.Id">
                                <input type="hidden" name="zeileId" value="@z.Id" />
                                <button type="submit" class="text-sm text-feuer-700 hover:underline">Entfernen</button>
                            </form>
                        }
                    </td>
                </tr>
            }
            @if (Model.Zeilen.Count == 0)
            {
                <tr><td colspan="6" class="text-sm text-gray-500">Noch nichts erfasst.</td></tr>
            }
        </tbody>
    </table>
</section>

@if (Model.DarfAendern)
{
    <div class="mb-6 grid gap-4 lg:grid-cols-2">
        <form method="post" asp-page-handler="Geraet" asp-route-id="@e.Id" class="karte grid content-start gap-3">
            <h2 class="font-semibold">Einzelgerät</h2>
            <div>
                <label for="nummer" class="etikett">Inventarnummer (scannen oder eingeben)</label>
                <input id="nummer" name="nummer" list="beladung" class="eingabe" autocomplete="off" required />
                <datalist id="beladung">
                    @foreach (var n in Model.Vorschlaege)
                    {
                        <option value="@n"></option>
                    }
                </datalist>
            </div>
            <div>
                <label for="belastung-geraet" class="etikett">Belastung</label>
                <select id="belastung-geraet" name="belastung" class="eingabe">
                    @foreach (var b in belastungen)
                    {
                        <option value="@b">@Anzeige.Text(b)</option>
                    }
                </select>
            </div>
            <div><label for="bemerkung-geraet" class="etikett">Bemerkung</label><input id="bemerkung-geraet" name="bemerkung" class="eingabe" maxlength="500" placeholder="z. B. Leine beim Abseilen belastet" /></div>
            <div><button type="submit" class="knopf">Erfassen und sperren</button></div>
        </form>

        <div class="grid content-start gap-4">
            @if (Model.Faecher.Count > 0)
            {
                <form method="post" asp-page-handler="Fach" asp-route-id="@e.Id" class="karte grid content-start gap-3">
                    <h2 class="font-semibold">Ganzes Fach</h2>
                    <div>
                        <label for="fach" class="etikett">Fahrzeug und Fach</label>
                        <select id="fach" name="fach" class="eingabe" asp-items="Model.Faecher"></select>
                    </div>
                    <div>
                        <label for="belastung-fach" class="etikett">Belastung</label>
                        <select id="belastung-fach" name="belastung" class="eingabe">
                            @foreach (var b in belastungen)
                            {
                                <option value="@b">@Anzeige.Text(b)</option>
                            }
                        </select>
                    </div>
                    <div><button type="submit" class="knopf-zweit">Alle Geräte im Fach sperren</button></div>
                </form>
            }
            @if (Model.AtemschutzOffen.Count > 0)
            {
                <form method="post" asp-page-handler="Atemschutz" asp-route-id="@e.Id" class="karte grid content-start gap-2">
                    <h2 class="font-semibold">Atemschutz aus dem Bericht</h2>
                    <p class="text-sm text-gray-700">Pressluftatmer und Masken: @string.Join(", ", Model.AtemschutzOffen)</p>
                    <div><button type="submit" class="knopf-zweit">Übernehmen und sperren</button></div>
                </form>
            }
        </div>

        <form method="post" asp-page-handler="Menge" asp-route-id="@e.Id" class="karte grid content-start gap-3 lg:col-span-2 lg:grid-cols-5 lg:items-end">
            <h2 class="font-semibold lg:col-span-5">Mengenartikel (z. B. Schläuche), ohne Sperre</h2>
            <div class="lg:col-span-2"><label for="material" class="etikett">Material</label><select id="material" name="materialId" class="eingabe" asp-items="Model.Materialien"></select></div>
            <div><label for="anzahl" class="etikett">Anzahl</label><input id="anzahl" name="anzahl" type="number" min="1" max="999" value="1" class="eingabe" /></div>
            <div><label for="fahrzeug" class="etikett">Fahrzeug</label><select id="fahrzeug" name="fahrzeugId" class="eingabe" asp-items="Model.Fahrzeuge"><option value="">–</option></select></div>
            <div>
                <label for="belastung-menge" class="etikett">Belastung</label>
                <select id="belastung-menge" name="belastung" class="eingabe">
                    @foreach (var b in belastungen)
                    {
                        <option value="@b">@Anzeige.Text(b)</option>
                    }
                </select>
            </div>
            <div class="lg:col-span-4"><label for="bemerkung-menge" class="etikett">Bemerkung</label><input id="bemerkung-menge" name="bemerkung" class="eingabe" maxlength="500" /></div>
            <div><button type="submit" class="knopf-zweit">Auf Werkstattliste</button></div>
        </form>
    </div>
}

<section class="karte mb-6 max-w-3xl">
    <h2 class="mb-1 font-semibold">Verbrauchsmaterial aus dem Lager</h2>
    <p class="mb-3 text-sm text-gray-600">Ölbinder, Schaummittel, Verbandmaterial: Die Entnahme mindert den Bestand und wird mit dem Wiederbeschaffungspreis zum Posten im Kostenersatz.</p>
    @if (Model.Verbrauch.Count > 0)
    {
        <ul class="mb-3 text-sm">
            @foreach (var v in Model.Verbrauch)
            {
                <li>@v.Menge.ToString("0.##") @v.Einheit @v.Artikel@(v.Wert is { } wert ? $", {wert:N2} €" : "")@if (v.ImKostenersatz) { <span class="ml-1 text-xs text-gray-500">(im Kostenersatz)</span> }</li>
            }
        </ul>
    }
    @if (Model.DarfAendern && Model.Lagerartikel.Count > 0)
    {
        <form method="post" asp-page-handler="Verbrauch" asp-route-id="@e.Id" class="grid gap-3 sm:grid-cols-4 sm:items-end">
            <div class="sm:col-span-2"><label for="lagerartikel" class="etikett">Material</label><select id="lagerartikel" name="artikelId" class="eingabe" asp-items="Model.Lagerartikel"></select></div>
            <div><label for="verbrauch-menge" class="etikett">Menge</label><input id="verbrauch-menge" name="menge" type="text" inputmode="decimal" class="eingabe" /></div>
            <div><button type="submit" class="knopf-zweit">Entnehmen</button></div>
        </form>
    }
</section>

<section class="karte max-w-3xl">
    <h2 class="mb-1 font-semibold">Einsatzkleidung zur Sammelwäsche</h2>
    <p class="mb-3 text-sm text-gray-600">Die Kleiderkammer sieht nur Name und Einsatz, keine Angaben zur Exposition. Bei Hautkontakt oder Exposition im Bericht ist die Wäsche ohnehin vermerkt.</p>
    @if (Model.Teilnehmer.Count == 0)
    {
        <p class="text-sm text-gray-500">Keine Teilnehmer im Bericht.</p>
    }
    else
    {
        <form method="post" asp-page-handler="Waesche" asp-route-id="@e.Id">
            <ul class="mb-3 grid gap-1 sm:grid-cols-2">
                @foreach (var t in Model.Teilnehmer)
                {
                    <li>
                        <label class="flex items-center gap-2 text-sm">
                            <input type="checkbox" name="teilnahmeIds" value="@t.TeilnahmeId" checked="@(t.Vermerkt || t.AusExposition)" disabled="@(!Model.DarfAendern || t.AusExposition)" class="h-4 w-4" />
                            @t.Name
                            @if (t.Erledigt) { <span class="ampel-gruen">gewaschen</span> }
                        </label>
                    </li>
                }
            </ul>
            @if (Model.DarfAendern)
            {
                <button type="submit" class="knopf-zweit">Wäscheliste speichern</button>
            }
        </form>
    }
</section>
