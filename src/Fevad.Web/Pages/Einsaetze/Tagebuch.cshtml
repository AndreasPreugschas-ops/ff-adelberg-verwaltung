@page "{id:guid}"
@using Fevad.Domain.Einsaetze
@model Fevad.Web.Pages.Einsaetze.TagebuchModel
@{
    var e = Model.Einsatz;
    ViewData["Title"] = $"Tagebuch {e.Einsatznummer}";
}
<a asp-page="Bericht" asp-route-id="@e.Id" class="text-sm text-feuer-700 hover:underline">← Einsatzbericht</a>
<h1 class="mb-1 mt-2 text-2xl font-bold">Einsatztagebuch @e.Einsatznummer</h1>
<p class="mb-4 text-sm text-gray-600">@(e.Stichwort ?? "ohne Stichwort") · alarmiert @Anzeige.DatumZeit(e.Alarmiert) Uhr@(string.IsNullOrWhiteSpace(e.Ort) ? "" : $" · {e.Strasse} {e.Hausnummer}, {e.Ort}")</p>

@if (TempData["Meldung"] is string meldung)
{
    <div class="alert alert-success">@meldung</div>
}
@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-danger">@fehler</div>
}
@if (!e.TagebuchOffen)
{
    <div class="alert alert-success">Der Bericht ist freigegeben; Tagebuch, Einsatzleitung und Abschnitte sind schreibgeschützt.</div>
}

@if (Model.DarfSchreiben)
{
    <form method="post" asp-page-handler="Eintrag" asp-route-id="@e.Id" class="karte mb-4 grid gap-3" x-data="{ art: '@Model.Eintrag.Art' }">
        <div class="flex flex-wrap gap-2" role="group" aria-label="Art des Eintrags">
            @foreach (var art in Enum.GetValues<TagebuchArt>())
            {
                <button type="button" class="rounded border px-3 py-2 text-sm" x-bind:class="art === '@art' ? 'border-feuer-700 bg-feuer-700 text-white' : 'border-gray-300'" x-on:click="art = '@art'">@Anzeige.Text(art)</button>
            }
            <input type="hidden" name="Eintrag.Art" x-bind:value="art" />
        </div>
        <textarea name="Eintrag.Text" rows="3" class="eingabe" maxlength="2000" placeholder="z. B. HLF 10 an Einsatzstelle, Erkundung läuft" required></textarea>
        <div class="flex flex-wrap items-end gap-3">
            <div>
                <label class="etikett" for="Eintrag_Zeit">Uhrzeit (leer = jetzt)</label>
                <input id="Eintrag_Zeit" name="Eintrag.Zeit" class="eingabe w-28" placeholder="HH:MM" fevad-uhrzeit />
            </div>
            <button type="submit" class="knopf">Eintragen</button>
        </div>
    </form>
}

<section class="karte mb-4">
    <h2 class="mb-2 font-semibold">Tagebuch</h2>
    @if (e.Tagebuch.Count == 0)
    {
        <p class="text-sm text-gray-600">Noch keine Einträge.</p>
    }
    <ol class="divide-y divide-gray-200">
        @foreach (var t in e.Tagebuch.OrderByDescending(t => t.Zeitpunkt))
        {
            <li class="flex gap-3 py-2">
                <span class="w-14 shrink-0 font-mono text-sm font-semibold">@Anzeige.Zeit(t.Zeitpunkt)</span>
                <div class="min-w-0 flex-1">
                    <div class="text-xs text-gray-500">@Anzeige.Text(t.Art)@(t.Verfasser is null ? "" : $" · {t.Verfasser}")</div>
                    <div class="whitespace-pre-line break-words">@t.Text</div>
                </div>
                @if (Model.DarfSchreiben)
                {
                    <form method="post" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="eintrag" asp-route-eintragId="@t.Id">
                        <button type="submit" class="text-xs text-feuer-700 hover:underline">entfernen</button>
                    </form>
                }
            </li>
        }
    </ol>
</section>

<section class="karte mb-4">
    <h2 class="mb-2 font-semibold">Einsatzleitung</h2>
    <ul class="mb-3 text-sm">
        @foreach (var l in e.Einsatzleitungen.OrderBy(l => l.Ab))
        {
            <li class="flex flex-wrap items-baseline gap-2 py-1">
                <span class="font-mono font-semibold">@Anzeige.Zeit(l.Ab)</span>
                <span>@(l.Mitglied is { } m ? $"{m.Vorname} {m.Nachname}" : l.Extern)</span>
                @if (l.Bemerkung is not null) { <span class="text-gray-500">· @l.Bemerkung</span> }
                @if (Model.DarfSchreiben)
                {
                    <form method="post" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="leitung" asp-route-eintragId="@l.Id" class="inline">
                        <button type="submit" class="text-xs text-feuer-700 hover:underline">entfernen</button>
                    </form>
                }
            </li>
        }
        @if (e.Einsatzleitungen.Count == 0) { <li class="text-gray-600">Noch nicht eingetragen.</li> }
    </ul>
    @if (Model.DarfSchreiben)
    {
        <form method="post" asp-page-handler="Leitung" asp-route-id="@e.Id" class="grid gap-3 sm:grid-cols-4 sm:items-end">
            <div><label class="etikett" for="Leitung_Zeit">ab (leer = jetzt)</label><input id="Leitung_Zeit" name="Leitung.Zeit" class="eingabe" placeholder="HH:MM" fevad-uhrzeit /></div>
            <div><label class="etikett" for="Leitung_MitgliedId">Mitglied</label>
                <select id="Leitung_MitgliedId" name="Leitung.MitgliedId" class="eingabe"><option value="">–</option>
                    @foreach (var m in Model.Mitglieder) { <option value="@m.Value">@m.Text</option> }
                </select></div>
            <div><label class="etikett" for="Leitung_Extern">oder extern</label><input id="Leitung_Extern" name="Leitung.Extern" class="eingabe" placeholder="z. B. KBM" maxlength="200" /></div>
            <div><button type="submit" class="knopf">Übergabe eintragen</button></div>
        </form>
    }
    <form method="post" asp-page-handler="Stufe" asp-route-id="@e.Id" class="mt-3 flex flex-wrap items-end gap-3">
        <div>
            <label class="etikett" asp-for="Stufe">Führungsstufe (FwDV 100)</label>
            <select asp-for="Stufe" class="eingabe" disabled="@(!Model.DarfSchreiben)">
                <option value="">nicht angegeben</option>
                @foreach (var s in Enum.GetValues<Fuehrungsstufe>()) { <option value="@s" selected="@(s == Model.Stufe)">@Anzeige.Text(s)</option> }
            </select>
        </div>
        @if (Model.DarfSchreiben) { <button type="submit" class="knopf-zweit">Speichern</button> }
    </form>
</section>

<section class="karte">
    <h2 class="mb-2 font-semibold">Einsatzabschnitte</h2>
    <ul class="mb-3 text-sm">
        @foreach (var a in e.Abschnitte.OrderBy(a => a.Bezeichnung))
        {
            <li class="py-1">
                <span class="font-semibold">@a.Bezeichnung</span>: @(a.Leiter is { } l ? $"{l.Vorname} {l.Nachname}" : a.LeiterExtern ?? "ohne Leiter")
                @if (a.Auftrag is not null) { <span class="text-gray-500">· @a.Auftrag</span> }
                @if (Model.DarfSchreiben)
                {
                    <form method="post" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="abschnitt" asp-route-eintragId="@a.Id" class="inline">
                        <button type="submit" class="text-xs text-feuer-700 hover:underline">entfernen</button>
                    </form>
                }
            </li>
        }
        @if (e.Abschnitte.Count == 0) { <li class="text-gray-600">Keine Abschnitte gebildet.</li> }
    </ul>
    @if (Model.DarfSchreiben)
    {
        <form method="post" asp-page-handler="Abschnitt" asp-route-id="@e.Id" class="grid gap-3 sm:grid-cols-4 sm:items-end">
            <div><label class="etikett" for="Abschnitt_Bezeichnung">Abschnitt</label><input id="Abschnitt_Bezeichnung" name="Abschnitt.Bezeichnung" class="eingabe" maxlength="100" placeholder="z. B. EA 1 Nord" /></div>
            <div><label class="etikett" for="Abschnitt_LeiterId">Leiter</label>
                <select id="Abschnitt_LeiterId" name="Abschnitt.LeiterId" class="eingabe"><option value="">–</option>
                    @foreach (var m in Model.Mitglieder) { <option value="@m.Value">@m.Text</option> }
                </select></div>
            <div><label class="etikett" for="Abschnitt_Auftrag">Auftrag</label><input id="Abschnitt_Auftrag" name="Abschnitt.Auftrag" class="eingabe" maxlength="500" /></div>
            <div><button type="submit" class="knopf-zweit">Abschnitt anlegen</button></div>
        </form>
    }
</section>
