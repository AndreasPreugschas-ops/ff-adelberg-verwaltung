@page
@model Fevad.Web.Pages.Einsaetze.NeuModel
@{
    ViewData["Title"] = "Neuer Einsatz";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Alle Einsätze</a>
<h1 class="mt-2 mb-4 text-2xl font-bold">Neuer Einsatz</h1>
<p class="mb-4 max-w-xl text-sm text-gray-600">
    Normalerweise legt der alamos-Alarm den Bericht selbst an. Von Hand nur, wenn kein Alarm ankam,
    z. B. bei Nachbarschaftshilfe auf Zuruf. Die Einsatznummer wird automatisch vergeben.
</p>
<form method="post" class="karte grid max-w-md gap-4">
    <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
    <div>
        <label asp-for="Alarmiert" class="etikett"></label>
        <input asp-for="Alarmiert" class="eingabe" placeholder="TT.MM.JJJJ HH:MM" autocomplete="off" />
        <span asp-validation-for="Alarmiert" class="feldfehler"></span>
    </div>
    <div class="flex gap-2">
        <button type="submit" class="knopf">Anlegen und Bericht schreiben</button>
        <a asp-page="Index" class="knopf-zweit">Abbrechen</a>
    </div>
</form>
