@page "{id:guid}"
@using Fevad.Domain.Einsaetze
@model Fevad.Web.Pages.Einsaetze.BerichtModel
@{
    var e = Model.Einsatz!;
    ViewData["Title"] = $"Einsatz {e.Einsatznummer}";
    var statusFarbe = e.Status switch
    {
        EinsatzStatus.Freigegeben => "ampel-gruen",
        EinsatzStatus.InBearbeitung => "ampel-gelb",
        _ => "ampel-rot",
    };
    const string ZeitHinweis = "TT.MM.JJJJ HH:MM oder nur HH:MM";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Alle Einsätze</a>
<div class="mt-2 mb-4 flex flex-wrap items-center gap-3">
    <h1 class="text-2xl font-bold">Einsatz @e.Einsatznummer</h1>
    <span class="@statusFarbe">@Anzeige.Text(e.Status)</span>
    @if (Model.AusAlarm)
    {
        <span class="text-xs text-gray-500">Entwurf aus alamos FE2@(e.LeitstellenNummer is null ? "" : $", Leitstelle {e.LeitstellenNummer}")</span>
    }
</div>

@if (TempData["Meldung"] is string meldung)
{
    <div class="alert alert-success">@meldung</div>
}
@if (TempData["Fehler"] is string fehler)
{
    <div class="alert alert-danger">@fehler</div>
}

@if (e.Status == EinsatzStatus.Freigegeben)
{
    <div class="alert alert-success flex flex-wrap items-center justify-between gap-2">
        <span>Freigegeben am @Anzeige.DatumZeit(e.FreigegebenAm) Uhr@(Model.FreigegebenVon is null ? "" : $" von {Model.FreigegebenVon}").
            @(Model.DarfAendern ? "Änderungen werden protokolliert." : "Nur noch lesbar.")</span>
        @if (Model.DarfFreigeben)
        {
            <form method="post" asp-page-handler="Zuruecknehmen" asp-route-id="@e.Id">
                <input type="hidden" asp-for="Formular.Version" />
                <button type="submit" class="knopf-zweit">Freigabe zurücknehmen</button>
            </form>
        }
    </div>
}
else if (Model.Hindernisse.Count > 0)
{
    <div class="alert alert-warning">
        Für die Freigabe fehlt noch:
        <ul class="ml-5 list-disc">
            @foreach (var h in Model.Hindernisse)
            {
                <li>@h</li>
            }
        </ul>
    </div>
}

<form method="post" asp-route-id="@e.Id" class="grid gap-6">
    <input type="hidden" asp-for="Formular.Version" />
    <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
    <fieldset disabled="@(!Model.DarfAendern)" class="grid gap-6">

        <section class="karte grid gap-4 sm:grid-cols-4">
            <h2 class="text-lg font-semibold sm:col-span-4">Alarm</h2>
            <div><label asp-for="Formular.Stichwort" class="etikett"></label><input asp-for="Formular.Stichwort" class="eingabe" /><span asp-validation-for="Formular.Stichwort" class="feldfehler"></span></div>
            <div class="sm:col-span-3"><label asp-for="Formular.StichwortBeschreibung" class="etikett"></label><input asp-for="Formular.StichwortBeschreibung" class="eingabe" /></div>
            <div class="sm:col-span-4"><label asp-for="Formular.Meldung" class="etikett"></label><textarea asp-for="Formular.Meldung" rows="2" class="eingabe"></textarea></div>
            <div class="sm:col-span-2"><label asp-for="Formular.Strasse" class="etikett"></label><input asp-for="Formular.Strasse" class="eingabe" /></div>
            <div><label asp-for="Formular.Hausnummer" class="etikett"></label><input asp-for="Formular.Hausnummer" class="eingabe" /></div>
            <div><label asp-for="Formular.Plz" class="etikett"></label><input asp-for="Formular.Plz" class="eingabe" /></div>
            <div><label asp-for="Formular.Ort" class="etikett"></label><input asp-for="Formular.Ort" class="eingabe" /></div>
            <div><label asp-for="Formular.Ortsteil" class="etikett"></label><input asp-for="Formular.Ortsteil" class="eingabe" /></div>
            <div class="sm:col-span-2"><label asp-for="Formular.Objekt" class="etikett"></label><input asp-for="Formular.Objekt" class="eingabe" /></div>
        </section>

        <section class="karte grid gap-4 sm:grid-cols-5">
            <h2 class="text-lg font-semibold sm:col-span-5">Zeiten <span class="text-sm font-normal text-gray-500">(@ZeitHinweis, 24-Stunden-Format)</span></h2>
            <div><label asp-for="Formular.Alarmiert" class="etikett"></label><input asp-for="Formular.Alarmiert" class="eingabe" placeholder="TT.MM.JJJJ HH:MM" autocomplete="off" /><span asp-validation-for="Formular.Alarmiert" class="feldfehler"></span></div>
            <div><label asp-for="Formular.Ausgerueckt" class="etikett"></label><input asp-for="Formular.Ausgerueckt" class="eingabe" fevad-uhrzeit /><span asp-validation-for="Formular.Ausgerueckt" class="feldfehler"></span></div>
            <div><label asp-for="Formular.EintreffenEinsatzort" class="etikett"></label><input asp-for="Formular.EintreffenEinsatzort" class="eingabe" fevad-uhrzeit /><span asp-validation-for="Formular.EintreffenEinsatzort" class="feldfehler"></span></div>
            <div><label asp-for="Formular.Einsatzende" class="etikett"></label><input asp-for="Formular.Einsatzende" class="eingabe" fevad-uhrzeit /><span asp-validation-for="Formular.Einsatzende" class="feldfehler"></span></div>
            <div><label asp-for="Formular.EinsatzbereitschaftHergestellt" class="etikett"></label><input asp-for="Formular.EinsatzbereitschaftHergestellt" class="eingabe" fevad-uhrzeit /><span asp-validation-for="Formular.EinsatzbereitschaftHergestellt" class="feldfehler"></span></div>
        </section>

        <section class="karte grid gap-4 sm:grid-cols-3">
            <h2 class="text-lg font-semibold sm:col-span-3">Einordnung</h2>
            <div><label asp-for="Formular.StatistikKategorieId" class="etikett"></label><select asp-for="Formular.StatistikKategorieId" asp-items="Model.Kategorien" class="eingabe"><option value="">bitte wählen</option></select><span asp-validation-for="Formular.StatistikKategorieId" class="feldfehler"></span></div>
            <div><label asp-for="Formular.Rechtsgrundlage" class="etikett"></label><select asp-for="Formular.Rechtsgrundlage" asp-items="BerichtModel.Rechtsgrundlagen" class="eingabe"></select></div>
            <div><label asp-for="Formular.EinsatzleiterId" class="etikett"></label><select asp-for="Formular.EinsatzleiterId" asp-items="Model.Mitgliederauswahl" class="eingabe"><option value="">–</option></select><span asp-validation-for="Formular.EinsatzleiterId" class="feldfehler"></span></div>
            <div class="sm:col-span-3"><label asp-for="Formular.Lagebericht" class="etikett"></label><textarea asp-for="Formular.Lagebericht" rows="4" class="eingabe" placeholder="Lage beim Eintreffen"></textarea></div>
            <div class="sm:col-span-3"><label asp-for="Formular.Massnahmen" class="etikett"></label><textarea asp-for="Formular.Massnahmen" rows="4" class="eingabe" placeholder="Durchgeführte Maßnahmen"></textarea></div>
            <div class="grid grid-cols-2 gap-4 sm:col-span-3 sm:grid-cols-5">
                <div><label asp-for="Formular.Gerettete" class="etikett"></label><input asp-for="Formular.Gerettete" type="number" min="0" class="eingabe" /><span asp-validation-for="Formular.Gerettete" class="feldfehler"></span></div>
                <div><label asp-for="Formular.Verletzte" class="etikett"></label><input asp-for="Formular.Verletzte" type="number" min="0" class="eingabe" /><span asp-validation-for="Formular.Verletzte" class="feldfehler"></span></div>
                <div><label asp-for="Formular.Tote" class="etikett"></label><input asp-for="Formular.Tote" type="number" min="0" class="eingabe" /><span asp-validation-for="Formular.Tote" class="feldfehler"></span></div>
                <div><label asp-for="Formular.VerletzteFeuerwehr" class="etikett"></label><input asp-for="Formular.VerletzteFeuerwehr" type="number" min="0" class="eingabe" /><span asp-validation-for="Formular.VerletzteFeuerwehr" class="feldfehler"></span></div>
                <label class="flex items-center gap-2 self-end pb-2 text-sm"><input asp-for="Formular.Ueberoertlich" type="checkbox" class="h-4 w-4" /> Überörtliche Hilfe</label>
            </div>
        </section>

        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Fahrzeuge <span class="text-sm font-normal text-gray-500">(Zeiten @ZeitHinweis)</span></h2>
            @if (Model.Formular.Fahrzeuge.Count == 0)
            {
                <p class="text-sm text-gray-500">Noch kein Fahrzeug erfasst.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="tabelle">
                        <thead><tr><th>Fahrzeug</th><th>Ausgerückt</th><th>Eingetroffen</th><th>Zurück</th><th>Einsatzbereit</th><th>km</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Formular.Fahrzeuge.Count; i++)
                            {
                                var f = Model.Formular.Fahrzeuge[i];
                                <tr>
                                    <td class="whitespace-nowrap font-medium"><input type="hidden" asp-for="Formular.Fahrzeuge[i].FahrzeugId" />@Model.Fahrzeugnamen[f.FahrzeugId]</td>
                                    <td><input asp-for="Formular.Fahrzeuge[i].Ausgerueckt" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Fahrzeuge[i].Ausgerueckt" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Fahrzeuge[i].Eingetroffen" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Fahrzeuge[i].Eingetroffen" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Fahrzeuge[i].Zurueck" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Fahrzeuge[i].Zurueck" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Fahrzeuge[i].Einsatzbereit" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Fahrzeuge[i].Einsatzbereit" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Fahrzeuge[i].Kilometer" type="number" min="0" class="eingabe max-w-24" /><span asp-validation-for="Formular.Fahrzeuge[i].Kilometer" class="feldfehler"></span></td>
                                    <td>@if (Model.DarfAendern) { <button type="submit" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="fahrzeug" asp-route-index="@i" formnovalidate class="text-sm text-feuer-700 hover:underline">entfernen</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.DarfAendern && Model.FahrzeugeZumHinzufuegen.Count > 0)
            {
                <div class="mt-3 flex flex-wrap items-end gap-2">
                    <select name="neuFahrzeugId" asp-items="Model.FahrzeugeZumHinzufuegen" class="eingabe max-w-xs" aria-label="Fahrzeug wählen"></select>
                    <button type="submit" asp-page-handler="Hinzufuegen" asp-route-id="@e.Id" asp-route-was="fahrzeug" formnovalidate class="knopf-zweit">Fahrzeug hinzufügen</button>
                </div>
            }
        </section>

        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Teilnehmer <span class="text-sm font-normal text-gray-500">(@Model.Formular.Teilnehmer.Count; Von/Bis leer = Alarmierung bis Einsatzbereitschaft)</span></h2>
            @if (Model.Formular.Teilnehmer.Count == 0)
            {
                <p class="text-sm text-gray-500">Noch niemand erfasst.</p>
            }
            else
            {
                <div class="overflow-x-auto">
                    <table class="tabelle">
                        <thead><tr><th>Name</th><th>Fahrzeug</th><th>Funktion</th><th>Von</th><th>Bis</th><th>Atemschutz</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Formular.Teilnehmer.Count; i++)
                            {
                                var t = Model.Formular.Teilnehmer[i];
                                <tr x-data="{ atemschutz: @(t.Atemschutz ? "true" : "false") }">
                                    <td class="whitespace-nowrap font-medium"><input type="hidden" asp-for="Formular.Teilnehmer[i].MitgliedId" />@Model.Mitgliedernamen[t.MitgliedId]</td>
                                    <td><select asp-for="Formular.Teilnehmer[i].FahrzeugId" asp-items="Model.Fahrzeugauswahl" class="eingabe"><option value="">–</option></select></td>
                                    <td><input asp-for="Formular.Teilnehmer[i].Funktion" class="eingabe min-w-20" placeholder="z. B. GF, MA, AGT" /></td>
                                    <td><input asp-for="Formular.Teilnehmer[i].Von" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Teilnehmer[i].Von" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Teilnehmer[i].Bis" class="eingabe min-w-24" fevad-uhrzeit /><span asp-validation-for="Formular.Teilnehmer[i].Bis" class="feldfehler"></span></td>
                                    <td class="whitespace-nowrap">
                                        <label class="inline-flex items-center gap-1"><input asp-for="Formular.Teilnehmer[i].Atemschutz" type="checkbox" class="h-4 w-4" x-model="atemschutz" /> AGT</label>
                                        <input asp-for="Formular.Teilnehmer[i].AtemschutzMinuten" type="number" min="0" class="eingabe ml-2 inline-block max-w-20" placeholder="Min." x-show="atemschutz" />
                                        <span asp-validation-for="Formular.Teilnehmer[i].AtemschutzMinuten" class="feldfehler"></span>
                                    </td>
                                    <td>@if (Model.DarfAendern) { <button type="submit" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="teilnehmer" asp-route-index="@i" formnovalidate class="text-sm text-feuer-700 hover:underline">entfernen</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.DarfAendern && Model.MitgliederZumHinzufuegen.Count > 0)
            {
                <div class="mt-3 flex flex-wrap items-end gap-2">
                    <select name="neuMitgliedId" asp-items="Model.MitgliederZumHinzufuegen" class="eingabe max-w-xs" aria-label="Mitglied wählen"></select>
                    <button type="submit" asp-page-handler="Hinzufuegen" asp-route-id="@e.Id" asp-route-was="teilnehmer" formnovalidate class="knopf-zweit">Person hinzufügen</button>
                </div>
            }
        </section>

        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Andere Organisationen vor Ort</h2>
            @for (var i = 0; i < Model.Formular.Organisationen.Count; i++)
            {
                <div class="mb-3 grid gap-3 rounded-lg border border-gray-200 p-3 sm:grid-cols-6">
                    <input type="hidden" asp-for="Formular.Organisationen[i].Id" />
                    <div><label asp-for="Formular.Organisationen[i].Art" class="etikett"></label><select asp-for="Formular.Organisationen[i].Art" asp-items="BerichtModel.Organisationsarten" class="eingabe"></select></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Organisationen[i].Bezeichnung" class="etikett"></label><input asp-for="Formular.Organisationen[i].Bezeichnung" class="eingabe" placeholder="z. B. Polizeirevier, Rettungswache" /></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Organisationen[i].Ansprechpartner" class="etikett"></label><input asp-for="Formular.Organisationen[i].Ansprechpartner" class="eingabe" /></div>
                    <div><label asp-for="Formular.Organisationen[i].Telefon" class="etikett"></label><input asp-for="Formular.Organisationen[i].Telefon" class="eingabe" type="tel" /></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Organisationen[i].Aktenzeichen" class="etikett"></label><input asp-for="Formular.Organisationen[i].Aktenzeichen" class="eingabe" /></div>
                    <div class="sm:col-span-3"><label asp-for="Formular.Organisationen[i].Bemerkung" class="etikett"></label><input asp-for="Formular.Organisationen[i].Bemerkung" class="eingabe" /></div>
                    <div class="self-end pb-2">@if (Model.DarfAendern) { <button type="submit" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="organisation" asp-route-index="@i" formnovalidate class="text-sm text-feuer-700 hover:underline">entfernen</button> }</div>
                </div>
            }
            @if (Model.DarfAendern)
            {
                <button type="submit" asp-page-handler="Hinzufuegen" asp-route-id="@e.Id" asp-route-was="organisation" formnovalidate class="knopf-zweit">Organisation hinzufügen</button>
            }
            else if (Model.Formular.Organisationen.Count == 0)
            {
                <p class="text-sm text-gray-500">Keine erfasst.</p>
            }
        </section>

        <section class="karte">
            <h2 class="text-lg font-semibold">Geschädigte, Verursacher, Meldende, sonstige Beteiligte</h2>
            <p class="mb-2 text-sm text-gray-500">Nur erfassen, was für Kostenersatz, Rückfragen oder Versicherung nötig ist, keine Angaben zu Verletzungen oder Gesundheit. Gelöscht wird nach Ablauf der Frist im Löschkonzept (L3), bei offenem Kostenersatz erst nach dessen Abschluss.</p>
            @for (var i = 0; i < Model.Formular.Beteiligte.Count; i++)
            {
                <div class="mb-3 grid gap-3 rounded-lg border border-gray-200 p-3 sm:grid-cols-6">
                    <input type="hidden" asp-for="Formular.Beteiligte[i].Id" />
                    <div><label asp-for="Formular.Beteiligte[i].Rolle" class="etikett"></label><select asp-for="Formular.Beteiligte[i].Rolle" asp-items="BerichtModel.Beteiligtenrollen" class="eingabe"></select></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Beteiligte[i].Name" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Name" class="eingabe" /><span asp-validation-for="Formular.Beteiligte[i].Name" class="feldfehler"></span></div>
                    @if (Model.DarfBeteiligteDetails)
                    {
                    <div class="sm:col-span-2"><label asp-for="Formular.Beteiligte[i].Anschrift" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Anschrift" class="eingabe" /></div>
                    <div><label asp-for="Formular.Beteiligte[i].Telefon" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Telefon" class="eingabe" type="tel" /></div>
                    <div><label asp-for="Formular.Beteiligte[i].Kennzeichen" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Kennzeichen" class="eingabe" placeholder="GP-AB 123" /></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Beteiligte[i].Fahrzeugbeschreibung" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Fahrzeugbeschreibung" class="eingabe" placeholder="Marke, Typ, Farbe" /></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Beteiligte[i].Versicherung" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Versicherung" class="eingabe" /></div>
                    <div><label asp-for="Formular.Beteiligte[i].Versicherungsnummer" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Versicherungsnummer" class="eingabe" /></div>
                    <div class="sm:col-span-5"><label asp-for="Formular.Beteiligte[i].Bemerkung" class="etikett"></label><input asp-for="Formular.Beteiligte[i].Bemerkung" class="eingabe" placeholder="keine Angaben zu Verletzungen oder Gesundheit" /></div>
                    }
                    else
                    {
                    <div class="text-sm text-gray-500 sm:col-span-2 self-end pb-2">Anschrift, Kennzeichen und Versicherung sieht nur, wer das Recht dazu hat.</div>
                    }
                    <div class="self-end pb-2">@if (Model.DarfAendern) { <button type="submit" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="beteiligter" asp-route-index="@i" formnovalidate class="text-sm text-feuer-700 hover:underline">entfernen</button> }</div>
                </div>
            }
            @if (Model.DarfAendern)
            {
                <button type="submit" asp-page-handler="Hinzufuegen" asp-route-id="@e.Id" asp-route-was="beteiligter" formnovalidate class="knopf-zweit">Beteiligten hinzufügen</button>
            }
            else if (Model.Formular.Beteiligte.Count == 0)
            {
                <p class="text-sm text-gray-500">Keine erfasst.</p>
            }
        </section>

        <section class="karte">
            <h2 class="mb-2 text-lg font-semibold">Ausrüstung und Verbrauchsmaterial <span class="text-sm font-normal text-gray-500">(für den Kostenersatz)</span></h2>
            @if (Model.Formular.Ausruestung.Count > 0)
            {
                <div class="overflow-x-auto">
                    <table class="tabelle">
                        <thead><tr><th>Posten</th><th>Satz</th><th>Menge</th><th>Bemerkung</th><th></th></tr></thead>
                        <tbody>
                            @for (var i = 0; i < Model.Formular.Ausruestung.Count; i++)
                            {
                                var satz = Model.Kostensaetze[Model.Formular.Ausruestung[i].KostensatzId];
                                <tr>
                                    <td class="font-medium"><input type="hidden" asp-for="Formular.Ausruestung[i].Id" /><input type="hidden" asp-for="Formular.Ausruestung[i].KostensatzId" />@satz.Bezeichnung</td>
                                    <td class="whitespace-nowrap">@Anzeige.Euro(satz.Betrag) je @Anzeige.Text(satz.Einheit)</td>
                                    <td><input asp-for="Formular.Ausruestung[i].Menge" type="number" step="0.01" min="0" class="eingabe max-w-24" readonly="@(satz.Einheit == Kosteneinheit.Pauschale)" /><span asp-validation-for="Formular.Ausruestung[i].Menge" class="feldfehler"></span></td>
                                    <td><input asp-for="Formular.Ausruestung[i].Bemerkung" class="eingabe" /></td>
                                    <td>@if (Model.DarfAendern) { <button type="submit" asp-page-handler="Entfernen" asp-route-id="@e.Id" asp-route-was="ausruestung" asp-route-index="@i" formnovalidate class="text-sm text-feuer-700 hover:underline">entfernen</button> }</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (Model.DarfAendern)
            {
                @if (Model.Kostensatzauswahl.Count > 0)
                {
                    <div class="mt-3 flex flex-wrap items-end gap-2">
                        <select name="neuKostensatzId" asp-items="Model.Kostensatzauswahl" class="eingabe max-w-md" aria-label="Posten wählen"></select>
                        <button type="submit" asp-page-handler="Hinzufuegen" asp-route-id="@e.Id" asp-route-was="ausruestung" formnovalidate class="knopf-zweit">Posten hinzufügen</button>
                    </div>
                }
                else
                {
                    <p class="text-sm text-gray-500">Für Geräte und Verbrauchsmaterial sind noch keine Kostensätze hinterlegt (<a asp-page="Kostensaetze" class="text-feuer-700 hover:underline">Kostensätze</a>).</p>
                }
            }
        </section>

        <section class="karte">
            <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
                <h2 class="text-lg font-semibold">Kostenersatz <span class="text-sm font-normal text-gray-500">(gespeicherter Stand, angefangene @Model.RundungMinuten Minuten aufgerundet)</span></h2>
                <a asp-page="Kostensaetze" class="text-sm text-feuer-700 hover:underline">Kostensätze</a>
            </div>
            <div class="mb-3 flex flex-wrap items-end gap-4">
                <label class="flex items-center gap-2 pb-2 text-sm"><input asp-for="Formular.KostenersatzOffen" type="checkbox" class="h-4 w-4" /> Kostenersatz offen</label>
                <div><label asp-for="Formular.KostenersatzAbgeschlossenAm" class="etikett"></label><input asp-for="Formular.KostenersatzAbgeschlossenAm" type="date" class="eingabe" /></div>
            </div>
            @if (e.Rechtsgrundlage == Rechtsgrundlage.Para2Abs1)
            {
                <p class="mb-2 text-sm text-gray-500">Pflichtaufgabe nach § 2 Abs. 1 FwG: grundsätzlich unentgeltlich, Kostenersatz nur in den Fällen des § 34 FwG.</p>
            }
            @if (Model.Kosten is null)
            {
                <p class="text-sm text-gray-500">Noch keine Kostensätze hinterlegt.</p>
            }
            else
            {
                @if (Model.Kosten.Posten.Count > 0)
                {
                    <div class="overflow-x-auto">
                        <table class="tabelle">
                            <thead><tr><th>Art</th><th>Posten</th><th class="text-right">Menge</th><th class="text-right">Satz</th><th class="text-right">Betrag</th></tr></thead>
                            <tbody>
                                @foreach (var p in Model.Kosten.Posten)
                                {
                                    <tr><td>@Anzeige.Text(p.Art)</td><td>@p.Bezeichnung</td><td class="text-right whitespace-nowrap">@Anzeige.Zahl(p.Menge) @Anzeige.Text(p.Einheit)</td><td class="text-right whitespace-nowrap">@Anzeige.Euro(p.Satz)</td><td class="text-right whitespace-nowrap">@Anzeige.Euro(p.Betrag)</td></tr>
                                }
                                <tr class="font-semibold"><td colspan="4">Summe</td><td class="text-right whitespace-nowrap">@Anzeige.Euro(Model.Kosten.Summe)</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
                @foreach (var h in Model.Kosten.Hinweise)
                {
                    <p class="text-sm text-amber-700">@h</p>
                }
            }
        </section>

        @if (Model.Entschaedigungen.Count > 0)
        {
            <section class="karte">
                <h2 class="mb-2 text-lg font-semibold">Entschädigung der Einsatzkräfte <span class="text-sm font-normal text-gray-500">(Vorschau; ausgezahlt wird über die Abrechnung nach Freigabe)</span></h2>
                @if (Model.EntschaedigungOhneSatz)
                {
                    <p class="text-sm text-gray-500">Für Einsätze ist noch kein Entschädigungssatz hinterlegt.</p>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="tabelle">
                            <thead><tr><th>Name</th><th>Von</th><th>Bis</th><th class="text-right">Menge</th><th class="text-right">Betrag</th></tr></thead>
                            <tbody>
                                @foreach (var z in Model.Entschaedigungen)
                                {
                                    <tr><td>@z.Name</td><td>@Anzeige.Zeit(z.Von)</td><td>@Anzeige.Zeit(z.Bis)</td>
                                        <td class="text-right whitespace-nowrap">@(z.Betrag is null ? "–" : $"{Anzeige.Zahl(z.Betrag.Menge)} {Anzeige.Text(z.Betrag.Einheit)}")</td>
                                        <td class="text-right whitespace-nowrap">@(z.Betrag is null ? "keine Endzeit" : Anzeige.Euro(z.Betrag.Betrag))</td></tr>
                                }
                                <tr class="font-semibold"><td colspan="4">Summe</td><td class="text-right whitespace-nowrap">@Anzeige.Euro(Model.Entschaedigungen.Sum(z => z.Betrag?.Betrag ?? 0))</td></tr>
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

        @if (Model.DarfAendern)
        {
            <div class="flex flex-wrap gap-2">
                <button type="submit" class="knopf">Speichern</button>
                @if (Model.DarfFreigeben && e.Status != EinsatzStatus.Freigegeben)
                {
                    <button type="submit" asp-page-handler="Freigeben" class="knopf-zweit">Speichern und freigeben</button>
                }
                <a asp-page="Index" class="knopf-zweit">Abbrechen</a>
            </div>
        }
    </fieldset>
</form>
