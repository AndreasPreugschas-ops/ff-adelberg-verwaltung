@page
@using Fevad.Domain.Einsaetze
@model Fevad.Web.Pages.Einsaetze.IndexModel
@{
    ViewData["Title"] = "Einsätze";
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Einsätze</h1>
    <div class="flex flex-wrap gap-2">
        <a asp-page="Aao" class="knopf-zweit">AAO</a>
        <a asp-page="Objekte" class="knopf-zweit">Objektakten</a>
        <a asp-page="ExterneStellen" class="knopf-zweit">Externe Stellen</a>
        <a asp-page="Kostensaetze" class="knopf-zweit">Kostensätze</a>
        @if (Model.DarfBearbeiten)
        {
            <a asp-page="Massnahmen" class="knopf-zweit">Maßnahmen</a>
            <a asp-page="Neu" class="knopf">Neuer Einsatz</a>
        }
    </div>
</div>

@if (TempData["Meldung"] is string meldung)
{
    <div class="alert alert-success">@meldung</div>
}

@if (Model.UnverarbeiteteAlarme > 0)
{
    <div class="alert alert-warning flex flex-wrap items-center justify-between gap-2">
        <span>@Model.UnverarbeiteteAlarme Alarm(e) aus alamos FE2 warten auf einen Einsatzbericht.</span>
        @if (Model.DarfBearbeiten)
        {
            <form method="post" asp-page-handler="AlarmeUebernehmen"><button type="submit" class="knopf-zweit">Jetzt übernehmen</button></form>
        }
    </div>
}

@if (Model.Jahre.Count > 1)
{
    <nav class="mb-3 flex flex-wrap gap-1 text-sm" aria-label="Einsatzjahr">
        @foreach (var jahr in Model.Jahre)
        {
            <a asp-page="Index" asp-route-jahr="@jahr" class="@(jahr == Model.Jahr ? "knopf" : "knopf-zweit")">@jahr</a>
        }
    </nav>
}

<div class="karte overflow-x-auto p-0">
    @if (Model.Zeilen.Count == 0)
    {
        <p class="p-4 text-sm text-gray-500">Keine Einsätze im Jahr @Model.Jahr. Berichte entstehen automatisch, sobald alamos FE2 einen Alarm meldet.</p>
    }
    else
    {
        <table class="tabelle">
            <thead><tr><th>Nr.</th><th>Alarmiert</th><th>Stichwort</th><th>Ort</th><th>Kategorie</th><th>Status</th><th>Teilnehmer</th></tr></thead>
            <tbody>
                @foreach (var e in Model.Zeilen)
                {
                    var farbe = e.Status switch
                    {
                        EinsatzStatus.Freigegeben => "ampel-gruen",
                        EinsatzStatus.InBearbeitung or EinsatzStatus.Vorgelegt => "ampel-gelb",
                        _ => "ampel-rot",
                    };
                    <tr>
                        <td><a asp-page="Bericht" asp-route-id="@e.Id" class="font-medium text-feuer-700 hover:underline">@e.Einsatznummer</a></td>
                        <td>@Anzeige.DatumZeit(e.Alarmiert)</td>
                        <td>@(e.Stichwort ?? "–")</td>
                        <td>@(e.Ort ?? "–")</td>
                        <td>@(e.Kategorie ?? "–")</td>
                        <td><span class="@farbe">@Anzeige.Text(e.Status)</span></td>
                        <td>@e.Teilnehmer</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
