@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Options
@inject IAuthorizationService Autorisierung
@inject Fevad.Web.Infrastruktur.Hauptmenue Hauptmenue
@inject IOptions<BetriebOptionen> Betrieb
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Fevad.Infrastructure.Benachrichtigungen.Benachrichtigungsdienst Benachrichtigungen
@inject Fevad.Infrastructure.Persistenz.IAktuellerBenutzer AktuellesKonto
@{
    var token = Antiforgery.GetAndStoreTokens(Context).RequestToken;
    var angemeldet = User.Identity?.IsAuthenticated == true;

    // Hauptmenü, nach Bereichen gruppiert; leere Bereiche fehlen.
    var menue = await Hauptmenue.LadenAsync(User);

    // Glocke: ungelesene Benachrichtigungen des Kontos (V72).
    var ungelesen = angemeldet && AktuellesKonto.Id is { } kontoId ? await Benachrichtigungen.UngeleseneAsync(kontoId) : 0;

    // Navigationsbereich wie in Outlook: der Eintrag, dessen Ordner am längsten zum aufgerufenen Pfad passt, ist markiert;
    // sein Bereich ist aufgeklappt.
    var pfad = Context.Request.Path.Value?.TrimEnd('/') ?? "";
    static string Ordner(string seite) => seite.EndsWith("/Index", StringComparison.Ordinal) ? seite[..^"/Index".Length] : seite;
    var aktiv = menue.SelectMany(b => b.Eintraege)
        .Select(e => (e.Seite, Ordner: Ordner(e.Seite)))
        .Where(e => pfad.Equals(e.Ordner, StringComparison.OrdinalIgnoreCase) || pfad.StartsWith(e.Ordner + "/", StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(e => e.Ordner.Length)
        .Select(e => e.Seite)
        .FirstOrDefault();
    var startseite = pfad.Length == 0 || pfad.Equals("/Index", StringComparison.OrdinalIgnoreCase);

    // Kontobild wie in Microsoft 365: Anfangsbuchstaben im Kreis.
    var name = User.Identity?.Name ?? "";
    var teile = name.Split('@')[0].Split(['.', '-', '_', ' '], StringSplitOptions.RemoveEmptyEntries);
    var kuerzel = (teile.Length switch { 0 => "?", 1 => teile[0][..Math.Min(2, teile[0].Length)], _ => $"{teile[0][0]}{teile[^1][0]}" }).ToUpperInvariant();
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#af2b1e" />
    @if (ViewData["Robots"] is string robots)
    {
        <meta name="robots" content="@robots" />
    }
    <title>@ViewData["Title"] · @Programmversion.Name</title>
    @* Farbschema vor dem ersten Zeichnen setzen, damit die Seite nicht hell aufblitzt (V66). *@
    <script>try { var f = localStorage.getItem("fevad-farbschema"); if (f === "hell" || f === "dunkel") document.documentElement.dataset.farbschema = f; } catch (e) { }</script>
    <link rel="stylesheet" href="~/css/app.css" asp-append-version="true" />
    <script src="~/lib/htmx/htmx.min.js" asp-append-version="true"></script>
    <script src="~/js/fevad.js" asp-append-version="true"></script>
    <script defer src="~/lib/alpinejs/alpine.min.js" asp-append-version="true"></script>
</head>
<body class="min-h-screen bg-gray-100 text-gray-900" hx-headers='{"RequestVerificationToken": "@token"}'
      x-data="fevadRahmen" x-on:keydown.escape.window="schliessen()">
    <a href="#inhalt" class="sprunglink">Zum Inhalt springen</a>
    <div id="fevad-ansage" class="sr-only" aria-live="polite"></div>
    @if (TempData[DialogEingabeFilter.Entwurf] is string entwurf)
    {
        @* Abgewiesene Dialogeingabe: fevad.js öffnet den Dialog wieder mit diesen Werten und den Fehlern am Feld (BF-01). *@
        @* JsonSerializer maskiert <, > und & standardmäßig, der Inhalt kann das Skript-Element nicht verlassen. *@
        <script type="application/json" id="fevad-dialog-entwurf">@Html.Raw(entwurf)</script>
    }
    <datalist id="fevad-uhrzeiten">
        @for (var viertel = 0; viertel < 96; viertel++)
        {
            <option value="@($"{viertel / 4:00}:{viertel % 4 * 15:00}")"></option>
        }
    </datalist>
    <header class="kopfleiste print:hidden">
        @if (angemeldet)
        {
            <button type="button" class="kopf-knopf" id="navigation-knopf" x-on:click="umschalten()" x-bind:aria-expanded="offen().toString()"
                    aria-controls="navigationsbereich" title="Navigationsbereich ein- oder ausblenden">
                @Symbole.Svg("menue")
                <span class="sr-only">Navigation</span>
            </button>
            <a href="/" class="kopf-knopf hidden sm:inline-flex" title="Alle Bereiche">
                @Symbole.Svg("raster")
                <span class="sr-only">Alle Bereiche</span>
            </a>
        }
        <a asp-page="/Index" class="kopf-knopf shrink-0 px-2" title="Feuerwehr-Verwaltung Adelberg">
            @Symbole.Svg("flamme", "h-6 w-6")
            <span class="text-base font-semibold tracking-wide">@Programmversion.Name</span>
            <span class="hidden border-l border-white/40 pl-2 text-sm font-normal md:inline">Freiwillige Feuerwehr Adelberg</span>
        </a>
        @if (angemeldet)
        {
            <form method="get" action="/Suche" role="search" class="mx-auto flex min-w-0 max-w-xl flex-1 items-center px-1">
                <label for="kopfsuche" class="kopf-suche">
                    @Symbole.Svg("suche", "h-4 w-4")
                    <span class="sr-only">In FEVAD suchen</span>
                    <input id="kopfsuche" name="q" type="search" placeholder="Suchen" minlength="2" autocomplete="off" />
                </label>
            </form>
            <a href="/Benachrichtigungen" class="kopf-knopf"
               aria-label="@(ungelesen == 0 ? "Benachrichtigungen, keine neuen" : $"Benachrichtigungen, {ungelesen} neue")" title="Benachrichtigungen">
                @Symbole.Svg("glocke")
                @if (ungelesen > 0)
                {
                    <span class="absolute right-0.5 top-1 min-w-4 rounded-full bg-[#fff] px-1 text-center text-[0.6875rem] font-bold leading-4 text-[#8f2318]">@(ungelesen > 99 ? "99+" : ungelesen.ToString())</span>
                }
            </a>
            <div class="relative" x-data="{ auf: false }" x-on:click.outside="auf = false" x-on:keydown.escape="if (auf) { auf = false; $refs.knopf.focus() }">
                <button type="button" class="kopf-knopf" x-ref="knopf" x-on:click="auf = !auf" x-bind:aria-expanded="auf" aria-haspopup="true" title="Konto: @name">
                    <span aria-hidden="true" class="flex h-8 w-8 items-center justify-center rounded-full bg-[#fff] text-xs font-semibold text-[#8f2318]">@kuerzel</span>
                    <span class="sr-only">Konto @name</span>
                </button>
                <div x-cloak x-show="auf" x-transition.opacity class="menue">
                    <div class="flex items-center gap-3 border-b border-gray-200 px-4 py-3">
                        <span aria-hidden="true" class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-feuer-600 text-sm font-semibold text-white">@kuerzel</span>
                        <span class="min-w-0 break-words font-semibold">@name</span>
                    </div>
                    <ul class="py-1">
                        <li><a asp-page="/Konto/Index" class="menue-eintrag">@Symbole.Svg("konto", "h-4 w-4") Mein Konto</a></li>
                        <li>
                            <form method="post" asp-page="/Konto/Abmelden">
                                <button type="submit" class="menue-eintrag">@Symbole.Svg("abmelden", "h-4 w-4") Abmelden</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        }
    </header>
    @if (Betrieb.Value.Notbetrieb)
    {
        <div class="bg-yellow-300 px-4 py-2 text-center text-sm font-semibold text-yellow-900">
            Notbetrieb: Daten werden später in die Cloud übertragen.
        </div>
    }
    <div class="flex">
        @if (angemeldet)
        {
            <div x-cloak x-show="nav" x-transition.opacity class="fixed inset-0 top-12 z-20 bg-black/30 lg:hidden" x-on:click="schliessen()"></div>
            <nav id="navigationsbereich" class="navigationsbereich -translate-x-full lg:translate-x-0 print:hidden" aria-label="Hauptmenü"
                 x-bind:class="{ '-translate-x-full': !nav, 'lg:translate-x-0': !schmal, 'lg:hidden': schmal }" x-bind:inert="!offen()">
                <a href="/" class="nav-eintrag" aria-current="@(startseite ? "page" : null)">@Symbole.Svg("start") Start</a>
                @foreach (var bereich in menue)
                {
                    var offen = bereich.Eintraege.Any(e => e.Seite == aktiv);
                    var listeId = "nav-" + bereich.Titel.ToLowerInvariant().Replace("ü", "ue");
                    <div x-data="{ auf: @(offen || menue.Count == 1 ? "true" : "false") }">
                        <button type="button" class="nav-gruppe" x-on:click="auf = !auf" x-bind:aria-expanded="auf" aria-controls="@listeId">
                            @Symbole.Bereich(bereich.Titel)
                            <span class="flex-1">@bereich.Titel</span>
                            <span class="transition-transform" x-bind:class="auf ? '' : '-rotate-90'">@Symbole.Svg("pfeil-unten", "h-4 w-4")</span>
                        </button>
                        <ul id="@listeId" x-show="auf">
                            @foreach (var e in bereich.Eintraege)
                            {
                                <li><a asp-page="@e.Seite" class="nav-eintrag nav-unter" aria-current="@(e.Seite == aktiv ? "page" : null)">@e.Titel</a></li>
                            }
                        </ul>
                    </div>
                }
            </nav>
        }
        <div class="flex min-h-[calc(100vh-3rem)] min-w-0 flex-1 flex-col">
            <main id="inhalt" tabindex="-1" class="arbeitsbereich flex-1 focus:outline-none">
                @if (TempData["Meldung"] is string meldung)
                {
                    <div class="meldung meldung-erfolg" role="status">@Symbole.Svg("haken", "mt-px h-4 w-4 text-green-700") <span>@meldung</span></div>
                }
                @if (TempData["Fehler"] is string fehler)
                {
                    <div class="meldung meldung-fehler" role="alert">@Symbole.Svg("warnung", "mt-px h-4 w-4 text-red-700") <span>@fehler</span></div>
                }
                @RenderBody()
            </main>
            <footer class="arbeitsbereich border-t border-gray-200 py-4 text-xs text-gray-500 print:hidden">
                <span title="Version">@Programmversion.Anzeige</span> · Freiwillige Feuerwehr Adelberg · Verwaltung und Dokumentation · keine Alarmierung
                · <a href="/Barrierefreiheit" class="underline hover:text-feuer-700">Barrierefreiheit</a>
                · <label for="fevad-farbschema">Farbschema</label>
                <select id="fevad-farbschema" class="rounded border border-gray-300 bg-white px-1 py-0.5 text-xs text-gray-700" data-farbschema-wahl>
                    <option value="">wie Gerät</option>
                    <option value="hell">hell</option>
                    <option value="dunkel">dunkel</option>
                </select>
            </footer>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
