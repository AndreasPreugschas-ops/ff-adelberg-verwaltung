@page "{id:guid}"
@using Fevad.Domain.Dienstbetrieb
@model Fevad.Web.Pages.Termine.TerminModel
@{
    var d = Model.Karte.Dienst;
    ViewData["Title"] = d.Titel;
}
<div class="mb-2 flex flex-wrap gap-x-4 text-sm">
    <a asp-page="Index" class="text-feuer-700 hover:underline">← Meine Termine</a>
    <a asp-page="Kalender" asp-route-monat="@Anzeige.Lokal(d.Beginn).ToString("yyyy-MM")" class="text-feuer-700 hover:underline">Kalender</a>
</div>

<partial name="_TerminKarte" model="Model.Karte" />

@if (!Model.HatMitglied)
{
    <p class="mt-3 text-sm text-gray-500">Dein Konto ist mit keinem Mitglied verknüpft, deshalb kannst du hier nicht zu- oder absagen.</p>
}
else if (!Model.Karte.Betroffen)
{
    <p class="mt-3 text-sm text-gray-500">Du gehörst nicht zur Zielgruppe dieses Termins.</p>
}

<div class="mt-4 flex flex-wrap gap-2">
    @if (Model.Karte.Betroffen && Model.HatMitglied && d.Beginn <= DateTimeOffset.UtcNow.AddHours(1) && d.Status != DienstStatus.Abgesagt)
    {
        <a asp-page="/Konto/Unfall" asp-route-dienstId="@d.Id" class="knopf-zweit">Unfall melden</a>
        <a asp-page="/Konto/Sachschaden" asp-route-dienstId="@d.Id" class="knopf-zweit">Sachschaden melden</a>
    }
    @if (Model.DarfBearbeiten)
    {
        <a asp-page="/Dienste/Bearbeiten" asp-route-id="@d.Id" class="knopf-zweit">Bearbeiten</a>
    }
    @if (Model.DarfMeldungenBearbeiten)
    {
        <a asp-page="/Dienste/Meldungen" asp-route-id="@d.Id" class="knopf-zweit">Meldungen bearbeiten</a>
    }
    @if (Model.DarfRueckmeldungenSehen && d.AlsDienst)
    {
        <a asp-page="/Dienste/Anwesenheit" asp-route-id="@d.Id" class="knopf-zweit">Anwesenheit</a>
    }
    @if (Model.DarfBearbeiten && Model.Jugendveranstaltung is not null)
    {
        <a asp-page="/Jugend/Veranstaltung" asp-route-id="@d.Id" class="knopf-zweit">Anmeldungen, Betreuer, Zuschuss</a>
    }
</div>

@if (Model.Elterntext is { } elterntext)
{
    <section class="karte mt-6 max-w-3xl" x-data="{ kopiert: false }">
        <h2 class="mb-2 text-lg font-semibold">Text für die Eltern-Gruppe</h2>
        <p class="mb-2 text-sm text-gray-500">Zum Kopieren in WhatsApp; ohne Namen der Kinder. Die Eltern melden sich über den Link an.</p>
        <textarea x-ref="text" rows="6" readonly class="eingabe font-mono text-sm">@elterntext</textarea>
        <button type="button" class="knopf-zweit mt-2" x-on:click="navigator.clipboard.writeText($refs.text.value); kopiert = true">Kopieren</button>
        <span x-show="kopiert" x-cloak class="ml-2 text-sm text-gray-500">kopiert</span>
    </section>
}

@if (Model.Jugendveranstaltung is { AnmeldungNoetig: true } jv && Model.Kinder.Count > 0)
{
    <section class="karte mt-6 max-w-3xl">
        <h2 class="mb-2 text-lg font-semibold">Anmeldung</h2>
        @if (jv.Teilnehmerbeitrag is { } beitrag)
        {
            <p class="mb-2 text-sm text-gray-700">Teilnehmerbeitrag: @Anzeige.Euro(beitrag)</p>
        }
        @if (!string.IsNullOrWhiteSpace(jv.Bemerkung))
        {
            <p class="mb-2 whitespace-pre-line text-sm text-gray-700">@jv.Bemerkung</p>
        }
        <p class="mb-3 text-sm text-gray-500">@(Model.AnmeldungOffen ? jv.AnmeldungBis is { } bis ? $"Anmeldung bis {Anzeige.Datum(bis)}." : "Anmeldung bis zum Vortag." : "Die Anmeldung ist geschlossen; Änderungen bitte beim Jugendwart.")</p>
        @foreach (var k in Model.Kinder)
        {
            <div class="mb-3 border-t border-gray-100 pt-3">
                @if (k.Anmeldung is { } a)
                {
                    <p class="text-sm"><span class="font-semibold">@k.Vorname</span> ist angemeldet (@Anzeige.Datum(a.AngemeldetAm))@(jv.EinwilligungNoetig && !a.Einwilligung ? ", die Einwilligung fehlt noch" : "").</p>
                    @if (Model.AnmeldungOffen)
                    {
                        <form method="post" asp-page-handler="Abmelden" asp-route-id="@d.Id" class="mt-1">
                            <input type="hidden" name="mitgliedId" value="@k.MitgliedId" />
                            <button type="submit" class="text-sm text-feuer-700 hover:underline">@k.Vorname abmelden</button>
                        </form>
                    }
                }
                else if (Model.AnmeldungOffen)
                {
                    <form method="post" asp-page-handler="Anmelden" asp-route-id="@d.Id" class="flex flex-col gap-2">
                        <input type="hidden" name="mitgliedId" value="@k.MitgliedId" />
                        @if (jv.EinwilligungNoetig)
                        {
                            <label class="flex items-start gap-2 text-sm"><input type="checkbox" name="einwilligung" value="true" class="mt-0.5 h-4 w-4" required />
                                <span>Als Erziehungsberechtigte willige ich ein, dass @k.Vorname an „@d.Titel“ (@Anzeige.Zeitraum(Fevad.Infrastructure.Dienstbetrieb.Jugendveranstaltungen.ErsterTag(d), Fevad.Infrastructure.Dienstbetrieb.Jugendveranstaltungen.LetzterTag(d)))@(jv.Uebernachtung ? " mit Übernachtung" : "") teilnimmt und den Anweisungen der Betreuer folgt.</span></label>
                        }
                        <div><button type="submit" class="knopf">@k.Vorname anmelden</button></div>
                    </form>
                }
                else
                {
                    <p class="text-sm text-gray-500">@k.Vorname ist nicht angemeldet.</p>
                }
            </div>
        }
    </section>
}

@if (d.RueckmeldungErbeten)
{
    <section class="mt-6">
        <h2 class="mb-2 text-lg font-semibold">Rückmeldungen</h2>
        <p class="mb-3 text-sm text-gray-600">
            <span class="ampel-gruen">@Model.Zusagen zugesagt</span>
            <span class="inline-block rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">@Model.Absagen abgesagt</span>
            @if (Model.DarfRueckmeldungenSehen)
            {
                <span class="ampel-gelb">@Model.Meldungen.Count(m => m.Antwort is null) offen</span>
            }
        </p>
        @if (Model.DarfRueckmeldungenSehen)
        {
            <partial name="_Rueckmeldungen" model="Model.Meldungen" />
        }
    </section>
}
