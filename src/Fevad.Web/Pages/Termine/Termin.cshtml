@page "{id:guid}"
@using Fevad.Domain.Dienstbetrieb
@model Fevad.Web.Pages.Termine.TerminModel
@{
    var d = Model.Karte.Dienst;
    ViewData["Title"] = d.Titel;
}
<div class="mb-2 flex flex-wrap gap-x-4 text-sm">
    <a asp-page="Index" class="text-feuer-700 hover:underline">← Meine Termine</a>
    <a asp-page="Kalender" asp-route-monat="@Anzeige.Lokal(d.Beginn).ToString("yyyy-MM")" class="text-feuer-700 hover:underline">Kalender</a>
</div>

<partial name="_TerminKarte" model="Model.Karte" />

@if (!Model.HatMitglied)
{
    <p class="mt-3 text-sm text-gray-500">Dein Konto ist mit keinem Mitglied verknüpft, deshalb kannst du hier nicht zu- oder absagen.</p>
}
else if (!Model.Karte.Betroffen)
{
    <p class="mt-3 text-sm text-gray-500">Du gehörst nicht zur Zielgruppe dieses Termins.</p>
}

<div class="mt-4 flex flex-wrap gap-2">
    @if (Model.DarfBearbeiten)
    {
        <a asp-page="/Dienste/Bearbeiten" asp-route-id="@d.Id" class="knopf-zweit">Bearbeiten</a>
    }
    @if (Model.DarfRueckmeldungenSehen)
    {
        <a asp-page="/Dienste/Anwesenheit" asp-route-id="@d.Id" class="knopf-zweit">Anwesenheit</a>
    }
</div>

@if (d.RueckmeldungErbeten)
{
    <section class="mt-6">
        <h2 class="mb-2 text-lg font-semibold">Rückmeldungen</h2>
        <p class="mb-3 text-sm text-gray-600">
            <span class="ampel-gruen">@Model.Zusagen zugesagt</span>
            <span class="inline-block rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">@Model.Absagen abgesagt</span>
            @if (Model.DarfRueckmeldungenSehen)
            {
                <span class="ampel-gelb">@Model.Offen.Count offen</span>
            }
        </p>
        @if (Model.DarfRueckmeldungenSehen)
        {
            <div class="grid gap-4 md:grid-cols-3">
                <div class="karte">
                    <h3 class="mb-2 font-semibold text-green-800">Zugesagt</h3>
                    <ul class="space-y-1 text-sm">
                        @foreach (var p in Model.Zugesagt)
                        {
                            <li>@p.Name <span class="text-xs text-gray-500">@p.Abteilung</span></li>
                        }
                    </ul>
                </div>
                <div class="karte">
                    <h3 class="mb-2 font-semibold text-gray-700">Abgesagt</h3>
                    <ul class="space-y-1 text-sm">
                        @foreach (var p in Model.Abgesagt)
                        {
                            <li>
                                @p.Name <span class="text-xs text-gray-500">@p.Abteilung</span>
                                @if (p.Begruendung is not null)
                                {
                                    <div class="text-xs text-gray-600">@p.Begruendung</div>
                                }
                            </li>
                        }
                    </ul>
                </div>
                <div class="karte">
                    <h3 class="mb-2 font-semibold text-yellow-800">Noch offen</h3>
                    <ul class="space-y-1 text-sm">
                        @foreach (var p in Model.Offen)
                        {
                            <li>@p.Name <span class="text-xs text-gray-500">@p.Abteilung</span></li>
                        }
                    </ul>
                </div>
            </div>
        }
    </section>
}
