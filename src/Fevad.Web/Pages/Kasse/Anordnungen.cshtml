@page
@using Fevad.Domain.Kassen
@model Fevad.Web.Pages.Kasse.AnordnungenModel
@{
    ViewData["Title"] = $"Vorbereitete Ausgaben: {Model.Kasse.Name}";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Kassen</a>
<h1 class="mb-2 mt-2 text-2xl font-bold">Vorbereitete Ausgaben: @Model.Kasse.Name</h1>
<p class="mb-4 max-w-3xl text-sm text-gray-600">
    Hier wird festgehalten, was zu zahlen ist, mit Beleg. Der Kassenwart zahlt und bucht allein; eine Anordnung durch Kommandant oder
    Stellvertreter lässt sich vermerken, ist aber nicht nötig.
</p>

<h2 class="mb-2 text-lg font-semibold">Offen</h2>
@if (Model.Offen.Count == 0)
{
    <p class="mb-4 text-sm text-gray-500">Keine.</p>
}
<div class="mb-6 grid gap-3">
    @foreach (var a in Model.Offen)
    {
        <div class="karte grid gap-2 text-sm sm:grid-cols-[1fr_auto]">
            <div>
                <p class="font-semibold">
                    @if (a.Art == AnordnungArt.Auslagenerstattung) { <span class="ampel-gelb">Auslagenerstattung</span> }
                    @Anzeige.Euro(a.Betrag) – @a.Zweck
                </p>
                <p class="text-gray-600">
                    @(Model.PartnerSichtbar ? a.Empfaenger : "Empfänger nur mit Zugang zur Jugendfeuerwehr")
                    @if (a.Planposition is { } p) { <span>· Position @p.Nummer @p.Bezeichnung</span> }
                    @if (a.FaelligAm is { } f) { <span>· zahlen bis @Anzeige.Datum(f)</span> }
                    · vorbereitet @Anzeige.DatumZeit(a.ErstelltAm)
                </p>
                @if (a.AngeordnetAm is { } am) { <p><span class="ampel-gruen">angeordnet</span> @Anzeige.DatumZeit(am)</p> }
                @if (a.Ausschussbeschluss is { } b) { <p>Beschluss @b.Kennung</p> }
                else if (Model.Beschlussgrenze > 0 && a.Betrag > Model.Beschlussgrenze) { <p><span class="ampel-gelb">über @Anzeige.Euro(Model.Beschlussgrenze)</span> Ausschussbeschluss nötig</p> }
                @foreach (var beleg in a.Belege)
                {
                    <a asp-page-handler="Beleg" asp-route-kasse="@Model.Kasse.Id" asp-route-belegId="@beleg.Id" target="_blank" class="mr-2 text-feuer-700 hover:underline">@beleg.Dateiname</a>
                }
            </div>
            <div class="flex flex-wrap items-start gap-2">
                @if (Model.DarfBuchen)
                {
                    <a asp-page="Buchung" asp-route-anordnung="@a.Id" class="knopf">Zahlen und buchen</a>
                }
                @if (Model.DarfAnordnen && a.AngeordnetAm is null)
                {
                    <form method="post" asp-page-handler="Anordnen" asp-route-kasse="@Model.Kasse.Id" asp-route-id="@a.Id"><button type="submit" class="knopf-zweit">Anordnung vermerken</button></form>
                }
                @if (Model.DarfBuchen)
                {
                    <form method="post" asp-page-handler="Ablehnen" asp-route-kasse="@Model.Kasse.Id" asp-route-id="@a.Id" class="flex gap-2">
                        <input name="Grund" class="eingabe w-40" placeholder="Grund" aria-label="Grund der Ablehnung" />
                        <button type="submit" class="knopf-zweit">Ablehnen</button>
                    </form>
                }
            </div>
        </div>
    }
</div>

@if (Model.DarfVorbereiten)
{
    <form method="post" enctype="multipart/form-data" asp-route-kasse="@Model.Kasse.Id" class="karte mb-6 grid max-w-3xl gap-4 sm:grid-cols-2">
        <h2 class="text-lg font-semibold sm:col-span-2">Neue Ausgabe vorbereiten</h2>
        <div asp-validation-summary="ModelOnly" class="feldfehler sm:col-span-2"></div>
        <div><label asp-for="Formular.Betrag" class="etikett"></label><input asp-for="Formular.Betrag" type="text" inputmode="decimal" class="eingabe" /><span asp-validation-for="Formular.Betrag" class="feldfehler"></span></div>
        <div><label asp-for="Formular.Empfaenger" class="etikett"></label><input asp-for="Formular.Empfaenger" class="eingabe" /><span asp-validation-for="Formular.Empfaenger" class="feldfehler"></span></div>
        <div class="sm:col-span-2"><label asp-for="Formular.Zweck" class="etikett"></label><input asp-for="Formular.Zweck" class="eingabe" /><span asp-validation-for="Formular.Zweck" class="feldfehler"></span></div>
        <div><label asp-for="Formular.PlanpositionId" class="etikett"></label><select asp-for="Formular.PlanpositionId" asp-items="Model.Positionen" class="eingabe"><option value="">bitte wählen</option></select><span asp-validation-for="Formular.PlanpositionId" class="feldfehler"></span></div>
        <div><label asp-for="Formular.FaelligAm" class="etikett"></label><input asp-for="Formular.FaelligAm" type="date" class="eingabe" /></div>
        <div class="sm:col-span-2">
            <label asp-for="Formular.AusschussbeschlussId" class="etikett"></label>
            <select asp-for="Formular.AusschussbeschlussId" asp-items="Model.Beschluesse" class="eingabe"><option value="">keiner</option></select>
            <p class="mt-1 text-xs text-gray-500">Ausgaben über @Anzeige.Euro(Model.Beschlussgrenze) beschließt der Feuerwehrausschuss.</p>
        </div>
        <div class="sm:col-span-2">
            <label for="dateien" class="etikett">Belege (PDF, JPG oder PNG)</label>
            <input id="dateien" name="Dateien" type="file" accept="application/pdf,image/jpeg,image/png" multiple class="eingabe" />
            <span asp-validation-for="Dateien" class="feldfehler"></span>
        </div>
        <div class="sm:col-span-2"><button type="submit" class="knopf">Vorbereiten</button></div>
    </form>
}

@if (Model.Erledigt.Count > 0)
{
    <h2 class="mb-2 text-lg font-semibold">Erledigt</h2>
    <div class="karte overflow-x-auto p-0">
        <table class="tabelle">
            <thead><tr><th>Vorbereitet</th><th>Zweck</th><th class="text-right">Betrag</th><th>Stand</th></tr></thead>
            <tbody>
                @foreach (var a in Model.Erledigt)
                {
                    <tr>
                        <td class="whitespace-nowrap">@Anzeige.Datum(Anzeige.LokalesDatum(a.ErstelltAm))</td>
                        <td>@a.Zweck@(a.Bemerkung is null ? "" : $" ({a.Bemerkung})")</td>
                        <td class="text-right">@Anzeige.Euro(a.Betrag)</td>
                        <td>
                            @if (a.BuchungId is { } bid) { <a asp-page="Buchung" asp-route-id="@bid" class="text-feuer-700 hover:underline">@Anzeige.Text(a.Status)</a> }
                            else { @Anzeige.Text(a.Status) }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
