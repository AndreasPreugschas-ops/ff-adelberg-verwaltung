@page
@using Fevad.Domain.Kassen
@model Fevad.Web.Pages.Kasse.KontoauszugModel
@{
    ViewData["Title"] = $"Kontoauszug abgleichen: {Model.Kasse.Name}";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Kassen</a>
<h1 class="mb-2 mt-2 text-2xl font-bold">Kontoauszug abgleichen: @Model.Kasse.Name</h1>
<p class="mb-4 max-w-3xl text-sm text-gray-600">
    Den Kontoauszug aus dem Onlinebanking als camt.053 (XML oder ZIP) oder als CSV hochladen. Schon eingelesene Umsätze werden übersprungen.
    Jeder Umsatz wird einer Buchung zugeordnet oder neu gebucht; FEVAD schlägt passende Belege, vorbereitete Ausgaben und wiederkehrende
    Buchungen vor. Gespeichert werden Tag, Betrag, Name und Verwendungszweck, keine IBAN der Gegenpartei.
</p>

<div class="grid max-w-5xl gap-6">
    @if (Model.DarfBuchen)
    {
    <form method="post" enctype="multipart/form-data" asp-route-kasse="@Model.Kasse.Id" class="karte grid gap-4 sm:grid-cols-3">
        <h2 class="text-lg font-semibold sm:col-span-3">Datei einlesen</h2>
        <div asp-validation-summary="ModelOnly" class="feldfehler sm:col-span-3"></div>
        <div>
            <label for="KontoId" class="etikett">Konto</label>
            <select id="KontoId" name="KontoId" asp-items="Model.Konten" class="eingabe"></select>
            <span asp-validation-for="KontoId" class="feldfehler"></span>
        </div>
        <div>
            <label for="BankformatId" class="etikett">Format bei CSV</label>
            <select id="BankformatId" name="BankformatId" asp-items="Model.Formate" class="eingabe"><option value="">–</option></select>
            <a asp-page="Bankformate" class="text-xs text-feuer-700 hover:underline">Formate in den Stammdaten</a>
        </div>
        <div>
            <label for="datei" class="etikett">Datei (.xml, .zip oder .csv)</label>
            <input id="datei" name="Datei" type="file" accept=".xml,.zip,.csv,.txt" class="eingabe" />
            <span asp-validation-for="Datei" class="feldfehler"></span>
        </div>
        <div class="sm:col-span-3"><button type="submit" class="knopf">Einlesen</button></div>
    </form>
    }

    @if (Model.Salden.Count > 0)
    {
        <section class="karte grid gap-2">
            <h2 class="text-lg font-semibold">Saldenabgleich</h2>
            <table class="tabelle">
                <thead><tr><th>Konto</th><th>Stand am</th><th class="text-right">laut Bank</th><th class="text-right">laut Kassenbuch</th><th class="text-right">Differenz</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.Salden)
                    {
                        <tr>
                            <td>@s.Konto.Bezeichnung</td>
                            <td>@Anzeige.Datum(s.Tag)</td>
                            <td class="text-right">@Anzeige.Euro(s.Bank)</td>
                            <td class="text-right">@Anzeige.Euro(s.Kassenbuch)</td>
                            <td class="text-right"><span class="@(s.Differenz == 0 ? "ampel-gruen" : "ampel-rot")">@Anzeige.Euro(s.Differenz)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
            <p class="text-sm text-gray-600">Eine Differenz heißt: Umsätze sind noch nicht gebucht oder im Kassenbuch steht etwas, das die Bank nicht kennt.</p>
        </section>
    }

    <section>
        <h2 class="mb-2 text-lg font-semibold">Offene Umsätze (@Model.Offen.Count)</h2>
        @if (Model.Offen.Count == 0)
        {
            <p class="text-sm text-gray-500">Alles abgeglichen.</p>
        }
        <div class="grid gap-3">
            @foreach (var u in Model.Offen)
            {
                var v = Model.Vorschlaege.GetValueOrDefault(u.Id);
                <div class="karte grid gap-2 text-sm sm:grid-cols-[1fr_auto]">
                    <div>
                        <p class="font-semibold"><span class="@(u.Betrag < 0 ? "text-red-800" : "text-green-800")">@Anzeige.Euro(u.Betrag)</span> · @Anzeige.Datum(u.Buchungstag) · @u.Konto?.Bezeichnung</p>
                        @if (Model.PartnerSichtbar)
                        {
                            <p>@u.Gegenpartei</p>
                            <p class="text-gray-600">@u.Verwendungszweck</p>
                            @if (v is not null) { <p class="mt-1"><span class="ampel-gelb">Vorschlag</span> @v.Text</p> }
                        }
                        else
                        {
                            <p class="text-gray-500">Gegenpartei und Verwendungszweck nur mit Zugang zur Jugendfeuerwehr</p>
                        }
                    </div>
                    @if (Model.DarfBuchen)
                    {
                    <div class="flex flex-wrap items-start gap-2">
                        @switch (v?.Art)
                        {
                            case VorschlagArt.Buchung:
                                <form method="post" asp-page-handler="Zuordnen" asp-route-kasse="@Model.Kasse.Id" asp-route-id="@u.Id" asp-route-buchungId="@v.Id"><button type="submit" class="knopf">Zuordnen</button></form>
                                break;
                            case VorschlagArt.Anordnung:
                                <a asp-page="Buchung" asp-route-anordnung="@v.Id" asp-route-umsatz="@u.Id" class="knopf">Zahlung buchen</a>
                                break;
                            case VorschlagArt.Wiederkehrend:
                                <a asp-page="Buchung" asp-route-vorlage="@v.Id" asp-route-umsatz="@u.Id" class="knopf">Buchen</a>
                                break;
                        }
                        <a asp-page="Buchung" asp-route-kasse="@Model.Kasse.Id" asp-route-umsatz="@u.Id" class="@(v is null ? "knopf" : "knopf-zweit")">Neu buchen</a>
                        <form method="post" asp-page-handler="Status" asp-route-kasse="@Model.Kasse.Id" asp-route-id="@u.Id" asp-route-ignorieren="true"><button type="submit" class="knopf-zweit">Ignorieren</button></form>
                    </div>
                    }
                </div>
            }
        </div>
    </section>

    @if (Model.Erledigt.Count > 0)
    {
        <section>
            <h2 class="mb-2 text-lg font-semibold">Zuletzt erledigt</h2>
            <div class="karte overflow-x-auto p-0">
                <table class="tabelle">
                    <thead><tr><th>Tag</th><th>Gegenpartei</th><th class="text-right">Betrag</th><th>Stand</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var u in Model.Erledigt)
                        {
                            <tr>
                                <td class="whitespace-nowrap">@Anzeige.Datum(u.Buchungstag)</td>
                                <td>@(Model.PartnerSichtbar ? u.Gegenpartei : "–")</td>
                                <td class="text-right">@Anzeige.Euro(u.Betrag)</td>
                                <td>
                                    @if (u.Buchung is { } b) { <a asp-page="Buchung" asp-route-id="@b.Id" class="text-feuer-700 hover:underline">Beleg @b.Kennung</a> }
                                    else { @Anzeige.Text(u.Status) }
                                </td>
                                <td>@if (Model.DarfBuchen) {<form method="post" asp-page-handler="Status" asp-route-kasse="@Model.Kasse.Id" asp-route-id="@u.Id" asp-route-ignorieren="false"><button type="submit" class="knopf-zweit">Wieder öffnen</button></form>}</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.Importe.Count > 0)
    {
        <section>
            <h2 class="mb-2 text-lg font-semibold">Letzte Dateien</h2>
            <ul class="text-sm text-gray-700">
                @foreach (var i in Model.Importe)
                {
                    <li>@Anzeige.DatumZeit(i.ErstelltAm) · @i.Konto?.Bezeichnung · @i.Dateiname (@Anzeige.Text(i.Format)) · @i.Neu von @i.Anzahl neu@(i.Von is { } von ? $" · {Anzeige.Datum(von)} bis {Anzeige.Datum(i.Bis!.Value)}" : "")</li>
                }
            </ul>
        </section>
    }
</div>
