@page "{id:guid}"
@using Fevad.Domain.Dienstbetrieb
@model Fevad.Web.Pages.Dienste.MeldungenModel
@{
    var d = Model.Dienst;
    ViewData["Title"] = $"Meldungen: {d.Titel}";
}
<div class="flex flex-wrap gap-x-4 text-sm">
    @if (Model.DarfDienstBearbeiten)
    {
        <a asp-page="Bearbeiten" asp-route-id="@d.Id" class="text-feuer-700 hover:underline">← zurück zum Dienst</a>
    }
    else
    {
        <a asp-page="/Termine/Termin" asp-route-id="@d.Id" class="text-feuer-700 hover:underline">← zurück zum Termin</a>
    }
</div>
<h1 class="mt-2 text-2xl font-bold">An- und Abmeldungen</h1>
<p class="mb-4 text-sm text-gray-600">@d.Titel · @Terminanzeige.Zeitraum(d) · Zielgruppe: @Terminanzeige.Zielgruppe(d)</p>

<form method="post" asp-page-handler="Zuordnen" asp-route-id="@d.Id" x-data>
    <div class="mb-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
        <span class="font-medium">Markieren:</span>
        <button type="button" class="text-feuer-700 hover:underline" x-on:click="$root.querySelectorAll('input[name=markiert]').forEach(c => c.checked = c.dataset.offen === 'ja')">alle ohne Rückmeldung</button>
        <button type="button" class="text-feuer-700 hover:underline" x-on:click="$root.querySelectorAll('input[name=markiert]').forEach(c => c.checked = true)">alle</button>
        <button type="button" class="text-feuer-700 hover:underline" x-on:click="$root.querySelectorAll('input[name=markiert]').forEach(c => c.checked = false)">keine</button>
    </div>

    <div class="karte overflow-x-auto p-0">
        <table class="tabelle">
            <thead><tr><th class="w-8"><span class="sr-only">markiert</span></th><th>Name</th><th>Rückmeldung</th><th>Anwesenheit</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Eintraege)
                {
                    <tr>
                        <td><input type="checkbox" name="markiert" value="@m.MitgliedId" data-offen="@(m.Antwort is null ? "ja" : "nein")" class="h-4 w-4" aria-label="@m.Name markieren" /></td>
                        <td><span class="font-medium">@m.Name</span> <span class="text-xs text-gray-500">@m.Abteilung</span></td>
                        <td>
                            @(m.Antwort is { } a ? Anzeige.Text(a) : "–")
                            @if (m.Begruendung is not null)
                            {
                                <div class="text-xs text-gray-600">@m.Begruendung</div>
                            }
                        </td>
                        <td>@(m.Anwesenheit is { } s ? Anzeige.Text(s) : "–")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex flex-wrap items-end gap-2">
        <div>
            <label class="etikett" for="meldung">Markierten zuordnen</label>
            <select id="meldung" name="meldung" class="eingabe">
                @foreach (var (wert, text) in MeldungenModel.Auswahl)
                {
                    if (d.AlsDienst || wert is Fevad.Infrastructure.Dienstbetrieb.Dienstplanung.Sammelmeldung.Zusage or Fevad.Infrastructure.Dienstbetrieb.Dienstplanung.Sammelmeldung.Absage)
                    {
                        <option value="@wert">@text</option>
                    }
                }
            </select>
        </div>
        <button type="submit" class="knopf">Zuordnen</button>
    </div>
    @if (d.AlsDienst)
    {
        <p class="mt-2 text-xs text-gray-500">Zu- und Absage gelten als Rückmeldung des Mitglieds (eine Absage steht gleich als entschuldigt in der Anwesenheit); „anwesend“, „entschuldigt“ und „unentschuldigt“ tragen direkt die Anwesenheit ein.</p>
    }
</form>
