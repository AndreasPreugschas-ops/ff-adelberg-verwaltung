@page
@using Fevad.Domain.Dienstbetrieb
@model Fevad.Web.Pages.Dienste.IndexModel
@{
    ViewData["Title"] = "Dienstplan";
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Dienstplan</h1>
    <a asp-page="/Termine/Kalender" class="knopf-zweit">Kalender</a>
</div>

@if (Model.DarfPlanen)
{
    <details class="karte mb-6" open="@(!ViewData.ModelState.IsValid)">
        <summary class="cursor-pointer font-semibold">Dienst oder Übung planen</summary>
        <form method="post" class="mt-4 grid gap-3 sm:grid-cols-6 sm:items-end" x-data="{ serie: @(Model.Wiederholung is null ? "false" : "true") }">
            <partial name="_Planungsfelder" model="(nameof(Model.Neu), Model.Neu, Model.Listen)" />
            <div class="sm:col-span-2">
                <label class="etikett" asp-for="Wiederholung">Wiederholung</label>
                <select asp-for="Wiederholung" class="eingabe" x-on:change="serie = $event.target.value !== ''">
                    <option value="">einmalig</option>
                    @foreach (var w in Enum.GetValues<Wiederholung>())
                    {
                        <option value="@w" selected="@(w == Model.Wiederholung)">@Anzeige.Text(w)</option>
                    }
                </select>
            </div>
            <div class="sm:col-span-2" x-show="serie" x-cloak>
                <label class="etikett" asp-for="WiederholenBis">bis einschließlich</label>
                <input asp-for="WiederholenBis" type="date" class="eingabe" />
                <span asp-validation-for="WiederholenBis" class="feldfehler"></span>
            </div>
            <div class="sm:col-span-6"><button type="submit" class="knopf">Planen</button></div>
        </form>
    </details>
}

<h2 class="mb-2 text-lg font-semibold">Kommende Dienste</h2>
<partial name="_Diensttabelle" model="Model.Kommende" />

<h2 class="mb-2 mt-8 text-lg font-semibold">Vergangene Dienste</h2>
<partial name="_Diensttabelle" model="Model.Vergangene" />
