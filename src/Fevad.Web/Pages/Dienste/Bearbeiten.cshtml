@page "{id:guid}"
@using Fevad.Domain.Dienstbetrieb
@model Fevad.Web.Pages.Dienste.BearbeitenModel
@{
    ViewData["Title"] = $"{Model.Dienst.Titel} bearbeiten";
}
<div class="flex flex-wrap gap-x-4 text-sm">
    <a asp-page="Index" class="text-feuer-700 hover:underline">← Dienstplan</a>
    <a asp-page="/Termine/Termin" asp-route-id="@Model.Dienst.Id" class="text-feuer-700 hover:underline">Terminansicht</a>
    @if (Model.Dienst.Art == DienstArt.Brandsicherheitswache)
    {
        <a asp-page-handler="Leistungsnachweis" asp-route-id="@Model.Dienst.Id" class="text-feuer-700 hover:underline">Leistungsnachweis (PDF)</a>
    }
    @if (Model.Dienst.Art == DienstArt.Unterweisung)
    {
        <a asp-page="Unterweisungen" class="text-feuer-700 hover:underline">Pflichtthemen im Jahr</a>
    }
</div>
<h1 class="mb-4 mt-2 text-2xl font-bold">
    Dienst bearbeiten
    @if (Model.Dienst.Abgeschlossen)
    {
        <span class="ampel-gruen align-middle">abgeschlossen</span>
    }
</h1>

<form method="post" class="karte grid gap-3 sm:grid-cols-6 sm:items-end">
    <partial name="_Planungsfelder" model="(nameof(Model.Formular), Model.Formular, Model.Listen)" />
    <div class="sm:col-span-2">
        <label class="etikett" asp-for="Status">Status</label>
        <select asp-for="Status" class="eingabe">
            @foreach (var s in Enum.GetValues<DienstStatus>())
            {
                <option value="@s" selected="@(s == Model.Status)">@Anzeige.Text(s)</option>
            }
        </select>
    </div>
    @if (Model.FolgendeInSerie > 0)
    {
        <label class="inline-flex items-center gap-2 text-sm sm:col-span-4">
            <input type="checkbox" asp-for="FolgendeAnpassen" class="h-4 w-4" />
            Titel, Art, Ort, Thema, Zielgruppe, Uhrzeit und eine Absage auch für die @Model.FolgendeInSerie folgenden Termine der Serie übernehmen
        </label>
    }
    <label class="inline-flex items-center gap-2 text-sm sm:col-span-6" title="Nur ein Kennzeichen; der Dienst bleibt für alle sichtbar">
        <input type="checkbox" asp-for="Abgeschlossen" class="h-4 w-4" /> abgeschlossen (fertig bearbeitet)
    </label>
    <div class="sm:col-span-6"><button type="submit" class="knopf">Speichern</button></div>
</form>

<section class="mt-6">
    <div class="mb-2 flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-semibold">An- und Abmeldungen</h2>
        <div class="flex flex-wrap gap-2">
            <a asp-page="Meldungen" asp-route-id="@Model.Dienst.Id" class="knopf">Meldungen bearbeiten</a>
            @if (Model.Dienst.AlsDienst)
            {
                <a asp-page="Anwesenheit" asp-route-id="@Model.Dienst.Id" class="knopf-zweit">Anwesenheit</a>
            }
        </div>
    </div>
    <p class="mb-3 text-sm text-gray-600">
        <span class="ampel-gruen">@Model.Meldungen.Count(m => m.Antwort == RueckmeldungAntwort.Zusage) zugesagt</span>
        <span class="inline-block rounded bg-gray-100 px-2 py-0.5 text-xs font-semibold text-gray-700">@Model.Meldungen.Count(m => m.Antwort == RueckmeldungAntwort.Absage) abgesagt</span>
        <span class="ampel-gelb">@Model.Meldungen.Count(m => m.Antwort is null) offen</span>
    </p>
    <partial name="_Rueckmeldungen" model="Model.Meldungen" />
</section>

<section class="karte mt-6">
    <h2 class="mb-2 font-semibold">Löschen</h2>
    <p class="mb-3 text-sm text-gray-600">Fällt ein Dienst nur aus, besser den Status auf „abgesagt“ setzen: dann sehen alle die Absage, auch im Kalender-Abo.</p>
    <div class="flex flex-wrap gap-2">
        <form method="post" asp-page-handler="Loeschen" asp-route-id="@Model.Dienst.Id">
            <button type="submit" class="knopf-zweit">Diesen Termin löschen</button>
        </form>
        @if (Model.FolgendeInSerie > 0)
        {
            <form method="post" asp-page-handler="Loeschen" asp-route-id="@Model.Dienst.Id" asp-route-folgende="true">
                <button type="submit" class="knopf-zweit">Diesen und @Model.FolgendeInSerie folgende löschen</button>
            </form>
        }
    </div>
</section>
