@page
@model Fevad.Web.Pages.Dienste.EinstellungenModel
@{
    ViewData["Title"] = "Einstellungen des Dienstplans";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Dienstplan</a>
<h1 class="mb-2 mt-2 text-2xl font-bold">Einstellungen des Dienstplans</h1>

<form method="post" class="grid max-w-3xl gap-6">
    <div asp-validation-summary="ModelOnly" class="feldfehler"></div>
    <p class="text-sm text-gray-600">
        Eine Änderung gilt ab heute; der bisherige Wert bleibt mit seinem Gültigkeitsbeginn erhalten.
    </p>
    <partial name="_Einstellungen" model='(EinstellungenModel.Alle, (IReadOnlyDictionary<string, int>)Model.Werte)' />
    <div><button type="submit" class="knopf">Speichern</button></div>
</form>
