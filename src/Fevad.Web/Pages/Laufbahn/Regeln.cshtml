@page
@using Fevad.Domain.Laufbahn
@model Fevad.Web.Pages.Laufbahn.RegelnModel
@{
    ViewData["Title"] = "Laufbahn-Regeln";
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-semibold">Regeln für Übertritte, Ehrungen und Beförderungen</h1>
    <a asp-page="Index" class="knopf-zweit">Laufbahn</a>
</div>

<section class="karte mb-6 overflow-x-auto">
    <h2 class="mb-1 text-lg font-semibold">Altersgrenzen und Fristen</h2>
    <p class="mb-3 text-sm text-gray-600">Aus der Feuerwehrsatzung und der VwV Feuerwehr-Ehrenzeichen. Ändern unter <a asp-page="/Stammdaten/Abteilungsregeln" class="text-feuer-700 hover:underline">Einstellungen der Abteilungen</a>; jede Änderung gilt ab dem Tag und bleibt nachvollziehbar.</p>
    <table class="tabelle">
        <thead><tr><th>Parameter</th><th>Wert</th><th>gültig ab</th><th>Quelle</th></tr></thead>
        <tbody>
            @foreach (var p in Model.Parameter)
            {
                <tr><td><code>@p.Schluessel</code></td><td class="font-medium">@p.Wert</td><td>@Anzeige.Datum(p.GueltigAb)</td><td>@p.Quelle</td></tr>
            }
        </tbody>
    </table>
</section>

<section class="karte mb-6">
    <h2 class="mb-1 text-lg font-semibold">Ehrungsarten</h2>
    <p class="mb-3 text-sm text-gray-600">
        Stufen mit gleicher Reihe ersetzen sich: Wer die höhere hat, bekommt keinen Vorschlag für die niedrigere.
        Mit Vorstufe erscheint der Vorschlag erst, wenn die Vorstufe verliehen ist und der Mindestabstand vergangen ist.
        Vorlauf: so viele Wochen vorher erscheint der Vorschlag. Funktionen: @string.Join(", ", Model.FunktionCodes).
        Qualifikationen: @string.Join(", ", Model.QualifikationCodes).
    </p>
    <div class="overflow-x-auto">
        <table class="tabelle">
            <thead><tr><th>Ehrung</th><th>Grundlage</th><th>Vorstufe</th><th>Verleiher</th><th>Vorlauf</th><th>aktiv</th><th></th></tr></thead>
            <tbody>
                @foreach (var e in Model.Ehrungsarten)
                {
                    <tr class="cursor-pointer hover:bg-gray-50" data-dialog="dialog-art-@e.Id" title="Klicken zum Ändern">
                        <td class="font-medium">@e.Bezeichnung <span class="text-xs text-gray-500">@e.Code</span></td>
                        <td>@Anzeige.Text(e.Grundlage)@(e.Jahre is { } j ? $", {j} Jahre" : "")@(e.FunktionCode is { } fc ? $" ({fc})" : "")</td>
                        <td>@(Model.Ehrungsarten.FirstOrDefault(v => v.Id == e.VorstufeId)?.Bezeichnung)@(e.MindestabstandJahre is { } a ? $", {a} Jahre Abstand" : "")</td>
                        <td>@e.Verleiher</td>
                        <td class="whitespace-nowrap">@e.VorlaufWochen Wochen@(e.MitAntragsschluss ? ", Antragsschluss" : "")</td>
                        <td>@(e.Aktiv ? "ja" : "nein")</td>
                        <td><button type="button" class="text-sm font-semibold text-feuer-700 hover:underline" data-dialog="dialog-art-@e.Id">ändern</button></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @foreach (var e in Model.Ehrungsarten)
    {
        <partial name="_Ehrungsartfelder" model="(e, Model)" />
    }
    <button type="button" class="knopf-zweit mt-4" data-dialog="dialog-art-neu">Neue Ehrungsart</button>
    <partial name="_Ehrungsartfelder" model="((Fevad.Domain.Laufbahn.Ehrungsart?)null, Model)" />
</section>

<section class="karte overflow-x-auto">
    <h2 class="mb-1 text-lg font-semibold">Beförderungswege</h2>
    <p class="mb-3 text-sm text-gray-600">
        Nach VwV Feuerwehrbekleidung BW (Übersicht Landratsamt Schwarzwald-Baar-Kreis, Stand 11/2025). Ein Weg genügt.
        Qualifikationen als Codes, durch Komma getrennt: @string.Join(", ", Model.QualifikationCodes).
        Wartezeit: Mindestabstand bis zur nächsten Beförderung.
    </p>
    @foreach (var d in Model.Dienstgrade)
    {
        <div class="mb-4 border-t border-gray-100 pt-3">
            <form method="post" asp-page-handler="Wartezeit" class="mb-2 flex flex-wrap items-center gap-2">
                <h3 class="font-semibold">@d.Bezeichnung</h3>
                <input type="hidden" name="dienstgradId" value="@d.Id" />
                <label class="text-sm text-gray-600" for="wz-@d.Id">Wartezeit danach (Monate)</label>
                <input id="wz-@d.Id" name="mindestwartezeitMonate" type="number" min="0" value="@d.MindestwartezeitMonate" class="eingabe w-20" />
                <button type="submit" class="knopf-zweit">Speichern</button>
            </form>
            <table class="tabelle">
                <thead><tr><th>Weg</th><th>Jahre im Dienstgrad</th><th>alle von</th><th>eine von</th><th>Probezeit beendet</th><th>überspringen</th><th>nur von Hand</th><th>Hinweis</th><th></th></tr></thead>
                <tbody>
                    @foreach (var w in Model.Wege[d.Id])
                    {
                        <tr class="cursor-pointer hover:bg-gray-50" data-dialog="dialog-weg-@w.Id" title="Klicken zum Ändern">
                            <td>@w.Bezeichnung</td>
                            <td>@w.MindestjahreImDienstgrad</td>
                            <td>@string.Join(", ", w.AlleQualifikationen)</td>
                            <td>@string.Join(", ", w.EineDerQualifikationen)</td>
                            <td>@(w.ProbezeitBeendet ? "ja" : "nein")</td>
                            <td>@(w.UeberspringenErlaubt ? "ja" : "nein")</td>
                            <td>@(w.NurVonHand ? "ja" : "nein")</td>
                            <td>@w.Hinweis</td>
                            <td><button type="button" class="text-sm font-semibold text-feuer-700 hover:underline" data-dialog="dialog-weg-@w.Id">ändern</button></td>
                        </tr>
                    }
                </tbody>
            </table>
            <button type="button" class="knopf-zweit mt-2" data-dialog="dialog-weg-neu-@d.Id">Weg hinzufügen</button>
            @foreach (var w in Model.Wege[d.Id])
            {
                await WegDialog(d, w);
            }
            @{ await WegDialog(d, null); }
        </div>
    }
</section>

@functions {
    // Bearbeiten im Dialog: ein Beförderungsweg, neu (w = null) oder bestehend.
    async Task WegDialog(Fevad.Domain.Mitglieder.Dienstgrad d, Befoerderungsweg? w)
    {
        var id = w is null ? $"weg-neu-{d.Id}" : $"weg-{w.Id}";
        <dialog id="dialog-@id" class="dialog" aria-labelledby="dialog-@id-titel">
            @if (w is not null)
            {
                <form id="loeschen-@id" method="post" asp-page-handler="WegLoeschen"
                      x-data x-on:submit="if (!window.confirm('Diesen Beförderungsweg löschen?')) $event.preventDefault()">
                    <input type="hidden" name="id" value="@w.Id" />
                </form>
            }
            <form method="post" asp-page-handler="Weg">
                <div class="dialog-kopf">
                    <h2 id="dialog-@id-titel" class="font-semibold">@(w is null ? $"Neuer Weg zum {d.Bezeichnung}" : $"Weg zum {d.Bezeichnung}: {w.Bezeichnung}")</h2>
                    <button type="button" class="text-xl leading-none text-gray-500 hover:text-gray-800" data-dialog-schliessen aria-label="Schließen">×</button>
                </div>
                <div class="dialog-inhalt">
                    @if (w is not null) { <input type="hidden" name="id" value="@w.Id" /> }
                    <input type="hidden" name="dienstgradId" value="@d.Id" />
                    <div><label class="etikett" for="@id-bez">Weg</label><input id="@id-bez" name="bezeichnung" value="@w?.Bezeichnung" class="eingabe" /></div>
                    <div><label class="etikett" for="@id-jahre">Jahre im Dienstgrad</label><input id="@id-jahre" name="mindestjahreImDienstgrad" type="number" min="0" value="@(w?.MindestjahreImDienstgrad ?? 0)" class="eingabe" /></div>
                    <div><label class="etikett" for="@id-alle">alle von (Codes)</label><input id="@id-alle" name="alleQualifikationen" value="@(w is null ? "" : string.Join(", ", w.AlleQualifikationen))" class="eingabe" /></div>
                    <div><label class="etikett" for="@id-eine">eine von (Codes)</label><input id="@id-eine" name="eineDerQualifikationen" value="@(w is null ? "" : string.Join(", ", w.EineDerQualifikationen))" class="eingabe" /></div>
                    <label class="flex items-center gap-2 text-sm"><input name="probezeitBeendet" type="checkbox" value="true" checked="@(w?.ProbezeitBeendet ?? false)" /> Probezeit beendet</label>
                    <label class="flex items-center gap-2 text-sm"><input name="ueberspringenErlaubt" type="checkbox" value="true" checked="@(w?.UeberspringenErlaubt ?? false)" /> überspringen erlaubt</label>
                    <label class="flex items-center gap-2 text-sm"><input name="nurVonHand" type="checkbox" value="true" checked="@(w?.NurVonHand ?? false)" /> nur von Hand</label>
                    <div class="sm:col-span-2"><label class="etikett" for="@id-hinweis">Hinweis</label><input id="@id-hinweis" name="hinweis" value="@w?.Hinweis" class="eingabe" /></div>
                </div>
                <div class="dialog-fuss">
                    @if (w is not null) { <button type="submit" form="loeschen-@id" class="mr-auto text-sm text-red-700 hover:underline">löschen</button> }
                    <button type="button" class="knopf-zweit" data-dialog-schliessen>Abbrechen</button>
                    <button type="submit" class="knopf">@(w is null ? "Hinzufügen" : "Speichern")</button>
                </div>
            </form>
        </dialog>
    }
}
