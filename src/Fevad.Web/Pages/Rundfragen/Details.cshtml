@page "{id:guid}"
@model Fevad.Web.Pages.Rundfragen.DetailsModel
@using Fevad.Domain.Kommunikation
@{
    var r = Model.Rundfrage;
    ViewData["Title"] = r.Titel;
    var mehrfach = r.Art == RundfrageArt.Umfrage && r.Mehrfachauswahl;
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline print:hidden">← Rundfragen</a>
<article class="karte mt-2 max-w-3xl">
    <p class="text-xs text-gray-600">
        @Anzeige.Text(r.Art)
        @if (r.Status != RundfrageStatus.Entwurf)
        {
            <span> · @r.Verfasser · @Anzeige.DatumZeit(r.VerschicktAm)</span>
        }
        <span> · @Anzeige.Text(r.Status)</span>
        @if (r.Anonym)
        {
            <span> · anonym</span>
        }
    </p>
    <h1 class="mb-2 mt-1 text-2xl font-bold">@r.Titel</h1>
    @if (r.Tag is { } tag)
    {
        <p class="text-sm font-semibold">Für @Anzeige.Datum(tag)</p>
    }
    @if (r.Text is not null)
    {
        <div class="mt-2 whitespace-pre-line text-sm leading-relaxed">@r.Text</div>
    }
    @if (r.AntwortBis is { } bis)
    {
        <p class="mt-2 text-xs text-gray-600">Antworten bis einschließlich @Anzeige.Datum(bis).</p>
    }

    @if (Model.Eigener is { } e)
    {
        <div class="mt-4 border-t border-gray-200 pt-3">
            @if (r.Anonym && e.BeantwortetAm is not null)
            {
                <p class="text-sm text-green-800">Du hast abgestimmt. Deine Antwort ist anonym gespeichert.</p>
            }
            else if (Model.Offen)
            {
                <form method="post" asp-page-handler="Antworten" asp-route-id="@r.Id" class="grid gap-3">
                    <fieldset>
                        <legend class="etikett">@(mehrfach ? "Deine Antworten" : "Deine Antwort")</legend>
                        <div class="grid gap-1 text-sm">
                            @for (var i = 0; i < r.Moeglichkeiten.Count; i++)
                            {
                                <label class="flex items-center gap-2">
                                    <input type="@(mehrfach ? "checkbox" : "radio")" name="auswahl" value="@i" checked="@(Model.Antwort?.Auswahl.Contains(i) == true)" /> @r.Moeglichkeiten[i]
                                </label>
                            }
                        </div>
                    </fieldset>
                    @if (!r.Anonym)
                    {
                        <div>
                            <label for="bemerkung" class="etikett">Bemerkung (freiwillig)</label>
                            <input id="bemerkung" name="bemerkung" maxlength="200" class="eingabe" value="@Model.Antwort?.Bemerkung" placeholder="z. B. erst ab 10:00 Uhr" />
                            <p class="mt-1 text-xs text-gray-500">Keine Gründe zur Gesundheit angeben.</p>
                        </div>
                    }
                    <div><button type="submit" class="knopf">@(Model.Antwort is null ? "Antworten" : "Antwort ändern")</button></div>
                </form>
            }
            else
            {
                <p class="text-sm text-gray-700">
                    Die Rundfrage ist beendet.
                    @if (Model.Antwort is { } a)
                    {
                        <span>Deine Antwort: @string.Join(", ", a.Auswahl.Where(i => i < r.Moeglichkeiten.Count).Select(i => r.Moeglichkeiten[i])).</span>
                    }
                </p>
            }
        </div>
    }
</article>

@if (Model.Verwalten)
{
    <section class="karte mt-4 max-w-3xl">
        <h2 class="mb-2 text-lg font-semibold">Verwaltung</h2>
        @if (r.Status == RundfrageStatus.Entwurf)
        {
            <p class="mb-3 text-sm">Erreicht heute <strong>@Model.Vorschau</strong> Konto/Konten.</p>
            <div class="flex flex-wrap gap-2 print:hidden">
                <form method="post" asp-page-handler="Verschicken" asp-route-id="@r.Id">
                    <button type="submit" class="knopf">Verschicken</button>
                </form>
                <a asp-page="Bearbeiten" asp-route-id="@r.Id" class="knopf-zweit">Bearbeiten</a>
            </div>
        }
        else if (Model.Ergebnis is { } erg)
        {
            <p class="mb-2 text-sm">@erg.Geantwortet von @erg.Empfaenger haben geantwortet.</p>
            <div class="overflow-x-auto">
                <table class="tabelle mb-3">
                    <thead><tr><th scope="col">Antwort</th><th scope="col" class="text-right">Stimmen</th></tr></thead>
                    <tbody>
                        @for (var i = 0; i < r.Moeglichkeiten.Count; i++)
                        {
                            <tr><td>@r.Moeglichkeiten[i]</td><td class="text-right">@erg.JeMoeglichkeit[i]</td></tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (erg.JeQualifikation.Count > 0)
            {
                <h3 class="mb-1 mt-3 font-semibold">Zusagen nach Qualifikation</h3>
                <div class="overflow-x-auto">
                    <table class="tabelle mb-3">
                        <thead><tr><th scope="col">Qualifikation</th><th scope="col" class="text-right">Ja</th><th scope="col" class="text-right">Vielleicht</th></tr></thead>
                        <tbody>
                            @foreach (var q in erg.JeQualifikation)
                            {
                                <tr><td>@q.Bezeichnung</td><td class="text-right">@q.Ja</td><td class="text-right">@q.Vielleicht</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            @if (erg.Personen.Count > 0)
            {
                <h3 class="mb-1 mt-3 font-semibold">Antworten</h3>
                <div class="overflow-x-auto">
                    <table class="tabelle">
                        <thead><tr><th scope="col">Name</th><th scope="col">Antwort</th><th scope="col">Bemerkung</th></tr></thead>
                        <tbody>
                            @foreach (var p in erg.Personen)
                            {
                                <tr><td>@p.Name</td><td>@(p.Auswahl ?? "keine Antwort")</td><td>@p.Bemerkung</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            <div class="mt-3 flex flex-wrap gap-2 print:hidden">
                @if (r.Status == RundfrageStatus.Offen)
                {
                    <form method="post" asp-page-handler="Beenden" asp-route-id="@r.Id">
                        <button type="submit" class="knopf-zweit">Beenden</button>
                    </form>
                }
                <button type="button" class="knopf-zweit" onclick="window.print()">Drucken</button>
            </div>
        }
    </section>
}
