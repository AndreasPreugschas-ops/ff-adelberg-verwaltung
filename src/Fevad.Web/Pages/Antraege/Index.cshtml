@page
@model Fevad.Web.Pages.Antraege.IndexModel
@using Fevad.Domain.Mitglieder
@{
    ViewData["Title"] = Model.MitgliedName is null ? "Anträge" : $"Anträge: {Model.MitgliedName}";
}
@if (Model.Mitglied is { } mitgliedId)
{
    <a asp-page="/Mitglieder/Index" class="text-sm text-feuer-700 hover:underline">← Mitglieder</a>
    <h1 class="mb-4 mt-2 text-2xl font-bold">@Model.MitgliedName</h1>
    <partial name="_Mitgliedreiter" model='(mitgliedId, "Anträge")' />
    <partial name="_Antragstabelle" model="Model.Zeilen" />
    return;
}
<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Anträge</h1>
    <div class="flex flex-wrap gap-2">
        @if (Model.AufnahmeJugend)
        {
            <a asp-page="Bearbeiten" asp-route-art="@AntragArt.JugendEintritt" class="knopf">Aufnahme Jugendfeuerwehr</a>
        }
        @if (Model.AufnahmeEinsatz)
        {
            <a asp-page="Bearbeiten" asp-route-art="@AntragArt.EinsatzEintritt" class="knopf">Aufnahme Einsatzabteilung</a>
        }
    </div>
</div>
<p class="mb-4 max-w-3xl text-sm text-gray-600">
    Antrag hier ausfüllen und als PDF zum Unterschreiben drucken, oder das Formular blanko drucken und von Hand ausfüllen lassen.
    Rechtsverbindlich ist das unterschriebene Papier; ist es da, „unterschrieben eingegangen“ eintragen. Mit der Annahme legt FEVAD
    das Mitglied an bzw. trägt den Übertritt ein.
</p>

<div class="mb-6 grid gap-4 lg:grid-cols-3">
    <section class="karte">
        <h2 class="mb-2 font-semibold">Übertritt mit 17</h2>
        @if (Model.Jugendliche.Count == 0)
        {
            <p class="text-sm text-gray-500">Niemand in der Jugendfeuerwehr.</p>
        }
        else
        {
            <form method="get" asp-page="Bearbeiten" class="flex flex-wrap items-end gap-2">
                <input type="hidden" name="art" value="@AntragArt.UebertrittEinsatz" />
                <select name="mitglied" asp-items="Model.Jugendliche" class="eingabe min-w-0 flex-1" aria-label="Mitglied der Jugendfeuerwehr"></select>
                <button type="submit" class="knopf-zweit">Antrag erstellen</button>
            </form>
        }
    </section>
    <section class="karte">
        <h2 class="mb-2 font-semibold">Erklärung bei Volljährigkeit</h2>
        @if (Model.Minderjaehrige.Count == 0)
        {
            <p class="text-sm text-gray-500">Niemand unter 19 in der Einsatzabteilung.</p>
        }
        else
        {
            <form method="get" asp-page="Bearbeiten" class="flex flex-wrap items-end gap-2">
                <input type="hidden" name="art" value="@AntragArt.Volljaehrigkeit" />
                <select name="mitglied" asp-items="Model.Minderjaehrige" class="eingabe min-w-0 flex-1" aria-label="Mitglied der Einsatzabteilung"></select>
                <button type="submit" class="knopf-zweit">Erklärung erstellen</button>
            </form>
        }
    </section>
    <section class="karte">
        <h2 class="mb-2 font-semibold">Blanko drucken</h2>
        <ul class="space-y-1 text-sm">
            @foreach (var art in Enum.GetValues<AntragArt>())
            {
                <li><a asp-page-handler="Blanko" asp-route-art="@art" class="text-feuer-700 hover:underline">@Anzeige.Text(art)</a></li>
            }
        </ul>
        <p class="mt-2 text-xs text-gray-500">Die Datenschutzinformation nach Art. 13 DSGVO ist jedem Formular hinten angehängt.</p>
    </section>
</div>

<div class="mb-2 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-lg font-semibold">@(Model.Abgeschlossene ? "Alle Anträge" : "Offene Anträge")</h2>
    <a asp-route-abgeschlossene="@(!Model.Abgeschlossene)" class="text-sm text-feuer-700 hover:underline">
        @(Model.Abgeschlossene ? "nur offene zeigen" : "auch abgeschlossene zeigen")
    </a>
</div>
<partial name="_Antragstabelle" model="Model.Zeilen" />
