@page
@using Fevad.Domain.Einsaetze
@model Fevad.Web.Pages.Kostenersatz.IndexModel
@{
    ViewData["Title"] = "Kostenersatz";
}
<div class="mb-2 flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-bold">Kostenersatz @Model.Jahr</h1>
    <span class="flex gap-2">
        <a asp-route-jahr="@(Model.Jahr - 1)" class="knopf-zweit">← @(Model.Jahr - 1)</a>
        <a asp-route-jahr="@(Model.Jahr + 1)" class="knopf-zweit">@(Model.Jahr + 1) →</a>
    </span>
</div>
<p class="mb-4 max-w-3xl text-sm text-gray-700">
    Kostenersatz nach § 34 FwG: Die Feuerwehr erfasst je Einsatz Tatbestand, Schuldner und Kosten und gibt eine Empfehlung ab, die Gemeinde entscheidet.
    Verzichte werden mit Begründung dokumentiert. Nach einer kostenpflichtigen Entscheidung führt das Hauptamt je Schuldner einen Bescheid bis zur Zahlung.
</p>

<div class="grid max-w-5xl gap-6">
    <section>
        <h2 class="mb-2 text-lg font-semibold">Vorgänge</h2>
        @if (Model.Vorgaenge.Count == 0)
        {
            <p class="text-sm text-gray-500">Keine Vorgänge in diesem Jahr.</p>
        }
        else
        {
            <div class="karte overflow-x-auto p-0">
                <table class="tabelle">
                    <thead><tr><th>Einsatz</th><th>Datum</th><th>Tatbestand</th><th>Empfehlung</th><th>Entscheidung</th><th>Stand</th></tr></thead>
                    <tbody>
                        @foreach (var z in Model.Vorgaenge)
                        {
                            var v = z.Vorgang!;
                            <tr>
                                <td><a asp-page="Vorgang" asp-route-einsatzId="@z.EinsatzId" class="text-feuer-700 hover:underline">@z.Einsatznummer</a> @z.Stichwort</td>
                                <td class="whitespace-nowrap">@Anzeige.Datum(Anzeige.LokalesDatum(z.Alarmiert))</td>
                                <td>@(v.Tatbestand is { } t ? Anzeige.Text(t) : "–")</td>
                                <td>@(v.Empfehlung is { } em ? Anzeige.Text(em) : "–")</td>
                                <td>@(v.Entscheidung is { } en ? Anzeige.Text(en) : "–")</td>
                                <td><span class="@(v.Stand switch { KostenersatzStand.Entschieden => "ampel-gruen", KostenersatzStand.Empfohlen => "ampel-gelb", _ => "ampel-rot" })">@Anzeige.Text(v.Stand)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    @if (Model.OhneVorgang.Count > 0)
    {
        <section>
            <h2 class="mb-2 text-lg font-semibold">Einsätze ohne Vorgang <span class="text-sm font-normal text-gray-500">(§ 2 Abs. 2 FwG oder Kostenersatz offen)</span></h2>
            <ul class="karte grid gap-1 text-sm">
                @foreach (var z in Model.OhneVorgang)
                {
                    <li><a asp-page="Vorgang" asp-route-einsatzId="@z.EinsatzId" class="text-feuer-700 hover:underline">@z.Einsatznummer</a> @Anzeige.Datum(Anzeige.LokalesDatum(z.Alarmiert)) @z.Stichwort</li>
                }
            </ul>
        </section>
    }

    @if (Model.Forderungen.Count > 0)
    {
        <section>
            <h2 class="mb-2 text-lg font-semibold">Forderungen aus Bescheiden</h2>
            <div class="karte overflow-x-auto p-0">
                <table class="tabelle text-sm">
                    <thead><tr><th>Einsatz</th><th>Schuldner</th><th>Kassenzeichen</th><th class="text-right">festgesetzt</th><th class="text-right">bezahlt</th><th class="text-right">offen</th><th>fällig</th><th>Verjährung</th><th>Stand</th></tr></thead>
                    <tbody>
                        @foreach (var f in Model.Forderungen)
                        {
                            var b = f.Bescheid;
                            var ueberfaellig = !b.Erledigt && b.Offen > 0 && b.FaelligAm < Model.Heute;
                            var verjaehrtBald = !b.Erledigt && b.Offen > 0 && f.VerjaehrtAm is { } va && va <= Model.Heute.AddMonths(6);
                            <tr>
                                <td><a asp-page="Bescheid" asp-route-id="@b.Id" class="text-feuer-700 hover:underline">@f.Einsatznummer</a></td>
                                <td>@(f.Schuldner ?? "(gelöscht)")</td>
                                <td>@(b.Kassenzeichen ?? "–")</td>
                                <td class="text-right">@(b.Betrag is { } betrag ? Anzeige.Euro(betrag) : "–")</td>
                                <td class="text-right">@Anzeige.Euro(b.Bezahlt)</td>
                                <td class="text-right">@Anzeige.Euro(b.Offen)</td>
                                <td class="@(ueberfaellig ? "ampel-rot" : "")">@Anzeige.Datum(b.FaelligAm)</td>
                                <td class="@(verjaehrtBald ? "ampel-gelb" : "")">@Anzeige.Datum(f.VerjaehrtAm)</td>
                                <td>@Anzeige.Text(b.Stand)</td>
                            </tr>
                        }
                        <tr class="font-semibold">
                            <td colspan="3">Summe</td>
                            <td class="text-right">@Anzeige.Euro(Model.Forderungen.Sum(f => f.Bescheid.Betrag ?? 0))</td>
                            <td class="text-right">@Anzeige.Euro(Model.Forderungen.Sum(f => f.Bescheid.Bezahlt))</td>
                            <td class="text-right">@Anzeige.Euro(Model.Forderungen.Sum(f => f.Bescheid.Offen))</td>
                            <td colspan="3"></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>
    }

    @if (Model.JeTatbestand.Count > 0)
    {
        <section>
            <h2 class="mb-2 text-lg font-semibold">Vorgänge je Tatbestand</h2>
            <table class="tabelle karte text-sm">
                <thead><tr><th>Tatbestand</th><th class="text-right">Vorgänge</th><th class="text-right">festgesetzt</th><th class="text-right">bezahlt</th></tr></thead>
                <tbody>
                    @foreach (var (t, n, festgesetzt, bezahlt) in Model.JeTatbestand)
                    {
                        <tr><td>@(t is { } tb ? Anzeige.Text(tb) : "ohne Tatbestand")</td><td class="text-right">@n</td><td class="text-right">@Anzeige.Euro(festgesetzt)</td><td class="text-right">@Anzeige.Euro(bezahlt)</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }
</div>
