@page
@model Fevad.Web.Pages.Unfaelle.IndexModel
@inject IAuthorizationService Autorisierung
@{
    ViewData["Title"] = "Dienstunfälle";
    var darfAnlegen = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.UnfaelleAnlegen)).Succeeded;
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Dienstunfälle</h1>
    @if (darfAnlegen)
    {
        <a asp-page="Bearbeiten" class="knopf">Unfall erfassen</a>
    }
</div>
<p class="mb-4 max-w-3xl text-sm text-gray-600">
    Unfallanzeige nach § 193 SGB VII an die Unfallkasse Baden-Württemberg. Pflicht bei Tod oder mehr als drei Tagen Arbeitsunfähigkeit,
    die Frist steht in der Liste. Verletzungsangaben sind Gesundheitsdaten und stehen nur im einzelnen Unfall.
</p>

<form method="get" class="mb-4 flex items-end gap-2">
    <div>
        <label for="Jahr" class="etikett">Jahr</label>
        <select id="Jahr" name="Jahr" class="eingabe" onchange="this.form.submit()">
            @foreach (var j in Model.Jahre)
            {
                <option value="@j" selected="@(j == Model.Jahr)">@j</option>
            }
        </select>
    </div>
    <noscript><button type="submit" class="knopf-zweit">Anzeigen</button></noscript>
</form>

@if (Model.Offen.Count > 0)
{
    <h2 class="mb-2 text-lg font-semibold">Noch nicht gemeldet aus anderen Jahren</h2>
    <partial name="_Tabelle" model="Model.Offen" />
}

@if (Model.Zeilen.Count == 0)
{
    <p class="text-sm text-gray-500">Keine Unfälle in @Model.Jahr.</p>
}
else
{
    <partial name="_Tabelle" model="Model.Zeilen" />
}
