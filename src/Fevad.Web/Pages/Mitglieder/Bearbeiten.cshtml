@page "{id:guid?}"
@model Fevad.Web.Pages.Mitglieder.BearbeitenModel
@using Fevad.Domain.Mitglieder
@inject IAuthorizationService Autorisierung
@{
    ViewData["Title"] = Model.IstNeu ? "Neues Mitglied" : $"{Model.Formular.Nachname}, {Model.Formular.Vorname}";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Mitglieder</a>
<h1 class="mb-4 mt-2 text-2xl font-bold">@ViewData["Title"]</h1>
@if (Model.Formular.Id is { } mitgliedId)
{
    <partial name="_Mitgliedreiter" model='(mitgliedId, "Stammdaten")' />
}

<form method="post" class="karte grid max-w-3xl gap-4 sm:grid-cols-2">
    <input type="hidden" asp-for="Formular.Id" />
    <input type="hidden" asp-for="Formular.Version" />
    <div asp-validation-summary="ModelOnly" class="feldfehler sm:col-span-2"></div>

    <div><label asp-for="Formular.Personalnummer" class="etikett"></label><input asp-for="Formular.Personalnummer" class="eingabe" /><span asp-validation-for="Formular.Personalnummer" class="feldfehler"></span></div>
    <div><label asp-for="Formular.Geburtsdatum" class="etikett"></label><input asp-for="Formular.Geburtsdatum" type="date" class="eingabe" /><span asp-validation-for="Formular.Geburtsdatum" class="feldfehler"></span></div>
    <div>
        <label asp-for="Formular.Geschlecht" class="etikett"></label>
        <select asp-for="Formular.Geschlecht" asp-items="Html.GetEnumSelectList<Geschlecht>()" class="eingabe"><option value="">keine Angabe</option></select>
    </div>
    <div></div>
    <div><label asp-for="Formular.Vorname" class="etikett"></label><input asp-for="Formular.Vorname" class="eingabe" /><span asp-validation-for="Formular.Vorname" class="feldfehler"></span></div>
    <div><label asp-for="Formular.Nachname" class="etikett"></label><input asp-for="Formular.Nachname" class="eingabe" /><span asp-validation-for="Formular.Nachname" class="feldfehler"></span></div>
    <div class="sm:col-span-2"><label asp-for="Formular.Strasse" class="etikett"></label><input asp-for="Formular.Strasse" class="eingabe" /></div>
    <div><label asp-for="Formular.Plz" class="etikett"></label><input asp-for="Formular.Plz" class="eingabe" /></div>
    <div><label asp-for="Formular.Ort" class="etikett"></label><input asp-for="Formular.Ort" class="eingabe" /></div>
    <div><label asp-for="Formular.TelefonMobil" class="etikett"></label><input asp-for="Formular.TelefonMobil" class="eingabe" /><span asp-validation-for="Formular.TelefonMobil" class="feldfehler"></span></div>
    <div><label asp-for="Formular.TelefonFestnetz" class="etikett"></label><input asp-for="Formular.TelefonFestnetz" class="eingabe" /><span asp-validation-for="Formular.TelefonFestnetz" class="feldfehler"></span></div>
    <div class="sm:col-span-2"><label asp-for="Formular.Email" class="etikett"></label><input asp-for="Formular.Email" class="eingabe" /><span asp-validation-for="Formular.Email" class="feldfehler"></span></div>

    @if (Model.DarfArbeitgeber)
    {
        <h2 class="text-lg font-semibold sm:col-span-2">Beruf und Arbeitgeber</h2>
        <p class="text-sm text-gray-500 sm:col-span-2">Für die Tagesverfügbarkeit. Nur für die Wehrführung sichtbar.</p>
        <div><label asp-for="Formular.Beruf" class="etikett"></label><input asp-for="Formular.Beruf" class="eingabe" /></div>
        <div><label asp-for="Formular.Arbeitgeber" class="etikett"></label><input asp-for="Formular.Arbeitgeber" class="eingabe" /></div>
        <div class="sm:col-span-2"><label asp-for="Formular.ArbeitgeberStrasse" class="etikett"></label><input asp-for="Formular.ArbeitgeberStrasse" class="eingabe" /></div>
        <div><label asp-for="Formular.ArbeitgeberPlz" class="etikett"></label><input asp-for="Formular.ArbeitgeberPlz" class="eingabe" /></div>
        <div><label asp-for="Formular.Arbeitsort" class="etikett"></label><input asp-for="Formular.Arbeitsort" class="eingabe" /></div>
        <div><label asp-for="Formular.ArbeitgeberTelefon" class="etikett"></label><input asp-for="Formular.ArbeitgeberTelefon" class="eingabe" /><span asp-validation-for="Formular.ArbeitgeberTelefon" class="feldfehler"></span></div>
        <div><label asp-for="Formular.ArbeitgeberMobil" class="etikett"></label><input asp-for="Formular.ArbeitgeberMobil" class="eingabe" /><span asp-validation-for="Formular.ArbeitgeberMobil" class="feldfehler"></span></div>
        <div class="sm:col-span-2"><label asp-for="Formular.ArbeitgeberEmail" class="etikett"></label><input asp-for="Formular.ArbeitgeberEmail" class="eingabe" /><span asp-validation-for="Formular.ArbeitgeberEmail" class="feldfehler"></span></div>
    }

    <details class="sm:col-span-2" open="@(Model.Formular.Erziehungsberechtigte.Any(e => !e.IstLeer) || (Model.Formular.Geburtsdatum is { } geb && Fevad.Domain.Mitglieder.Mitglied.Alter(geb, Model.Heute) < 18))">
        <summary class="cursor-pointer text-lg font-semibold">Erziehungsberechtigte</summary>
        <p class="mb-2 text-sm text-gray-500">Bei Minderjährigen, vor allem in der Jugend- und Kinderfeuerwehr. Sie unterschreiben Aufnahme und Übertritt.</p>
        <div class="grid gap-4 md:grid-cols-2">
            @for (var i = 0; i < 2; i++)
            {
                <fieldset class="grid gap-2 rounded border border-gray-200 p-3 sm:grid-cols-2">
                    <legend class="px-1 text-sm font-semibold">@(i + 1). Erziehungsberechtigte(r)</legend>
                    <div class="sm:col-span-2"><label asp-for="Formular.Erziehungsberechtigte[i].Verhaeltnis" class="etikett"></label><select asp-for="Formular.Erziehungsberechtigte[i].Verhaeltnis" asp-items="Html.GetEnumSelectList<Sorgeverhaeltnis>()" class="eingabe"><option value="">–</option></select></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Vorname" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Vorname" class="eingabe" /></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Nachname" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Nachname" class="eingabe" /><span asp-validation-for="Formular.Erziehungsberechtigte[i].Nachname" class="feldfehler"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Erziehungsberechtigte[i].Strasse" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Strasse" class="eingabe" /></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Plz" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Plz" class="eingabe" /></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Ort" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Ort" class="eingabe" /></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Telefon" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Telefon" class="eingabe" /><span asp-validation-for="Formular.Erziehungsberechtigte[i].Telefon" class="feldfehler"></span></div>
                    <div><label asp-for="Formular.Erziehungsberechtigte[i].Mobil" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Mobil" class="eingabe" /><span asp-validation-for="Formular.Erziehungsberechtigte[i].Mobil" class="feldfehler"></span></div>
                    <div class="sm:col-span-2"><label asp-for="Formular.Erziehungsberechtigte[i].Email" class="etikett"></label><input asp-for="Formular.Erziehungsberechtigte[i].Email" class="eingabe" /><span asp-validation-for="Formular.Erziehungsberechtigte[i].Email" class="feldfehler"></span></div>
                </fieldset>
            }
        </div>
    </details>

    @if (Model.IstNeu)
    {
        <div><label asp-for="Formular.AbteilungId" class="etikett"></label><select asp-for="Formular.AbteilungId" asp-items="Model.Abteilungen" class="eingabe"><option value="">bitte wählen</option></select><span asp-validation-for="Formular.AbteilungId" class="feldfehler"></span></div>
        <div><label asp-for="Formular.Eintritt" class="etikett"></label><input asp-for="Formular.Eintritt" type="date" class="eingabe" /></div>
    }

    <div class="flex gap-2 sm:col-span-2">
        <button type="submit" class="knopf">Speichern</button>
        @if (Model.Formular.Id is { } zurueck)
        {
            <a asp-page="Akte" asp-route-id="@zurueck" class="knopf-zweit">Abbrechen</a>
        }
        else
        {
            <a asp-page="Index" class="knopf-zweit">Abbrechen</a>
        }
    </div>
</form>

@if (Model.Verlauf.Count > 0)
{
    <section class="karte mt-6 max-w-3xl">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h2 class="text-lg font-semibold">Mitgliedschaften</h2>
            @if ((await Autorisierung.AuthorizeAsync(User, Berechtigungen.LaufbahnLesen)).Succeeded)
            {
                <a asp-page="/Laufbahn/Mitglied" asp-route-id="@Model.Formular.Id" class="text-sm font-medium text-feuer-700 hover:underline">Übertritt, Dienstgrade und Ehrungen ›</a>
            }
        </div>
        <table class="tabelle">
            <thead><tr><th>Abteilung</th><th>Status</th><th>Von</th><th>Bis</th><th>Probezeit bis</th></tr></thead>
            <tbody>
                @foreach (var m in Model.Verlauf)
                {
                    <tr><td>@m.Abteilung?.Bezeichnung</td><td>@Anzeige.Text(m.Status)</td><td>@Anzeige.Datum(m.GueltigAb)</td><td>@Anzeige.Datum(m.GueltigBis)</td><td>@Anzeige.Datum(m.ProbezeitBis)</td></tr>
                }
            </tbody>
        </table>
    </section>
}
