@page
@model Fevad.Web.Pages.Mitglieder.GruppenModel
@{
    ViewData["Title"] = "Gruppen";
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Mitglieder</a>
<h1 class="mb-2 mt-2 text-2xl font-bold">Gruppen</h1>
<p class="mb-4 text-sm text-gray-600">Gruppen dienen als Zielgruppe im Dienstplan, z. B. „Gruppe 1“ oder „Führungsgruppe“. Atemschutzgeräteträger und Maschinisten ergeben sich aus den Qualifikationen und müssen nicht als Gruppe gepflegt werden.</p>

<div class="grid gap-6 md:grid-cols-3">
    <div>
        <ul class="karte divide-y divide-gray-100 p-0">
            @foreach (var g in Model.Gruppen)
            {
                <li>
                    <a asp-route-id="@g.Id" class="flex justify-between px-4 py-2 hover:bg-gray-50 @(g.Id == Model.Auswahl?.Id ? "bg-feuer-50 font-semibold" : "") @(g.Aktiv ? "" : "text-gray-400")">
                        <span>@g.Bezeichnung</span><span class="text-sm text-gray-500">@g.Mitglieder</span>
                    </a>
                </li>
            }
            @if (Model.Gruppen.Count == 0)
            {
                <li class="px-4 py-2 text-sm text-gray-500">Noch keine Gruppen.</li>
            }
        </ul>
        @if (Model.DarfBearbeiten)
        {
            <form method="post" asp-page-handler="Anlegen" class="mt-3 flex gap-2">
                <input asp-for="Bezeichnung" class="eingabe" placeholder="Neue Gruppe" />
                <button type="submit" class="knopf">Anlegen</button>
            </form>
            <span asp-validation-for="Bezeichnung" class="feldfehler"></span>
        }
    </div>

    @if (Model.Auswahl is { } gruppe)
    {
        <form method="post" asp-page-handler="Zuordnen" asp-route-id="@gruppe.Id" class="karte md:col-span-2">
            <h2 class="mb-3 text-lg font-semibold">@gruppe.Bezeichnung</h2>
            <ul class="mb-4 grid gap-1 sm:grid-cols-2">
                @foreach (var k in Model.Kandidaten)
                {
                    <li>
                        <label class="flex items-center gap-2 rounded px-2 py-1 hover:bg-gray-50">
                            <input type="checkbox" name="mitglieder" value="@k.Id" checked="@k.Zugeordnet" disabled="@(!Model.DarfBearbeiten)" class="h-4 w-4" />
                            <span>@k.Name <span class="text-xs text-gray-500">@k.Abteilung</span></span>
                        </label>
                    </li>
                }
            </ul>
            @if (Model.DarfBearbeiten)
            {
                <label class="mb-3 flex items-center gap-2 text-sm">
                    <input type="checkbox" name="aktiv" value="true" checked="@gruppe.Aktiv" class="h-4 w-4" /> Gruppe aktiv (inaktive stehen nicht mehr zur Auswahl)
                </label>
                <input type="hidden" name="aktiv" value="false" />
                <button type="submit" class="knopf">Speichern</button>
            }
        </form>
    }
</div>
