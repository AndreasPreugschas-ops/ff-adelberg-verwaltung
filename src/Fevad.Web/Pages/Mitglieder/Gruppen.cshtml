@page
@using Fevad.Domain.Mitglieder
@model Fevad.Web.Pages.Mitglieder.GruppenModel
@{
    ViewData["Title"] = "Züge und Gruppen";
    var arten = Html.GetEnumSelectList<GruppeArt>();
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Mitglieder</a>
<h1 class="mb-2 mt-2 text-2xl font-bold">Züge und Gruppen</h1>
<p class="mb-4 text-sm text-gray-600">Untergliederung der Abteilungen, z. B. „Zug 1“ mit „Gruppe 1“ in der Einsatzabteilung oder Jugendgruppen. Sie dienen auch als Zielgruppe im Dienstplan. Ohne Abteilung gilt eine Gruppe abteilungsübergreifend (z. B. „Führungsgruppe“). Atemschutzgeräteträger und Maschinisten ergeben sich aus den Qualifikationen.</p>

<div class="grid gap-6 md:grid-cols-3">
    <div>
        <ul class="karte divide-y divide-gray-100 p-0">
            @foreach (var g in Model.Gruppen)
            {
                <li>
                    <a asp-route-id="@g.Id" class="flex justify-between gap-2 px-4 py-2 hover:bg-gray-50 @(g.Id == Model.Auswahl?.Id ? "bg-feuer-50 font-semibold" : "") @(g.Aktiv ? "" : "text-gray-400")">
                        <span class="@(g.Zug is null ? "" : "pl-4")">
                            @g.Bezeichnung
                            <span class="block text-xs font-normal text-gray-500">@Anzeige.Text(g.Art) · @(g.Abteilung ?? "alle Abteilungen")@(g.Zug is null ? "" : $" · {g.Zug}")</span>
                        </span>
                        <span class="text-sm text-gray-500">@g.Mitglieder</span>
                    </a>
                </li>
            }
            @if (Model.Gruppen.Count == 0)
            {
                <li class="px-4 py-2 text-sm text-gray-500">Noch keine Züge oder Gruppen.</li>
            }
        </ul>
        @if (Model.DarfBearbeiten && Model.Auswahl is null)
        {
            <form method="post" asp-page-handler="Anlegen" class="karte mt-3 space-y-2">
                <h2 class="font-semibold">Neu anlegen</h2>
                <partial name="_Gliederung" model="Model" />
                <button type="submit" class="knopf">Anlegen</button>
            </form>
        }
        else if (Model.DarfBearbeiten)
        {
            <a asp-route-id="" class="knopf-zweit mt-3 inline-block">Neuen Zug oder neue Gruppe anlegen</a>
        }
    </div>

    @if (Model.Auswahl is { } gruppe)
    {
        <form method="post" asp-page-handler="Zuordnen" asp-route-id="@gruppe.Id" class="karte md:col-span-2">
            <h2 class="mb-3 text-lg font-semibold">@gruppe.Bezeichnung</h2>
            @if (Model.DarfBearbeiten)
            {
                <div class="mb-4 grid gap-2 sm:grid-cols-2">
                    <partial name="_Gliederung" model="Model" />
                </div>
            }
            <ul class="mb-4 grid gap-1 sm:grid-cols-2">
                @foreach (var k in Model.Kandidaten)
                {
                    <li>
                        <label class="flex items-center gap-2 rounded px-2 py-1 hover:bg-gray-50">
                            <input type="checkbox" name="mitglieder" value="@k.Id" checked="@k.Zugeordnet" disabled="@(!Model.DarfBearbeiten)" class="h-4 w-4" />
                            <span>@k.Name <span class="text-xs text-gray-500">@k.Abteilung</span></span>
                        </label>
                    </li>
                }
                @if (Model.Kandidaten.Count == 0)
                {
                    <li class="text-sm text-gray-500">Keine aktuellen Mitglieder in dieser Abteilung.</li>
                }
            </ul>
            @if (Model.DarfBearbeiten)
            {
                <label class="mb-3 flex items-center gap-2 text-sm">
                    <input type="checkbox" name="aktiv" value="true" checked="@gruppe.Aktiv" class="h-4 w-4" /> aktiv (inaktive stehen nicht mehr zur Auswahl)
                </label>
                <input type="hidden" name="aktiv" value="false" />
                <button type="submit" class="knopf">Speichern</button>
            }
        </form>
    }
</div>
