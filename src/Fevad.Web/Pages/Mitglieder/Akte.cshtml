@page "{id:guid}"
@model Fevad.Web.Pages.Mitglieder.AkteModel
@using Fevad.Domain.Mitglieder
@{
    var m = Model.Mitglied;
    var heute = Model.Heute;
    ViewData["Title"] = m.Anzeigename;
    var aktuell = m.Mitgliedschaften.Where(s => !s.Vordienstzeit && s.GueltigAb <= heute && (s.GueltigBis == null || s.GueltigBis >= heute)).ToList();
    var dienstgrad = m.AktuellerDienstgrad(heute);
    var funktionen = m.Funktionen.OrderByDescending(f => f.GueltigBis == null).ThenByDescending(f => f.GueltigAb).ToList();
    var s = Model.Laufbahn;
    var offen = Model.Fristen.Where(f => f.Ampel != Fevad.Domain.Gemeinsam.Fristampel.Gruen || f.FaelligAm is null).ToList();
}
<a asp-page="Index" class="text-sm text-feuer-700 hover:underline">← Mitglieder</a>
@if (TempData["Einrichtungslink"] is string einrichtungslink)
{
    <section class="my-4 max-w-3xl rounded-md border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-900" x-data="{ kopiert: false }">
        <p class="mb-2 font-semibold">Elternkonto: Link zum Festlegen des Passworts (gültig bis @TempData["EinrichtungslinkBis"] Uhr, nur einmal verwendbar)</p>
        <div class="flex flex-wrap gap-2">
            <input type="text" readonly value="@einrichtungslink" class="eingabe min-w-0 flex-1 font-mono text-xs" x-ref="link" x-on:focus="$el.select()" />
            <button type="button" class="knopf-zweit" x-on:click="navigator.clipboard.writeText($refs.link.value); kopiert = true" x-text="kopiert ? 'Kopiert' : 'Kopieren'">Kopieren</button>
        </div>
        <p class="mt-2">Den Link nur dem Elternteil selbst geben. Er wird nur jetzt angezeigt.</p>
    </section>
}
<h1 class="mb-1 mt-2 text-2xl font-bold">@m.Anzeigename <span class="text-base font-normal text-gray-500">Nr. @m.Personalnummer</span></h1>
<p class="mb-3 text-sm text-gray-600">
    @(string.Join(" · ", aktuell.Select(a => $"{a.Abteilung!.Bezeichnung} ({Anzeige.Text(a.Status)})")) is { Length: > 0 } t ? t : "derzeit in keiner Abteilung")
    @if (dienstgrad is not null) { <text> · @dienstgrad.Dienstgrad!.Bezeichnung</text> }
    · @m.AlterAm(heute) Jahre
</p>
<partial name="_Mitgliedreiter" model='(m.Id, "Übersicht")' />

@if (s is not null && (s.Befoerderung is not null || s.Ehrungsvorschlaege.Count > 0 || s.Hinweise.Count > 0) || offen.Count > 0 || Model.OffeneLehrgaenge.Count > 0 || Model.Funktionshinweise.Count > 0 || Model.Volljaehrigkeit is not null)
{
    <section class="karte mb-4 border-l-4 border-l-yellow-400">
        <h2 class="mb-2 font-semibold">Offene Punkte</h2>
        <ul class="space-y-1 text-sm">
            @if (s?.Befoerderung is { } b)
            {
                <li><span class="ampel-gelb">Beförderung</span> @b.Dienstgrad.Bezeichnung möglich ab @Anzeige.Datum(b.MoeglichAb) (@b.Weg.Bezeichnung)</li>
            }
            @foreach (var e in s?.Ehrungsvorschlaege ?? [])
            {
                <li><span class="ampel-gelb">Ehrung</span> @e.Ehrungsart (@e.Jahre Jahre) erreicht am @Anzeige.Datum(e.ErreichtAm)</li>
            }
            @foreach (var h in s?.Hinweise ?? [])
            {
                <li><partial name="_Ampel" model="h.Ampel(heute)" /> @h.Text (@Anzeige.Datum(h.FaelligAm))</li>
            }
            @foreach (var f in Model.Funktionshinweise)
            {
                <li><span class="ampel-rot">Funktion</span> @f.Text</li>
            }
            @if (Model.Volljaehrigkeit is { } v)
            {
                <li><span class="ampel-gelb">Volljährigkeit</span> @v.Text <a asp-page="/Antraege/Index" asp-route-mitglied="@m.Id" class="text-feuer-700 hover:underline">Anträge</a></li>
            }
            @foreach (var lg in Model.OffeneLehrgaenge)
            {
                var stand = lg.Stand(heute);
                <li>
                    <span class="@(stand == Fevad.Domain.Ausbildung.LehrgangStand.ErgebnisFehlt ? "ampel-rot" : "ampel-gelb")">Lehrgang</span>
                    @lg.Qualifikation?.Bezeichnung: @Anzeige.Text(stand)
                    @(lg.Von is null && lg.Bis is null ? (lg.ZugewiesenAm is { } z ? $"am {Anzeige.Datum(z)}" : lg.AngemeldetAm is { } a ? $"am {Anzeige.Datum(a)}" : "") : Anzeige.Zeitraum(lg.Von, lg.Bis))
                    @if (Model.Rechte.Qualifikationen)
                    {
                        <a asp-page="/Personal/Lehrgang" asp-route-mitgliedId="@m.Id" asp-route-id="@lg.Id" class="text-sm font-semibold text-feuer-700 hover:underline">fortschreiben</a>
                    }
                </li>
            }
            @foreach (var f in offen)
            {
                <li><partial name="_FristStatus" model="f" /> @f.Bezeichnung @(f.FaelligAm is null ? "" : $"fällig {Anzeige.Datum(f.FaelligAm)}") <partial name="_Verlaengern" model="(f, Model.Rechte)" /></li>
            }
        </ul>
    </section>
}

<div class="grid gap-4 lg:grid-cols-2">
    <section class="karte">
        <h2 class="mb-2 font-semibold">Person</h2>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
            <dt class="text-gray-500">Geboren</dt><dd>@Anzeige.Datum(m.Geburtsdatum)</dd>
            <dt class="text-gray-500">Geschlecht</dt><dd>@(m.Geschlecht is null ? "–" : Anzeige.Text(m.Geschlecht))</dd>
            <dt class="text-gray-500">Anschrift</dt><dd>@(string.Join(", ", new[] { m.Strasse, $"{m.Plz} {m.Ort}".Trim() }.Where(x => !string.IsNullOrWhiteSpace(x))) is { Length: > 0 } adr ? adr : "–")</dd>
            <dt class="text-gray-500">Mobil</dt><dd>@(m.TelefonMobil ?? "–")</dd>
            <dt class="text-gray-500">Telefon</dt><dd>@(m.TelefonFestnetz ?? "–")</dd>
            <dt class="text-gray-500">E-Mail</dt><dd>@(m.Email ?? "–")</dd>
            <dt class="text-gray-500">Fotos</dt>
            <dd>@(m.FotoEinwilligung ? $"Einwilligung seit {Anzeige.Datum(m.FotoEinwilligungAm)}" : m.FotoWiderrufAm is { } widerruf ? $"widerrufen am {Anzeige.Datum(widerruf)}" : "keine Einwilligung")</dd>
            @if (Model.ArbeitgeberSichtbar)
            {
                <dt class="text-gray-500">Beruf</dt><dd>@(m.Beruf ?? "–")</dd>
                <dt class="text-gray-500">Arbeitgeber</dt><dd>@(m.Arbeitgeber ?? "–")@(m.Arbeitsort is null ? "" : $", {m.Arbeitsort}")@(m.ArbeitgeberTelefon is null ? "" : $", {m.ArbeitgeberTelefon}")</dd>
            }
            @if (Model.Gruppen.Count > 0)
            {
                <dt class="text-gray-500">Zug, Gruppe</dt><dd>@string.Join(", ", Model.Gruppen)</dd>
            }
        </dl>
        @if (Model.FruehereAnschriften.Count > 0)
        {
            <details class="mt-3 text-sm">
                <summary class="cursor-pointer font-semibold">Frühere Anschriften (@Model.FruehereAnschriften.Count)</summary>
                <ul class="mt-1 space-y-1">
                    @foreach (var a in Model.FruehereAnschriften)
                    {
                        <li><span class="text-gray-500">@Anzeige.Text(a.Art), bis @Anzeige.Datum(a.BisDatum):</span> @a.Zeile</li>
                    }
                </ul>
                <p class="mt-1 text-xs text-gray-500">Werden nach Ablauf der Löschfrist automatisch entfernt.</p>
            </details>
        }
        @if (Model.Erziehungsberechtigte.Count > 0)
        {
            <h3 class="mb-1 mt-3 text-sm font-semibold">Erziehungsberechtigte</h3>
            <ul class="space-y-1 text-sm">
                @foreach (var e in Model.Erziehungsberechtigte)
                {
                    <li>
                        @e.Anzeigename@(e.Verhaeltnis is null ? "" : $" ({Anzeige.Text(e.Verhaeltnis)})") · @(string.Join(" · ", new[] { e.Mobil, e.Telefon, e.Email }.Where(x => x is not null)))
                        @if (e.KontoId is not null)
                        {
                            <span class="ampel-gruen">Elternkonto seit @Anzeige.DatumZeit(e.KontoZugeordnetAm)</span>
                        }
                        else if (e.KeineKontozuordnung)
                        {
                            <span class="ampel-rot">kein Elternkonto (Sperre)</span>
                        }
                    </li>
                }
            </ul>
        }
    </section>

    <section class="karte">
        <h2 class="mb-2 font-semibold">Jugendfeuerwehr</h2>
        @if (Model.Jugend.Eintritt is null)
        {
            <p class="text-sm text-gray-600">Keine Jugendfeuerwehr.</p>
        }
        else
        {
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-gray-500">Eintritt</dt><dd>@Anzeige.Datum(Model.Jugend.Eintritt)</dd>
                <dt class="text-gray-500">Austritt</dt><dd>@(Model.Jugend.NochDabei ? "noch dabei" : $"{Anzeige.Datum(Model.Jugend.Austritt)}{(Model.Jugend.Grund is null ? "" : $" ({Anzeige.Text(Model.Jugend.Grund)})")}")</dd>
                <dt class="text-gray-500">Leistungsspange</dt><dd>@(Model.Jugend.Leistungsspange is null ? "nein" : Anzeige.Datum(Model.Jugend.Leistungsspange))</dd>
            </dl>
        }
        @if (s is not null)
        {
            <h2 class="mb-2 mt-4 font-semibold">Dienstzeit</h2>
            <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1 text-sm">
                <dt class="text-gray-500">Einsatzdienst</dt><dd>@s.Einsatzdienst.VolleJahreBis(heute) Jahre (für das Ehrenzeichen)</dd>
                <dt class="text-gray-500">Zugehörigkeit</dt><dd>@s.Zugehoerigkeit.VolleJahreBis(heute) Jahre</dd>
            </dl>
        }
        @if (Model.Dienste is { } d)
        {
            <p class="mt-3 text-sm">Dienste besucht: <strong>@d.DiesesJahr</strong> in @heute.Year, @d.Vorjahr in @(heute.Year - 1)</p>
        }
    </section>

    <section class="karte overflow-x-auto">
        <h2 class="mb-2 font-semibold">Abteilungen</h2>
        <table class="tabelle text-sm">
            <thead><tr><th>Abteilung</th><th>Status</th><th>Von</th><th>Bis</th><th>Probezeit bis</th></tr></thead>
            <tbody>
                @foreach (var a in m.Mitgliedschaften.OrderByDescending(x => x.GueltigAb))
                {
                    <tr>
                        <td>@a.Abteilung!.Bezeichnung@(a.Vordienstzeit ? " (Vordienstzeit)" : "")</td>
                        <td>@Anzeige.Text(a.Status)</td>
                        <td>@Anzeige.Datum(a.GueltigAb)</td>
                        <td>@Anzeige.Datum(a.GueltigBis)@(a.Austrittsgrund is null ? "" : $" ({Anzeige.Text(a.Austrittsgrund)})")</td>
                        <td>@Anzeige.Datum(a.ProbezeitBis)</td>
                    </tr>
                }
            </tbody>
        </table>
    </section>

    <section class="karte overflow-x-auto">
        <h2 class="mb-2 font-semibold">Funktionen</h2>
        @if (funktionen.Count == 0)
        {
            <p class="text-sm text-gray-600">Keine Funktionen.</p>
        }
        else
        {
            <table class="tabelle text-sm">
                <thead><tr><th>Funktion</th><th>Abteilung</th><th>Von</th><th>Bis</th></tr></thead>
                <tbody>
                    @foreach (var f in funktionen)
                    {
                        <tr class="@(f.GueltigBis is { } bis && bis < heute ? "text-gray-400" : "")"><td>@f.Funktion!.Bezeichnung@if (f.Funktion.Grundlage is not null) { <span class="block text-xs text-gray-500">@f.Funktion.Grundlage</span> }</td><td>@(f.Abteilung?.Bezeichnung ?? "–")</td><td>@Anzeige.Datum(f.GueltigAb)</td><td>@Anzeige.Datum(f.GueltigBis)</td></tr>
                    }
                </tbody>
            </table>
        }
    </section>

    @if (s is not null)
    {
        <section class="karte overflow-x-auto">
            <h2 class="mb-2 font-semibold">Dienstgrade</h2>
            <table class="tabelle text-sm">
                <thead><tr><th>Dienstgrad</th><th>Ab</th></tr></thead>
                <tbody>
                    @foreach (var g in m.Dienstgrade.OrderByDescending(x => x.Ab))
                    {
                        <tr><td>@g.Dienstgrad!.Bezeichnung</td><td>@Anzeige.Datum(g.Ab)</td></tr>
                    }
                    @if (m.Dienstgrade.Count == 0)
                    {
                        <tr><td colspan="2" class="text-gray-500">Noch kein Dienstgrad erfasst.</td></tr>
                    }
                </tbody>
            </table>
        </section>

        <section class="karte overflow-x-auto">
            <h2 class="mb-2 font-semibold">Ehrungen</h2>
            <table class="tabelle text-sm">
                <thead><tr><th>Ehrung</th><th>Status</th><th>Verliehen</th></tr></thead>
                <tbody>
                    @foreach (var e in Model.Ehrungen)
                    {
                        <tr><td>@e.Ehrungsart!.Bezeichnung</td><td>@Anzeige.Text(e.Status)</td><td>@Anzeige.Datum(e.VerliehenAm)</td></tr>
                    }
                    @if (Model.Ehrungen.Count == 0)
                    {
                        <tr><td colspan="3" class="text-gray-500">Keine Ehrungen erfasst.</td></tr>
                    }
                </tbody>
            </table>
        </section>
    }

    @if (Model.Qualifikationen.Count > 0 || Model.Fristen.Count > 0)
    {
        <section class="karte overflow-x-auto lg:col-span-2">
            <h2 class="mb-2 font-semibold">Lehrgänge, Abzeichen und Fahrerlaubnisse</h2>
            <table class="tabelle text-sm">
                <thead><tr><th>Qualifikation</th><th>Art</th><th>Erworben</th><th>Gültig bis</th></tr></thead>
                <tbody>
                    @foreach (var q in Model.Qualifikationen)
                    {
                        <tr><td>@q.Qualifikation!.Bezeichnung</td><td>@Anzeige.Text(q.Qualifikation.Art)</td><td>@Anzeige.Datum(q.ErworbenAm)</td><td>@(q.GueltigBis is null ? "unbefristet" : Anzeige.Datum(q.GueltigBis))</td></tr>
                    }
                </tbody>
            </table>
            @if (Model.AtemschutzSichtbar && Model.Vorsorge is { } v)
            {
                <p class="mt-3 text-sm">Atemschutz-Vorsorge: @Anzeige.Text(v.Ergebnis), nächste fällig @Anzeige.Datum(v.NaechsteFaellig)</p>
            }
        </section>
    }
</div>
