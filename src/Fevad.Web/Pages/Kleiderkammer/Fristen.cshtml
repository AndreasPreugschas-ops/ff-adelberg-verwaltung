@page
@model Fevad.Web.Pages.Kleiderkammer.FristenModel
@{
    ViewData["Title"] = "Kleiderkammer · Prüffristen";
    ViewData["Bereich"] = "Fristen";
}
<h1 class="mb-2 text-2xl font-semibold">Kleiderkammer</h1>
<partial name="_Navigation" />

<p class="mb-4 max-w-3xl text-sm text-gray-600">
    Prüfungen werden wie bei Geräten erfasst. Die Lebensdauer rechnet ab Herstelldatum mit der Nutzungsdauer der Geräteart.
</p>

<form method="get" class="mb-4 flex flex-wrap items-center gap-2">
    <input name="Suche" value="@Model.Suche" placeholder="Inventarnummer, Artikel, Größe, Träger" class="eingabe max-w-xs" autocomplete="off" />
    <label class="flex items-center gap-1 text-sm"><input type="checkbox" name="NurFaellige" value="true" checked="@Model.NurFaellige" class="h-4 w-4" onchange="this.form.submit()" /> nur fällige</label>
    <button type="submit" class="knopf-zweit">Suchen</button>
</form>

@if (Model.Zeilen.Count == 0)
{
    <p class="karte text-sm text-gray-500">@(string.IsNullOrWhiteSpace(Model.Suche) && !Model.NurFaellige ? "Keine Einzelstücke erfasst." : "Keine Einzelstücke gefunden.")</p>
}
else
{
    <div class="karte p-0">
        <div class="overflow-x-auto">
        <table class="tabelle">
            <thead><tr><th>Inventarnummer</th><th>Artikel</th><th>Bei</th><th>Zustand</th><th>Prüfung und Lebensdauer</th></tr></thead>
            <tbody>
                @foreach (var p in Model.Zeilen.Eintraege)
                {
                    <tr>
                        <td class="whitespace-nowrap">
                            @if (Model.DarfTechnik)
                            {
                                <a asp-page="/Technik/Geraete/Details" asp-route-id="@p.Stand.Id" class="font-mono font-bold text-feuer-700 hover:underline" title="Gerät in der Technik öffnen">@p.Stand.Nummer</a>
                            }
                            else
                            {
                                <span class="font-mono font-bold">@p.Stand.Nummer</span>
                            }
                        </td>
                        <td><a asp-page="ArtikelBearbeiten" asp-route-id="@p.ArtikelId" class="text-feuer-700 hover:underline">@p.Artikel</a>@(p.Groesse is null ? "" : $", Größe {p.Groesse}")</td>
                        <td>
                            @if (p.MitgliedId is { } id)
                            {
                                <a asp-page="Mitglied" asp-route-id="@id" class="text-feuer-700 hover:underline">@p.Traeger</a>
                            }
                            else
                            {
                                <span class="text-gray-500">Lager</span>
                            }
                        </td>
                        <td>@Anzeige.Text(p.Stand.Zustand)</td>
                        <td>
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                <partial name="_Ampel" model="p.Stand.Ampel" />
                                <span class="text-xs text-gray-600">Prüfung @(p.Stand.NieGeprueft ? "noch nie" : Anzeige.Datum(p.Stand.NaechsterTermin))@if (p.Stand.AussonderungFaellig is { } bis) {<text> · Lebensdauer bis @Anzeige.Datum(bis)</text>}</span>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        </div>
        <partial name="_Blaettern" model="Model.Zeilen" />
    </div>
}
