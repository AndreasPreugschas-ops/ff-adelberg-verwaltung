@page "{id:guid}"
@model Fevad.Web.Pages.Kleiderkammer.MitgliedModel
@using Fevad.Domain.Kleiderkammer
@{
    ViewData["Title"] = $"Ausstattung {Model.Name}";
    ViewData["Bereich"] = "Mitglieder";
}
<h1 class="mb-2 text-2xl font-bold">Kleiderkammer</h1>
<partial name="_Navigation" />

<partial name="_Mitgliedreiter" model='(Model.Id, "Ausrüstung")' />
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h2 class="text-xl font-semibold">@Model.Name <span class="text-sm font-normal text-gray-500">Nr. @Model.Personalnummer</span></h2>
    @if (Model.DarfBearbeiten)
    {
        <a asp-page="Ausgabe" asp-route-id="@Model.Id" class="knopf">Ausgabe</a>
    }
</div>

<div class="grid gap-6">
    <section class="karte">
        <h3 class="mb-2 font-semibold">Größen</h3>
        <form method="post" asp-page-handler="Groessen" asp-route-id="@Model.Id" class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
            @foreach (var art in Enum.GetValues<Groessenart>().Where(a => a != Groessenart.Einheitsgroesse))
            {
                <div>
                    <label class="etikett" for="groesse-@art">@Anzeige.Text(art)</label>
                    <input id="groesse-@art" name="Groessen[@art]" value="@Model.Groessen.GetValueOrDefault(art)" class="eingabe" maxlength="20" disabled="@(!Model.DarfBearbeiten)" />
                </div>
            }
            @if (Model.DarfBearbeiten)
            {
                <div class="col-span-2 sm:col-span-3 lg:col-span-6"><button type="submit" class="knopf-zweit">Größen speichern</button></div>
            }
        </form>
    </section>

    <section class="karte overflow-x-auto">
        <h3 class="mb-2 font-semibold">Aktuelle Ausstattung</h3>
        @if (Model.Ausstattung.Count == 0)
        {
            <p class="text-sm text-gray-500">Nichts ausgegeben.</p>
        }
        else
        {
            <form method="post" asp-page-handler="Ruecknahme" asp-route-id="@Model.Id">
                <table class="tabelle">
                    <thead>
                        <tr>
                            @if (Model.DarfBearbeiten) { <th>Rückgabe</th> }
                            <th>Artikel</th><th>Größe</th><th class="text-right">Menge</th><th>Ausgegeben</th><th>Nächste Prüfung</th><th>Aussonderung</th><th>Fristen</th>
                            @if (Model.DarfBearbeiten) { <th>Zustand</th> }
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < Model.Ausstattung.Count; i++)
                        {
                            var a = Model.Ausstattung[i];
                            <tr>
                                @if (Model.DarfBearbeiten)
                                {
                                    <td>
                                        <input type="hidden" name="Ruecknahme[@i].AusstattungId" value="@a.Id" />
                                        <input type="checkbox" name="Ruecknahme[@i].Gewaehlt" value="true" aria-label="@a.Artikel zurücknehmen" />
                                    </td>
                                }
                                <td>@a.Artikel @if (a.Inventarnummer is not null) { <span class="text-xs text-gray-500">@a.Inventarnummer</span> }</td>
                                <td>@(a.Groesse.Length == 0 ? "–" : a.Groesse)</td>
                                <td class="text-right">
                                    @if (Model.DarfBearbeiten && a.Menge > 1)
                                    {
                                        <input type="number" name="Ruecknahme[@i].Menge" value="@a.Menge" min="1" max="@a.Menge" class="eingabe w-20 text-right" aria-label="Rückgabemenge" />
                                    }
                                    else
                                    {
                                        <input type="hidden" name="Ruecknahme[@i].Menge" value="@a.Menge" />
                                        @a.Menge
                                    }
                                </td>
                                <td>@Anzeige.Datum(a.AusgegebenAm)</td>
                                <td>@(a.NieGeprueft ? "noch nie geprüft" : Anzeige.Datum(a.NaechstePruefung))</td>
                                <td>@Anzeige.Datum(a.Aussonderung)</td>
                                <td>@if (a.Ampel is { } ampel) { <partial name="_Ampel" model="ampel" /> } else { <span>–</span> }</td>
                                @if (Model.DarfBearbeiten)
                                {
                                    <td>
                                        <select name="Ruecknahme[@i].Zustand" class="eingabe" aria-label="Zustand bei Rückgabe">
                                            @foreach (var z in Enum.GetValues<RuecknahmeZustand>())
                                            {
                                                <option value="@z">@Anzeige.Text(z)</option>
                                            }
                                        </select>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Model.DarfBearbeiten)
                {
                    <div class="mt-3 flex flex-wrap items-end gap-2">
                        <div class="grow"><label class="etikett" for="bemerkung">Bemerkung zur Rücknahme</label><input id="bemerkung" name="Bemerkung" class="eingabe" /></div>
                        <button type="submit" class="knopf-zweit">Gewählte zurücknehmen</button>
                    </div>
                }
            </form>
        }
    </section>
</div>

<section class="karte mt-6 overflow-x-auto">
    <h3 class="mb-2 font-semibold">Quittungen</h3>
    @if (Model.Vorgaenge.Count == 0)
    {
        <p class="text-sm text-gray-500">Noch keine Ausgabe oder Rücknahme.</p>
    }
    else
    {
        <table class="tabelle">
            <thead><tr><th>Nummer</th><th>Art</th><th>Zeitpunkt</th><th>Unterschrift</th></tr></thead>
            <tbody>
                @foreach (var v in Model.Vorgaenge)
                {
                    <tr>
                        <td><a asp-page="Quittung" asp-route-id="@v.Id" class="font-medium text-feuer-700 hover:underline">@v.Nummer</a></td>
                        <td>@Anzeige.Text(v.Art)</td>
                        <td>@Anzeige.DatumZeit(v.Zeitpunkt)</td>
                        <td>@(v.QuittiertAm is null ? "offen" : $"liegt vor ({Anzeige.DatumZeit(v.QuittiertAm)})")</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</section>
