@page "{id:guid}"
@model Fevad.Web.Pages.Kleiderkammer.MitgliedModel
@using Fevad.Domain.Kleiderkammer
@{
    ViewData["Title"] = $"Ausrüstung {Model.Name}";
    ViewData["Bereich"] = "Mitglieder";
    var einzel = Model.Einzelstuecke.ToList();
    var kleidung = Model.Kleidung.ToList();
    var faellig = einzel.Count(e => e.Ampel is Fevad.Domain.Gemeinsam.Fristampel.Rot or Fevad.Domain.Gemeinsam.Fristampel.Gelb);
    var offeneQuittungen = Model.Vorgaenge.Count(v => v.QuittiertAm is null);
    var tausch = Model.Ausstattung.Count(a => a.TauschOffen);
}
<h1 class="mb-2 text-2xl font-semibold">Kleiderkammer</h1>
<partial name="_Navigation" />

<partial name="_Mitgliedreiter" model='(Model.Id, "Ausrüstung")' />
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <div>
        <h2 class="text-xl font-semibold">@Model.Name <span class="text-sm font-normal text-gray-500">Nr. @Model.Personalnummer</span></h2>
        <p class="text-sm text-gray-600">
            @Model.Ausstattung.Sum(a => a.Menge) Stück ausgegeben, davon @einzel.Count mit Inventarnummer
            @if (faellig > 0) { <text> · <span class="ampel-gelb">@faellig Frist@(faellig == 1 ? "" : "en") offen</span></text> }
            @if (offeneQuittungen > 0) { <text> · @offeneQuittungen Quittung@(offeneQuittungen == 1 ? "" : "en") offen</text> }
            @if (tausch > 0) { <text> · <a asp-page="Tausch" class="text-feuer-700 hover:underline">@tausch Tausch angefordert</a></text> }
        </p>
    </div>
    @if (Model.DarfBearbeiten)
    {
        <div class="flex flex-wrap gap-2">
            <a asp-page="Ausgabe" asp-route-id="@Model.Id" class="knopf">Ausgabe</a>
            @if (Model.Ausstattung.Count > 0)
            {
                <a asp-page="Ruecknahme" asp-route-id="@Model.Id" class="knopf-zweit">Rücknahme</a>
            }
        </div>
    }
</div>

<div class="grid gap-6">
    <section class="karte">
        <h3 class="mb-2 font-semibold">Schutzausrüstung mit Inventarnummer</h3>
        @if (einzel.Count == 0)
        {
            <p class="text-sm text-gray-500">Kein Einzelstück ausgegeben.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="tabelle">
                    <thead><tr><th>Inventarnummer</th><th>Artikel</th><th>Ausgegeben</th><th>Prüfung und Lebensdauer</th></tr></thead>
                    <tbody>
                        @foreach (var a in einzel)
                        {
                            <tr>
                                <td class="whitespace-nowrap">
                                    @if (Model.DarfTechnik)
                                    {
                                        <a asp-page="/Technik/Geraete/Details" asp-route-id="@a.GeraetId" class="rounded bg-gray-100 px-1.5 py-0.5 font-mono font-bold tracking-wide text-feuer-700 hover:underline" title="Gerät in der Technik öffnen">@a.Inventarnummer</a>
                                    }
                                    else
                                    {
                                        <span class="rounded bg-gray-100 px-1.5 py-0.5 font-mono font-bold tracking-wide">@a.Inventarnummer</span>
                                    }
                                </td>
                                <td>@a.Artikel@(a.Groesse.Length == 0 ? "" : $", Größe {a.Groesse}")@if (a.TauschOffen) {<span class="ml-1 ampel-gelb">Tausch</span>}</td>
                                <td class="whitespace-nowrap">@Anzeige.Datum(a.AusgegebenAm)</td>
                                <td><partial name="_Ausruestungsfrist" model="a" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="karte">
        <h3 class="mb-2 font-semibold">Kleidung und weitere Ausstattung</h3>
        @if (kleidung.Count == 0)
        {
            <p class="text-sm text-gray-500">Nichts ausgegeben.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="tabelle">
                    <thead><tr><th>Artikel</th><th>Größe</th><th class="text-right">Menge</th><th>Ausgegeben</th></tr></thead>
                    <tbody>
                        @foreach (var a in kleidung)
                        {
                            <tr>
                                <td>@a.Artikel@if (a.TauschOffen) {<span class="ml-1 ampel-gelb">Tausch</span>}</td>
                                <td>@(a.Groesse.Length == 0 ? "–" : a.Groesse)</td>
                                <td class="text-right">@a.Menge</td>
                                <td class="whitespace-nowrap">@Anzeige.Datum(a.AusgegebenAm)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <section class="karte">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-semibold">Größen</h3>
            @if (Model.DarfBearbeiten)
            {
                <button type="button" class="text-sm font-semibold text-feuer-700 hover:underline" data-dialog="dialog-groessen">ändern</button>
            }
        </div>
        <dl class="grid grid-cols-2 gap-x-4 gap-y-1 text-sm sm:grid-cols-3 lg:grid-cols-6 @(Model.DarfBearbeiten ? "cursor-pointer" : "")"
            data-dialog="@(Model.DarfBearbeiten ? "dialog-groessen" : null)" title="@(Model.DarfBearbeiten ? "Klicken zum Ändern" : null)">
            @foreach (var art in Enum.GetValues<Groessenart>().Where(a => a != Groessenart.Einheitsgroesse))
            {
                <div><dt class="text-gray-500">@Anzeige.Text(art)</dt><dd>@(Model.Groessen.GetValueOrDefault(art) is { Length: > 0 } wert ? wert : "–")</dd></div>
            }
        </dl>
    </section>

    @if (Model.DarfBearbeiten)
    {
        <dialog id="dialog-groessen" class="dialog" aria-labelledby="dialog-groessen-titel">
            <form method="post" asp-page-handler="Groessen" asp-route-id="@Model.Id">
                <div class="dialog-kopf">
                    <h2 id="dialog-groessen-titel" class="font-semibold">Größen: @Model.Name</h2>
                    <button type="button" class="text-xl leading-none text-gray-500 hover:text-gray-800" data-dialog-schliessen aria-label="Schließen">×</button>
                </div>
                <div class="dialog-inhalt">
                    @foreach (var art in Enum.GetValues<Groessenart>().Where(a => a != Groessenart.Einheitsgroesse))
                    {
                        <div>
                            <label class="etikett" for="groesse-@art">@Anzeige.Text(art)</label>
                            <input id="groesse-@art" name="Groessen[@art]" value="@Model.Groessen.GetValueOrDefault(art)" class="eingabe" maxlength="20" />
                        </div>
                    }
                </div>
                <div class="dialog-fuss">
                    <button type="button" class="knopf-zweit" data-dialog-schliessen>Abbrechen</button>
                    <button type="submit" class="knopf">Speichern</button>
                </div>
            </form>
        </dialog>
    }

    <section class="karte">
        <div class="mb-2 flex flex-wrap items-center justify-between gap-2">
            <h3 class="font-semibold">Quittungen</h3>
            <a asp-page="Vorgaenge" class="text-sm text-feuer-700 hover:underline">Alle Ausgaben und Rückgaben</a>
        </div>
        @if (Model.Vorgaenge.Count == 0)
        {
            <p class="text-sm text-gray-500">Noch keine Ausgabe oder Rücknahme.</p>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="tabelle">
                    <thead><tr><th>Nummer</th><th>Art</th><th>Zeitpunkt</th><th>Unterschrift</th></tr></thead>
                    <tbody>
                        @foreach (var v in Model.Vorgaenge)
                        {
                            <tr>
                                <td class="whitespace-nowrap"><a asp-page="Quittung" asp-route-id="@v.Id" class="font-medium text-feuer-700 hover:underline">@v.Nummer</a></td>
                                <td>@Anzeige.Text(v.Art)</td>
                                <td class="whitespace-nowrap">@Anzeige.DatumZeit(v.Zeitpunkt)</td>
                                <td>@(v.QuittiertAm is null ? "offen" : $"{(v.QuittiertDigital ? "in FEVAD bestätigt" : "liegt vor")} ({Anzeige.DatumZeit(v.QuittiertAm)})")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>
</div>
