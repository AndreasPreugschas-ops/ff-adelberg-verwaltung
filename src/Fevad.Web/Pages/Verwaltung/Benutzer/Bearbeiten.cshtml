@page "{id:guid?}"
@model Fevad.Web.Pages.Verwaltung.Benutzer.BearbeitenModel
@{
    ViewData["Title"] = Model.IstNeu ? "Neues Konto" : Model.Formular.Email;
    var konto = Model.Vorhanden;
}
<h1 class="mb-4 text-2xl font-bold">@ViewData["Title"]</h1>

@if (Model.Einrichtungslink is not null)
{
    <section class="mb-6 max-w-3xl rounded-md border border-yellow-200 bg-yellow-50 p-4 text-sm text-yellow-900" x-data="{ kopiert: false }">
        <p class="mb-2 font-semibold">Link zum Festlegen des Passworts (gültig bis @Model.EinrichtungslinkBis Uhr, nur einmal verwendbar)</p>
        <div class="flex flex-wrap gap-2">
            <input type="text" readonly value="@Model.Einrichtungslink" class="eingabe min-w-0 flex-1 font-mono text-xs" x-ref="link" x-on:focus="$el.select()" />
            <button type="button" class="knopf-zweit" x-on:click="navigator.clipboard.writeText($refs.link.value); kopiert = true" x-text="kopiert ? 'Kopiert' : 'Kopieren'">Kopieren</button>
        </div>
        <p class="mt-2">Den Link nur an die Person selbst geben, z. B. per Messenger oder ausgedruckt. Er wird nur jetzt angezeigt.</p>
    </section>
}

<form method="post" class="karte grid max-w-3xl gap-4">
    <input type="hidden" asp-for="Formular.Id" />
    <div asp-validation-summary="ModelOnly" class="feldfehler"></div>

    <div>
        <label asp-for="Formular.MitgliedId" class="etikett"></label>
        <select asp-for="Formular.MitgliedId" asp-items="Model.Mitglieder" class="eingabe"><option value="">kein Mitglied (z. B. Gemeinde)</option></select>
        <span asp-validation-for="Formular.MitgliedId" class="feldfehler"></span>
    </div>
    <div>
        <label asp-for="Formular.Email" class="etikett"></label>
        <input asp-for="Formular.Email" class="eingabe" autocomplete="off" />
        <span asp-validation-for="Formular.Email" class="feldfehler"></span>
        @if (Model.IstNeu)
        {
            <p class="mt-1 text-xs text-gray-500">Leer lassen, um die E-Mail-Adresse des Mitglieds zu übernehmen.</p>
        }
    </div>

    <fieldset>
        <legend class="etikett">Rollen</legend>
        <div class="grid gap-2 sm:grid-cols-2">
            @foreach (var rolle in Model.RollenAuswahl)
            {
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" name="Formular.Rollen" value="@rolle.Value" checked="@Model.Formular.Rollen.Contains(rolle.Value)" class="h-4 w-4" />
                    @rolle.Text
                    @if (Rollen.ZweiFaktorNoetig(rolle.Value))
                    {
                        <span class="text-xs text-gray-500">(Zwei-Faktor Pflicht)</span>
                    }
                </label>
            }
        </div>
        <p class="mt-2 text-xs text-gray-500">Was eine Rolle darf, steht unter <a asp-page="/Verwaltung/Rechte/Index" class="text-feuer-700 hover:underline">Rollen und Rechte</a>. Rollenänderungen gelten spätestens nach wenigen Minuten, auch für schon angemeldete Personen.</p>
    </fieldset>

    @if (Model.IstNeu && Model.MailAktiv)
    {
        <label class="flex items-center gap-2 text-sm"><input asp-for="Formular.LinkSenden" class="h-4 w-4" /> Einrichtungslink per E-Mail schicken</label>
    }

    <div class="flex gap-2">
        <button type="submit" class="knopf">@(Model.IstNeu ? "Konto anlegen" : "Speichern")</button>
        <a asp-page="Index" class="knopf-zweit">Zurück</a>
    </div>
</form>

@if (konto is not null)
{
    <section class="karte mt-6 grid max-w-3xl gap-4">
        <h2 class="text-lg font-semibold">Zugang</h2>
        <dl class="grid gap-x-6 gap-y-2 text-sm sm:grid-cols-[12rem_1fr]">
            <dt class="font-medium text-gray-600">Passwort</dt><dd>@(konto.PasswordHash is null ? "noch nicht festgelegt" : "festgelegt")</dd>
            <dt class="font-medium text-gray-600">Zwei-Faktor</dt><dd>@(konto.TwoFactorEnabled ? "eingerichtet" : "nicht eingerichtet")</dd>
            <dt class="font-medium text-gray-600">Letzte Anmeldung</dt><dd>@Anzeige.DatumZeit(konto.LetzteAnmeldungAm)</dd>
            <dt class="font-medium text-gray-600">Status</dt><dd>@(konto.IstDeaktiviert ? $"deaktiviert seit {Anzeige.DatumZeit(konto.DeaktiviertAm)}" : "aktiv")</dd>
        </dl>
        <div class="flex flex-wrap gap-2">
            @if (!konto.IstDeaktiviert)
            {
                <form method="post" asp-page-handler="Link" asp-route-id="@konto.Id">
                    <button type="submit" class="knopf-zweit" title="Für die Ersteinrichtung oder ein vergessenes Passwort">Passwort-Link erzeugen</button>
                </form>
                @if (Model.MailAktiv)
                {
                    <form method="post" asp-page-handler="Link" asp-route-id="@konto.Id" asp-route-senden="true">
                        <button type="submit" class="knopf-zweit">Passwort-Link per E-Mail</button>
                    </form>
                }
                @if (konto.TwoFactorEnabled)
                {
                    <form method="post" asp-page-handler="ZweiFaktorZuruecksetzen" asp-route-id="@konto.Id" onsubmit="return confirm('Authenticator-App und Wiederherstellungscodes dieses Kontos verwerfen?')">
                        <button type="submit" class="knopf-zweit">Zwei-Faktor zurücksetzen</button>
                    </form>
                }
                @if (!Model.IstSelbst)
                {
                    <form method="post" asp-page-handler="Deaktivieren" asp-route-id="@konto.Id" onsubmit="return confirm('Konto deaktivieren? Die Person kann sich danach nicht mehr anmelden.')">
                        <button type="submit" class="knopf-zweit text-red-700">Deaktivieren</button>
                    </form>
                }
            }
            else
            {
                <form method="post" asp-page-handler="Aktivieren" asp-route-id="@konto.Id">
                    <button type="submit" class="knopf-zweit">Wieder aktivieren</button>
                </form>
            }
        </div>
    </section>
}
