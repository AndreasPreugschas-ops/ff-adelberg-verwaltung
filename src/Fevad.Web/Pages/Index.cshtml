@page
@model IndexModel
@{
    ViewData["Title"] = Model.Gewaehlt?.Titel ?? "Bereiche";
}
@* Auf der Bereichsauswahl und bei nur einem Bereich (dann gibt es keine Auswahl). *@
@if (User.Identity?.IsAuthenticated == true && (Model.Gewaehlt is null || Model.Bereiche.Count == 1))
{
    <section id="was-liegt-an" class="mb-8" hx-get="@Url.Page("/Index", "Anliegen")" hx-trigger="load" hx-swap="innerHTML">
        <h1 class="mb-3 text-2xl font-bold">Was liegt an</h1>
        <p class="text-sm text-gray-500">Wird geladen …</p>
        <noscript><p class="text-sm text-gray-500">Ohne JavaScript bitte die Bereiche unten öffnen.</p></noscript>
    </section>
}
@if (Model.Gewaehlt is { } bereich)
{
    @if (Model.Bereiche.Count > 1)
    {
        <a asp-page="/Index" class="text-sm text-feuer-700 hover:underline">← Bereiche</a>
    }
    <h1 class="mb-6 mt-2 text-2xl font-bold">@bereich.Titel</h1>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        @foreach (var e in bereich.Eintraege)
        {
            <a asp-page="@e.Seite" class="karte block hover:ring-2 hover:ring-feuer-600">
                <div class="text-lg font-semibold text-feuer-700">@e.Titel</div>
                @if (e.Beschreibung is not null)
                {
                    <div class="text-sm text-gray-600">@e.Beschreibung</div>
                }
            </a>
        }
    </div>
    return;
}
<h1 class="mb-6 text-2xl font-bold">Bereich wählen</h1>
<div class="grid gap-4 sm:grid-cols-2">
    @foreach (var b in Model.Bereiche)
    {
        <a asp-page="/Index" asp-route-bereich="@b.Titel" class="karte block py-8 hover:ring-2 hover:ring-feuer-600">
            <div class="text-2xl font-bold text-feuer-700">@b.Titel</div>
            <div class="mt-1 text-sm text-gray-600">@b.Beschreibung</div>
        </a>
    }
</div>
