@page "{id:guid?}"
@model Fevad.Web.Pages.Technik.Fahrzeuge.BearbeitenModel
@{
    ViewData["Title"] = Model.IstNeu ? "Neues Fahrzeug" : Model.Formular.Funkrufname;
    ViewData["TechnikBereich"] = "Fahrzeuge";
}
<h1 class="mb-4 text-2xl font-bold">@ViewData["Title"]</h1>
<partial name="_TechnikNavigation" />

<form method="post" class="karte grid max-w-3xl gap-4 sm:grid-cols-2">
    <input type="hidden" asp-for="Formular.Id" />
    <input type="hidden" asp-for="Formular.Version" />
    <div asp-validation-summary="ModelOnly" class="feldfehler sm:col-span-2"></div>

    <div><label asp-for="Formular.Funkrufname" class="etikett"></label><input asp-for="Formular.Funkrufname" class="eingabe" /><span asp-validation-for="Formular.Funkrufname" class="feldfehler"></span></div>
    <div><label asp-for="Formular.Typ" class="etikett"></label><input asp-for="Formular.Typ" class="eingabe" /><span asp-validation-for="Formular.Typ" class="feldfehler"></span></div>
    <div><label asp-for="Formular.Kennzeichen" class="etikett"></label><input asp-for="Formular.Kennzeichen" class="eingabe" /></div>
    <div><label asp-for="Formular.Issi" class="etikett"></label><input asp-for="Formular.Issi" class="eingabe" /></div>
    <div><label asp-for="Formular.Hersteller" class="etikett"></label><input asp-for="Formular.Hersteller" class="eingabe" /></div>
    <div><label asp-for="Formular.Aufbau" class="etikett"></label><input asp-for="Formular.Aufbau" class="eingabe" /></div>
    <div><label asp-for="Formular.Baujahr" class="etikett"></label><input asp-for="Formular.Baujahr" class="eingabe" /><span asp-validation-for="Formular.Baujahr" class="feldfehler"></span></div>
    <div><label asp-for="Formular.Sitzplaetze" class="etikett"></label><input asp-for="Formular.Sitzplaetze" class="eingabe" /></div>
    <div><label asp-for="Formular.Kostenklasse" class="etikett"></label><select asp-for="Formular.Kostenklasse" asp-items="Model.Kostenklassen" class="eingabe"><option value="">– eigener Satz oder keiner –</option></select></div>
    <div><label asp-for="Formular.IndienstAm" class="etikett"></label><input asp-for="Formular.IndienstAm" type="date" class="eingabe" /></div>
    <div><label asp-for="Formular.AusserDienstAm" class="etikett"></label><input asp-for="Formular.AusserDienstAm" type="date" class="eingabe" /></div>
    <div class="sm:col-span-2"><label asp-for="Formular.PruefvorlageId" class="etikett"></label><select asp-for="Formular.PruefvorlageId" asp-items="Model.Vorlagen" class="eingabe"><option value="">kein Prüfplan</option></select><span asp-validation-for="Formular.PruefvorlageId" class="feldfehler"></span></div>
    <div class="sm:col-span-2"><label asp-for="Formular.Bemerkung" class="etikett"></label><textarea asp-for="Formular.Bemerkung" rows="3" class="eingabe"></textarea></div>
    <div><label asp-for="Formular.Anschaffungswert" class="etikett"></label><input asp-for="Formular.Anschaffungswert" class="eingabe" inputmode="decimal" /><span asp-validation-for="Formular.Anschaffungswert" class="feldfehler"></span></div>
    <div></div>
    <partial name="_AnlageFelder" for="Formular.Anlage" />
    <fieldset class="grid gap-3 rounded-md border border-gray-200 p-3 sm:col-span-2 sm:grid-cols-2">
        <legend class="px-1 text-sm font-semibold">Außerdienststellung und Verwertung</legend>
        <p class="text-xs text-gray-500 sm:col-span-2">Nur ausfüllen, wenn oben „Außer Dienst seit“ gesetzt ist.</p>
        @if (Model.BeschlussNoetig)
        {
            <p class="rounded-md bg-amber-50 p-2 text-sm text-amber-900 sm:col-span-2">Anschaffungswert ab @Model.BeschlussGrenze €: Die Aussonderung braucht einen Beschluss.</p>
        }
        @if (Model.FoerdergeberMitteilen)
        {
            <p class="rounded-md bg-amber-50 p-2 text-sm text-amber-900 sm:col-span-2">Die Zweckbindung der Förderung läuft noch. Den Fördergeber vor der Verwertung informieren (VwV Z-Feu Nr. 6.5).</p>
        }
        <div class="sm:col-span-2"><label asp-for="Formular.Aussonderungsgrund" class="etikett"></label><input asp-for="Formular.Aussonderungsgrund" class="eingabe" /><span asp-validation-for="Formular.Aussonderungsgrund" class="feldfehler"></span></div>
        <div><label asp-for="Formular.Verwertung" class="etikett"></label><select asp-for="Formular.Verwertung" asp-items="Html.GetEnumSelectList<Fevad.Domain.Technik.Verwertung>()" class="eingabe"><option value="">–</option></select><span asp-validation-for="Formular.Verwertung" class="feldfehler"></span></div>
        <div><label asp-for="Formular.Erloes" class="etikett"></label><input asp-for="Formular.Erloes" class="eingabe" inputmode="decimal" /><span asp-validation-for="Formular.Erloes" class="feldfehler"></span></div>
        <div><label asp-for="Formular.Aussonderungsbeschluss" class="etikett"></label><input asp-for="Formular.Aussonderungsbeschluss" class="eingabe" /></div>
        <div><label asp-for="Formular.FoerdergeberMitgeteiltAm" class="etikett"></label><input asp-for="Formular.FoerdergeberMitgeteiltAm" type="date" class="eingabe" /></div>
    </fieldset>

    <div class="flex gap-2 sm:col-span-2">
        <button type="submit" class="knopf">Speichern</button>
        <a asp-page="@(Model.IstNeu ? "Index" : "Details")" asp-route-id="@Model.Formular.Id" class="knopf-zweit">Abbrechen</a>
    </div>
</form>
