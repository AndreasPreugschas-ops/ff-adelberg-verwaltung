@page
@model Fevad.Web.Pages.Technik.Geraete.EtikettenModel
@{
    ViewData["Title"] = "QR-Etiketten";
}
<div class="nicht-drucken mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">QR-Etiketten (@Model.Etiketten.Count)</h1>
    <div class="flex gap-2">
        <button type="button" class="knopf" onclick="window.print()">Drucken</button>
        <a asp-page="Index" class="knopf-zweit">Zurück</a>
    </div>
</div>
<p class="nicht-drucken mb-4 text-sm text-gray-600">
    Der Code führt auf die Geräteseite. Mitglieder ohne Technik-Rechte landen direkt bei „Mangel melden“.
    Für den Druck auf Etikettenbögen im Druckdialog „Ränder: keine“ und 100 % Skalierung wählen.
</p>
@if (Model.Etiketten.Count == 0)
{
    <p class="text-sm text-gray-500">Keine Geräte ausgewählt.</p>
}
<div class="grid grid-cols-2 gap-2 sm:grid-cols-3 print:grid-cols-3">
    @foreach (var e in Model.Etiketten)
    {
        <div class="flex break-inside-avoid items-center gap-2 rounded border border-gray-300 bg-white p-2">
            <div class="w-24 shrink-0 [&>svg]:h-auto [&>svg]:w-full">@Html.Raw(e.Svg)</div>
            <div class="min-w-0 text-xs leading-tight">
                <div class="text-sm font-bold">@e.Inventarnummer</div>
                <div>@e.Bezeichnung</div>
                @if (e.Standort is not null)
                {
                    <div class="text-gray-600">@e.Standort</div>
                }
                <div class="mt-1 text-gray-500">FF Adelberg</div>
            </div>
        </div>
    }
</div>
