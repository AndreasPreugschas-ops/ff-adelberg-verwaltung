@model IReadOnlyList<Fevad.Web.Pages.Technik.MangelZeile>
@{
    var mitGegenstand = ViewData["MitGegenstand"] is true;
}
@if (Model.Count == 0)
{
    <p class="p-4 text-sm text-gray-500">Keine Mängel.</p>
}
else
{
    <table class="tabelle">
        <thead><tr><th>Gemeldet</th>@if (mitGegenstand) { <th>Gegenstand</th> }<th>Beschreibung</th><th>Schwere</th><th>Status</th><th>Von</th></tr></thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td class="whitespace-nowrap"><a asp-page="/Technik/Maengel/Bearbeiten" asp-route-id="@m.Id" class="font-medium text-feuer-700 hover:underline">@Anzeige.DatumZeit(m.GemeldetAm)</a></td>
                    @if (mitGegenstand) { <td>@m.Gegenstand</td> }
                    <td>@m.Beschreibung</td>
                    <td>
                        @switch (m.Schwere)
                        {
                            case Fevad.Domain.Technik.MangelSchwere.AusserBetrieb: <span class="ampel-rot">außer Betrieb</span> break;
                            case Fevad.Domain.Technik.MangelSchwere.Einschraenkung: <span class="ampel-gelb">Einschränkung</span> break;
                            default: <span>Hinweis</span> break;
                        }
                    </td>
                    <td>@Anzeige.Text(m.Status)</td>
                    <td>@(m.GemeldetVon ?? "–")</td>
                </tr>
            }
        </tbody>
    </table>
}
