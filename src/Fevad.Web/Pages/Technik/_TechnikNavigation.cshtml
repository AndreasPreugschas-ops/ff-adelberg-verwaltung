@inject IAuthorizationService Autorisierung
@inject Fevad.Infrastructure.Persistenz.ParameterLeser Parameter
@inject TimeProvider Zeit
@{
    var aktiv = ViewData["TechnikBereich"] as string;
    var darfBeschaffung = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.BeschaffungLesen)).Succeeded;
    var darfBearbeiten = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.TechnikBearbeiten)).Succeeded;
    var darfPruefen = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.TechnikPruefen)).Succeeded;
    var mitFuellprotokoll = darfPruefen && await Parameter.ZahlAsync(Fevad.Domain.Gemeinsam.ParameterSchluessel.FuellprotokollAktiv, Anzeige.Heute(Zeit), 0) == 1;
    string Klasse(string bereich) => bereich == aktiv
        ? "rounded-md bg-feuer-600 px-3 py-1.5 text-sm font-semibold text-white"
        : "rounded-md px-3 py-1.5 text-sm font-semibold text-gray-700 hover:bg-gray-100";
}
<nav class="mb-4 flex flex-wrap gap-1 border-b border-gray-200 pb-2" aria-label="Technik">
    <a asp-page="/Technik/Index" class="@Klasse("Uebersicht")">Fristen</a>
    <a asp-page="/Technik/Fahrzeuge/Index" class="@Klasse("Fahrzeuge")">Fahrzeuge</a>
    <a asp-page="/Technik/Geraete/Index" class="@Klasse("Geraete")">Geräte</a>
    <a asp-page="/Technik/Materialien/Index" class="@Klasse("Material")">Materialstamm</a>
    <a asp-page="/Technik/Maengel/Index" class="@Klasse("Maengel")">Mängel</a>
    <a asp-page="/Technik/Ruecklauf" class="@Klasse("Ruecklauf")">Nach dem Einsatz</a>
    <a asp-page="/Technik/Werkstatt/Index" class="@Klasse("Werkstatt")">Werkstatt</a>
    <a asp-page="/Technik/Schlauchbuch" class="@Klasse("Schlauchbuch")">Schlauchbuch</a>
    <a asp-page="/Technik/Ausleihen" class="@Klasse("Ausleihen")">Ausleihen</a>
    <a asp-page="/Technik/Lager/Index" class="@Klasse("Lager")">Verbrauchsmaterial</a>
    @if (mitFuellprotokoll)
    {
        <a asp-page="/Technik/Fuellprotokoll" class="@Klasse("Fuellprotokoll")">Füllprotokoll</a>
    }
    <a asp-page="/Technik/Vorschau" class="@Klasse("Vorschau")">Vorschau</a>
    <a asp-page="/Technik/Jahresbericht" class="@Klasse("Jahresbericht")">Jahresbericht</a>
    @if (darfPruefen)
    {
        <a asp-page="/Technik/Pruefungen/Sammel" class="@Klasse("Sammel")">Sammelprüfung</a>
        <a asp-page="/Technik/Pflege" class="@Klasse("Pflege")">Sammelpflege</a>
    }
    @if (darfBearbeiten)
    {
        <a asp-page="/Technik/Inventur/Index" class="@Klasse("Inventur")">Inventur</a>
    }
    @if (darfBeschaffung)
    {
        <a asp-page="/Beschaffung/Index" class="@Klasse("Beschaffung")">Beschaffung</a>
        <a asp-page="/Beschaffung/Anlagen" class="@Klasse("Anlagen")">Anlagennachweis</a>
        <a asp-page="/Beschaffung/Foerderung/Index" class="@Klasse("Foerderung")">Z-Feu</a>
    }
    <a asp-page="/Technik/Geraetearten/Index" class="@Klasse("Geraetearten")">Gerätearten und Prüfpläne</a>
</nav>
