@inject IAuthorizationService Autorisierung
@inject Fevad.Infrastructure.Persistenz.ParameterLeser Parameter
@inject TimeProvider Zeit
@{
    var aktiv = ViewData["TechnikBereich"] as string;
    var darfBeschaffung = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.BeschaffungLesen)).Succeeded;
    var darfBearbeiten = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.TechnikBearbeiten)).Succeeded;
    var darfPruefen = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.TechnikPruefen)).Succeeded;
    var darfKleiderkammer = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.KleiderkammerLesen)).Succeeded;
    var mitFuellprotokoll = darfPruefen && await Parameter.ZahlAsync(Fevad.Domain.Gemeinsam.ParameterSchluessel.FuellprotokollAktiv, Anzeige.Heute(Zeit), 0) == 1;
    string? Aktuell(string bereich) => bereich == aktiv ? "page" : null;
}
<nav class="reiter" aria-label="Technik">
    <a asp-page="/Technik/Index" aria-current="@Aktuell("Uebersicht")">Fristen</a>
    <a asp-page="/Technik/Fahrzeuge/Index" aria-current="@Aktuell("Fahrzeuge")">Fahrzeuge</a>
    <a asp-page="/Technik/Geraete/Index" aria-current="@Aktuell("Geraete")">Geräte</a>
    <a asp-page="/Technik/Materialien/Index" aria-current="@Aktuell("Material")">Materialstamm</a>
    <a asp-page="/Technik/Maengel/Index" aria-current="@Aktuell("Maengel")">Mängel</a>
    <a asp-page="/Technik/Ruecklauf" aria-current="@Aktuell("Ruecklauf")">Nach dem Einsatz</a>
    <a asp-page="/Technik/Werkstatt/Index" aria-current="@Aktuell("Werkstatt")">Werkstatt</a>
    <a asp-page="/Technik/Schlauchbuch" aria-current="@Aktuell("Schlauchbuch")">Schlauchbuch</a>
    <a asp-page="/Technik/Ausleihen" aria-current="@Aktuell("Ausleihen")">Ausleihen</a>
    <a asp-page="/Technik/Lager/Index" aria-current="@Aktuell("Lager")">Verbrauchsmaterial</a>
    @if (darfKleiderkammer)
    {
        @* Persönliche Schutzausrüstung liegt in der Kleiderkammer; Gerätewart sieht dort alle Mitglieder, Ausgaben und Rückgaben. *@
        <a asp-page="/Kleiderkammer/Mitglieder" aria-current="@Aktuell("Ausruestung")">Ausrüstung der Mitglieder</a>
    }
    @if (mitFuellprotokoll)
    {
        <a asp-page="/Technik/Fuellprotokoll" aria-current="@Aktuell("Fuellprotokoll")">Füllprotokoll</a>
    }
    <a asp-page="/Technik/Vorschau" aria-current="@Aktuell("Vorschau")">Vorschau</a>
    <a asp-page="/Technik/Jahresbericht" aria-current="@Aktuell("Jahresbericht")">Jahresbericht</a>
    @if (darfPruefen)
    {
        <a asp-page="/Technik/Pruefungen/Sammel" aria-current="@Aktuell("Sammel")">Sammelprüfung</a>
        <a asp-page="/Technik/Pflege" aria-current="@Aktuell("Pflege")">Sammelpflege</a>
    }
    @if (darfBearbeiten)
    {
        <a asp-page="/Technik/Inventur/Index" aria-current="@Aktuell("Inventur")">Inventur</a>
    }
    @if (darfBeschaffung)
    {
        <a asp-page="/Beschaffung/Index" aria-current="@Aktuell("Beschaffung")">Beschaffung</a>
        <a asp-page="/Beschaffung/Anlagen" aria-current="@Aktuell("Anlagen")">Anlagennachweis</a>
        <a asp-page="/Beschaffung/Foerderung/Index" aria-current="@Aktuell("Foerderung")">Z-Feu</a>
    }
    <a asp-page="/Technik/Geraetearten/Index" aria-current="@Aktuell("Geraetearten")">Gerätearten und Prüfpläne</a>
</nav>
