@model IReadOnlyList<Fevad.Web.Pages.Technik.PruefbuchZeile>
@if (Model.Count == 0)
{
    <p class="text-sm text-gray-500">Noch keine Prüfung erfasst.</p>
}
else
{
    <table class="tabelle">
        <thead><tr><th>Datum</th><th>Prüfung</th><th>Ergebnis</th><th>Prüfer</th><th>Nächste</th></tr></thead>
        <tbody>
            @foreach (var p in Model)
            {
                <tr class="@(p.Storniert ? "text-gray-400 line-through" : "")">
                    <td><a asp-page="/Technik/Pruefungen/Details" asp-route-id="@p.Id" class="font-medium text-feuer-700 hover:underline">@Anzeige.Datum(p.Datum)</a></td>
                    <td>@Anzeige.Text(p.Pruefart)</td>
                    <td>@(p.Storniert ? "storniert" : Anzeige.Text(p.Ergebnis))</td>
                    <td>@(p.Pruefer ?? "–")</td>
                    <td>@Anzeige.Datum(p.NaechsteFaellig)</td>
                </tr>
            }
        </tbody>
    </table>
}
