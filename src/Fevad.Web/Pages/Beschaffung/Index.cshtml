@page
@model Fevad.Web.Pages.Beschaffung.IndexModel
@inject IAuthorizationService Autorisierung
@{
    ViewData["Title"] = "Beschaffung";
    ViewData["TechnikBereich"] = "Beschaffung";
    var darfBearbeiten = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.BeschaffungBearbeiten)).Succeeded;
    var darfTechnik = (await Autorisierung.AuthorizeAsync(User, Berechtigungen.TechnikLesen)).Succeeded;
    string Euro(decimal? betrag) => betrag is null ? "–" : betrag.Value.ToString("N2") + " €";
}
<div class="mb-4 flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-2xl font-bold">Beschaffung</h1>
    @if (darfBearbeiten)
    {
        <a asp-page="Bearbeiten" class="knopf">Neuer Bedarf</a>
    }
</div>
@if (darfTechnik)
{
    <partial name="/Pages/Technik/_TechnikNavigation.cshtml" />
}

<form method="get" class="mb-4 flex flex-wrap items-center gap-2 text-sm">
    <select name="Haushaltsjahr" class="eingabe w-auto" onchange="this.form.submit()">
        <option value="">alle Haushaltsjahre</option>
        @foreach (var j in Model.Jahre)
        {
            <option value="@j" selected="@(Model.Haushaltsjahr == j)">@j</option>
        }
    </select>
    <label class="flex items-center gap-1"><input type="checkbox" name="Alle" value="true" checked="@Model.Alle" class="h-4 w-4" onchange="this.form.submit()" /> auch geliefert und abgelehnt</label>
    <noscript><button type="submit" class="knopf-zweit">Anzeigen</button></noscript>
</form>

<div class="karte overflow-x-auto p-0">
    @if (Model.Zeilen.Count == 0)
    {
        <p class="p-4 text-sm text-gray-500">Keine Beschaffungen.</p>
    }
    else
    {
        <table class="tabelle">
            <thead><tr><th>Bezeichnung</th><th>Menge</th><th>Priorität</th><th>Status</th><th>Haushalt</th><th class="text-right">Schätzung</th><th class="text-right">Ist</th><th>Für</th></tr></thead>
            <tbody>
                @foreach (var z in Model.Zeilen)
                {
                    <tr>
                        <td><a asp-page="Bearbeiten" asp-route-id="@z.Id" class="font-medium text-feuer-700 hover:underline">@z.Bezeichnung</a></td>
                        <td>@z.Menge</td>
                        <td>@if (z.Prioritaet == Fevad.Domain.Technik.Prioritaet.Einsatzrelevant) { <span class="ampel-rot">einsatzrelevant</span> } else { @Anzeige.Text(z.Prioritaet) }</td>
                        <td>@Anzeige.Text(z.Status)@(z.GeliefertAm is null ? z.BestelltAm is null ? "" : $" am {Anzeige.Datum(z.BestelltAm)}" : $" am {Anzeige.Datum(z.GeliefertAm)}")</td>
                        <td>@(z.Haushaltsjahr?.ToString() ?? "–")</td>
                        <td class="text-right whitespace-nowrap">@Euro(z.Kostenschaetzung)</td>
                        <td class="text-right whitespace-nowrap">@Euro(z.Istkosten)</td>
                        <td>@(z.Fahrzeug ?? "–")</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="font-semibold">
                    <td colspan="5" class="px-3 py-2">Summe</td>
                    <td class="px-3 py-2 text-right whitespace-nowrap">@Euro(Model.Zeilen.Where(z => z.Status != Fevad.Domain.Technik.BeschaffungStatus.Abgelehnt).Sum(z => z.Kostenschaetzung ?? 0))</td>
                    <td class="px-3 py-2 text-right whitespace-nowrap">@Euro(Model.Zeilen.Sum(z => z.Istkosten ?? 0))</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    }
</div>
